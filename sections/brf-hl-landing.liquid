  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo", "info": "Optional. Wide lifestyle photo, at least 2000px wide. Without one, the hero shows a collage of products from your categories." },
    { "type": "text", "id": "hero_focal", "label": "Hero photo position (CSS)", "default": "object-position:center" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Home & Lifestyle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make every day at home a little better." },
    { "type": "textarea", "id": "text", "label": "Text", "info": "[count] is replaced with the number of products.", "default": "[count] hand-picked essentials for the home, garden and everyday living, from robot vacuums and fire pits to storage, bedding and gifts." },
    { "type": "header", "content": "Sections" },
    { "type": "checkbox", "id": "show_instock", "label": "Show \"Ready to send today\" (products tagged in-stock)", "default": true },
    { "type": "range", "id": "explore_limit", "label": "Products per category in \"Explore the range\"", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile photo",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Category" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Replaces the product collage on this category's tile." }
      ]
    }
  ]
}
