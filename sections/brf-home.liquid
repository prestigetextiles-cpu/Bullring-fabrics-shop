{%- comment -%} Default content used until blocks/settings are filled in the theme editor {%- endcomment -%}
{%- assign fabric_blocks = section.blocks | where: 'type', 'fabric' -%}
{%- assign default_handles = 'rose-hubble,satin,lace,taffeta,plush-velvet,craft-cotton,tapestry,denim' | split: ',' -%}
{%- assign default_labels = 'Cotton Poplin,Satin,Lace,Taffeta,Plush Velvet,Craft Cotton,Tapestry,Denim' | split: ',' -%}
{%- assign swatch_colours = '#C98B7E,#D9C3A0,#E6DCCB,#6B3A4B,#1F4A4F,#C9A23A,#8C5A3C,#3B5270' | split: ',' -%}

<div class="brf-home">

  {%- comment -%} HERO {%- endcomment -%}
  {%- assign hero_col = section.settings.hero_collection -%}{%- if hero_col.handle == blank -%}{%- assign hero_col = collections[section.settings.hero_collection] -%}{%- endif -%}
  {%- if hero_col == blank or hero_col.handle == blank -%}{%- assign hero_col = collections['rose-hubble'] -%}{%- endif -%}
  {%- assign hl_items = nil -%}
  {%- for l in linklists['main-menu-2026'].links -%}{%- assign lt = l.title | strip | handleize -%}{%- if lt == 'home-lifestyle' -%}{%- assign hl_items = l.links -%}{%- endif -%}{%- endfor -%}
  {%- assign hl_col = collections['home-lifestyle'] -%}
  {%- assign hs_today = 'now' | date: '%Y%m%d' | plus: 0 -%}
  {%- assign hs_end = section.settings.halloween_end | remove: '-' | strip | plus: 0 -%}
  {%- assign hs_hw_show = section.settings.hs_halloween -%}
  {%- if hs_end > 0 and hs_today > hs_end -%}{%- assign hs_hw_show = false -%}{%- endif -%}
  {%- assign hs_hw = section.settings.halloween_collection -%}{%- if hs_hw.handle == blank -%}{%- assign hs_hw = collections[section.settings.halloween_collection] -%}{%- endif -%}
  {%- if hs_hw.handle == blank -%}{%- assign hs_hw = collections['halloween'] -%}{%- endif -%}
  {%- assign hs_hd = collections['halloween-home-decor'] -%}
  <div class="brf-hs" data-brf-hs data-brf-nofx>
    <div class="brf-hs__track" data-brf-hs-track tabindex="-1">
    {%- if section.settings.hl_enable and hl_items.size > 0 -%}
    <div class="brf-hs__slide" role="group" aria-roledescription="slide" aria-label="Home &amp; Lifestyle">
    <section class="brf-wrap brf-hero">
      <div>
        <h2 class="brf-hs__h"><span class="brf-eyebrow"><span class="brf-hs__new">New</span>{{ section.settings.hl_eyebrow }}</span> <span class="brf-serif">{{ section.settings.hl_heading }}</span></h2>
        <p>{{ section.settings.hl_text }}</p>
        <ul class="brf-hs__chips" aria-label="Home &amp; Lifestyle categories">
          {%- for l in hl_items -%}{%- if l.object.products_count > 0 or l.object == blank -%}<li><a href="{{ l.url }}">{{ l.title | strip }}</a></li>{%- endif -%}{%- endfor -%}
        </ul>
        <div class="brf-hero__ctas">
          <a class="brf-btn brf-btn--solid" href="{{ hl_col.url | default: '/collections/home-lifestyle' }}">{{ section.settings.hl_btn_label }}</a>
          <a class="brf-btn brf-btn--line" href="/collections">Shop fabrics</a>
        </div>
      </div>
      <div class="brf-hero__media brf-hero__media--hl">
        {%- assign shown = 0 -%}
        {%- for l in hl_items -%}
          {%- if shown >= 5 -%}{%- break -%}{%- endif -%}
          {%- assign c = l.object -%}
          {%- if c == blank or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- assign ti = c.image -%}{%- assign photo = true -%}
          {%- unless ti -%}{%- assign ti = c.products.first.featured_image -%}{%- assign photo = false -%}{%- endunless -%}
          {%- unless ti -%}{%- continue -%}{%- endunless -%}
          <a class="brf-hl-tile{% if photo %} is-photo{% endif %}" href="{{ l.url }}"><img src="{{ ti | img_url: '700x' }}" alt="" {% if shown == 0 %}fetchpriority="high"{% else %}loading="lazy"{% endif %}><span>{{ l.title | strip }}</span></a>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </div>
    </section>
    </div>
    {%- endif -%}
    <div class="brf-hs__slide" role="group" aria-roledescription="slide" aria-label="Fabric by the metre">
    <section class="brf-wrap brf-hero">
      <div>
        <h1 class="brf-hero__h1"><span class="brf-eyebrow">{{ section.settings.hero_eyebrow }}</span> <span class="brf-serif brf-hero__title">{{ section.settings.hero_heading }}</span></h1>
        <p>{{ section.settings.hero_text }}</p>
        <div class="brf-hero__ctas">
          <a class="brf-btn brf-btn--solid" href="{{ section.settings.hero_btn1_link | default: '/collections' }}">{{ section.settings.hero_btn1_label }}</a>
          <a class="brf-btn brf-btn--line" href="{{ section.settings.hero_btn2_link | default: '/pages/wholesale-trade-enquiries' }}">{{ section.settings.hero_btn2_label }}</a>
        </div>
      </div>
      <div class="brf-hero__media">
        {%- assign m1 = section.settings.hero_image_1 | default: hero_col.image -%}
        {%- assign m2 = section.settings.hero_image_2 | default: collections['plush-velvet'].image -%}
        {%- assign m3 = section.settings.hero_image_3 | default: collections['satin'].image -%}
        <div class="brf-swatch">{% if m1 %}<img src="{{ m1 | img_url: '900x' }}" alt="{{ m1.alt | default: hero_col.title | escape }}" width="900" height="1100" fetchpriority="high">{% endif %}</div>
        <div class="brf-swatch" style="background-color:#1F4A4F">{% if m2 %}<img src="{{ m2 | img_url: '600x' }}" alt="{{ m2.alt | escape }}" loading="lazy">{% endif %}</div>
        <div class="brf-swatch" style="background-color:#D9C3A0">{% if m3 %}<img src="{{ m3 | img_url: '600x' }}" alt="{{ m3.alt | escape }}" loading="lazy">{% endif %}</div>
        {%- if hero_col.handle != blank -%}
        <div class="brf-hero__card">
          <span class="brf-eyebrow">{{ section.settings.hero_card_label }}</span>
          <strong>{{ section.settings.hero_card_title | default: hero_col.title }}</strong>
          <a href="{{ hero_col.url }}">Shop {{ hero_col.products_count }} designs &rarr;</a>
        </div>
        {%- endif -%}
      </div>
    </section>
    </div>
    {%- if hs_hw_show and hs_hw.handle != blank and hs_hw.products_count > 0 -%}
    {%- assign hs_total = hs_hw.products_count | plus: hs_hd.products_count -%}
    <div class="brf-hs__slide brf-hs__slide--spooky" role="group" aria-roledescription="slide" aria-label="Halloween">
    {%- render 'brf-spooky-layer' -%}
    <div class="brf-scary__flash" aria-hidden="true"></div>
    <svg class="brf-scary__moon" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" fill="#F3E3B8"/><circle cx="44" cy="46" r="8" fill="#E2CE98"/><circle cx="74" cy="72" r="11" fill="#E2CE98"/><circle cx="78" cy="38" r="5" fill="#E2CE98"/></svg>
    <div class="brf-scary__eyes" aria-hidden="true"><i style="left:6%;top:62%"></i><i style="left:88%;top:70%;animation-delay:-2.3s"></i><i style="left:78%;top:20%;animation-delay:-4.1s;transform:scale(.7)"></i><i class="brf-scary__desk" style="left:16%;top:28%;animation-delay:-1.2s;transform:scale(.6)"></i><i class="brf-scary__desk" style="left:94%;top:44%;animation-delay:-3.4s;transform:scale(.8)"></i></div>
    <svg class="brf-scary__trees" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true"><path fill="#0A080D" d="M0 120V92c40-6 70-30 96-28 22 2 30-24 54-22s40 30 70 26 40-38 74-36 34 26 62 30 52-12 80-10 44 26 80 24 40-20 66-18 34 18 62 16c30-2 46-34 80-32s36 30 66 30 38-22 70-20 48 28 82 26 42-26 76-24 36 24 64 22 46-16 76-14 40 22 70 18 34-24 66-22 38 24 70 22 36-12 54-10V120z"/><path fill="#0A080D" d="M1180 120V40l6-8-10-10 8-2-4-14 10 12 6-10 2 14 12-6-8 12 10 4-14 4v78zM250 120V56l-12-14 10 2-6-16 10 10 4-12 4 14 10-8-6 14 12-2-16 12v64z"/></svg>
    <div class="brf-scary">
      <span class="brf-scary__eyebrow">&#x1F383; {{ section.settings.hs_hw_eyebrow }}</span>
      <h2 class="brf-scary__title">Dare to enter&hellip;</h2>
      <div class="brf-scary__count" data-brf-countdown data-to="{{ 'now' | date: '%Y' }}-10-31T00:00:00" role="timer" aria-label="Countdown to Halloween">
        <p class="brf-scary__count-lbl">Countdown to Halloween</p>
        <div class="brf-scary__stones">
          <div class="brf-scary__stone"><b data-d>--</b><span>Days</span></div>
          <div class="brf-scary__stone"><b data-h>--</b><span>Hours</span></div>
          <div class="brf-scary__stone"><b data-m>--</b><span>Mins</span></div>
          <div class="brf-scary__stone"><b data-s>--</b><span>Secs</span></div>
        </div>
        <p class="brf-scary__here" hidden>The witching hour is here. Happy Halloween!</p>
      </div>
      {%- assign hs_quotes = section.settings.hs_hw_quotes | newline_to_br | split: '<br />' -%}
      <div class="brf-scary__quotes" data-brf-quotes aria-live="off">
