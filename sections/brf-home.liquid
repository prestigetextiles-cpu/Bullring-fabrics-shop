        {%- case n -%}
          {%- when 1 -%}{%- assign p_title = section.settings.project_1_title -%}{%- assign p_text = section.settings.project_1_text -%}{%- assign p_col = section.settings.project_1_collection -%}{%- if p_col.handle == blank -%}{%- assign p_col = collections[section.settings.project_1_collection] -%}{%- endif -%}{%- assign p_fallback = 'satin' -%}{%- assign p_img = section.settings.project_1_image -%}{%- assign p_bg = '#7A4556' -%}
          {%- when 2 -%}{%- assign p_title = section.settings.project_2_title -%}{%- assign p_text = section.settings.project_2_text -%}{%- assign p_col = section.settings.project_2_collection -%}{%- if p_col.handle == blank -%}{%- assign p_col = collections[section.settings.project_2_collection] -%}{%- endif -%}{%- assign p_fallback = 'craft-cotton' -%}{%- assign p_img = section.settings.project_2_image -%}{%- assign p_bg = '#A7822F' -%}
          {%- when 3 -%}{%- assign p_title = section.settings.project_3_title -%}{%- assign p_text = section.settings.project_3_text -%}{%- assign p_col = section.settings.project_3_collection -%}{%- if p_col.handle == blank -%}{%- assign p_col = collections[section.settings.project_3_collection] -%}{%- endif -%}{%- assign p_fallback = 'plush-velvet' -%}{%- assign p_img = section.settings.project_3_image -%}{%- assign p_bg = '#2E4A43' -%}
        {%- endcase -%}
        {%- if p_col.handle == blank -%}{%- assign p_col = collections[p_fallback] -%}{%- endif -%}
        {%- assign p_img = p_img | default: p_col.image -%}
        <a class="brf-project" href="{{ p_col.url | default: '/collections' }}">
          <div class="brf-swatch" style="background-color:{{ p_bg }}">{% if p_img %}<img src="{{ p_img | img_url: '800x' }}" alt="" loading="lazy">{% endif %}</div>
          <div class="brf-project__body"><strong>{{ p_title }}</strong><span>{{ p_text }}</span><em>Shop now &rarr;</em></div>
        </a>
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} FEATURED / SEASONAL PRODUCTS {%- endcomment -%}
  {%- assign feat = section.settings.featured_collection -%}{%- if feat.handle == blank -%}{%- assign feat = collections[section.settings.featured_collection] -%}{%- endif -%}
  {%- if feat.handle == blank -%}{%- assign feat = collections['christmas'] -%}{%- endif -%}
  {%- if feat.handle != blank and feat.products_count > 0 -%}
  <section class="brf-products brf-section">
    <div class="brf-wrap">
      <div class="brf-head">
        <div><span class="brf-eyebrow" style="color:var(--brf-sale)">{{ section.settings.featured_eyebrow }}</span><h2 class="brf-h2 brf-serif">{{ section.settings.featured_heading }}</h2></div>
        <a href="{{ feat.url }}">Shop the collection &rarr;</a>
      </div>
      <div class="brf-grid4">
        {%- assign feat_limit = section.settings.featured_count | plus: 0 -%}{%- if feat_limit < 1 -%}{%- assign feat_limit = 4 -%}{%- endif -%}
        {%- assign feat_excl = section.settings.featured_exclude | downcase | split: ',' -%}
        {%- assign feat_shown = 0 -%}
        {%- for product in feat.products limit: 50 -%}
          {%- if feat_shown >= feat_limit -%}{%- break -%}{%- endif -%}
          {%- assign t = product.title | downcase -%}
          {%- assign skip = false -%}
          {%- for w in feat_excl -%}{%- assign ws = w | strip -%}{%- if ws != blank and t contains ws -%}{%- assign skip = true -%}{%- endif -%}{%- endfor -%}
          {%- if skip -%}{%- continue -%}{%- endif -%}
          {%- assign feat_shown = feat_shown | plus: 1 -%}
          <div class="brf-card">
            <a class="brf-card__media" href="{{ product.url | within: feat }}">
              <div class="brf-swatch" style="background-color:#3E6B4F">{% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{% endif %}</div>
              {%- if product.compare_at_price > product.price -%}
                {%- assign save = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                <span class="brf-badge">Save {{ save }}%</span>
              {%- endif -%}
            </a>
            <a class="brf-card__title" href="{{ product.url | within: feat }}">{{ product.title }}</a>
            <div class="brf-card__price">
              {%- if product.price_varies -%}<strong>From {{ product.price_min | money }}</strong>
              {%- elsif product.compare_at_price > product.price -%}<strong class="is-sale">{{ product.price | money }}</strong><s>{{ product.compare_at_price | money }}</s>
              {%- else -%}<strong>{{ product.price | money }}</strong>{%- endif -%}
            </div>
            {%- if product.available and product.has_only_default_variant -%}
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="brf-btn brf-btn--line">Add to bag</button>
              {%- endform -%}
            {%- elsif product.available -%}
              <a class="brf-btn brf-btn--line" href="{{ product.url | within: feat }}">Choose options</a>
            {%- else -%}
              <span class="brf-btn brf-btn--line" style="opacity:.5;cursor:default">Sold out</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} POUND FABRICS + TRADE {%- endcomment -%}
  {%- assign pound = collections['pound-fabrics'] -%}
  <section class="brf-wrap brf-section">
    <div class="brf-panels">
      <div class="brf-panel brf-panel--sand">
        <span class="brf-eyebrow">Bargain rail</span>
        <h2 class="brf-serif">Pound Fabrics</h2>
        <p>{% if pound.products_count > 0 %}{{ pound.products_count }} fabrics{% else %}Fabrics{% endif %} at our lowest prices — perfect for toiles, practice pieces and big craft projects.</p>
        <div class="brf-panel__ctas">
          <a class="brf-btn brf-btn--ink" href="{{ pound.url | default: '/collections/pound-fabrics' }}">Shop Pound Fabrics</a>
          <a href="/collections/black-friday">Clearance &amp; end of rolls &rarr;</a>
        </div>
      </div>
      <div class="brf-panel brf-panel--dark">
        <span class="brf-eyebrow">For businesses</span>
        <h2 class="brf-serif">Wholesale &amp; trade</h2>
        <p>Full rolls and job lots for designers, manufacturers, schools and theatres. Open a trade account for bulk pricing.</p>
        <div class="brf-panel__ctas">
          <a class="brf-btn brf-btn--light" href="/pages/wholesale-trade-enquiries">Make a trade enquiry</a>
          <a href="/collections/trade-outlet">Browse job lots &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} VISIT THE OUTLET {%- endcomment -%}
  {%- if section.settings.show_outlet -%}
  <section class="brf-wrap" style="padding-bottom:96px">
    <div class="brf-outlet">
      <div class="brf-swatch">{% if section.settings.outlet_image %}<img src="{{ section.settings.outlet_image | img_url: '900x' }}" alt="{{ section.settings.outlet_image.alt | default: 'Our Birmingham fabric outlet' | escape }}" loading="lazy">{% endif %}</div>
      <div class="brf-outlet__body">
        <span class="brf-eyebrow" style="margin:0">Visit us</span>
        <h2 class="brf-serif">{{ section.settings.outlet_heading }}</h2>
        <p>{{ section.settings.outlet_text }}</p>
        {%- if section.settings.outlet_address != blank or section.settings.outlet_hours != blank -%}
        <div class="brf-outlet__facts">
          {%- if section.settings.outlet_address != blank -%}<div><strong>Address</strong><br><span>{{ section.settings.outlet_address | newline_to_br }}</span></div>{%- endif -%}
          {%- if section.settings.outlet_hours != blank -%}<div><strong>Opening hours</strong><br><span>{{ section.settings.outlet_hours | newline_to_br }}</span></div>{%- endif -%}
        </div>
        {%- endif -%}
        <a href="{{ section.settings.outlet_link | default: '/pages/about-us' }}">{{ section.settings.outlet_link_label }} &rarr;</a>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} BLOG {%- endcomment -%}
  {%- assign blog = section.settings.blog -%}{%- if blog.handle == blank -%}{%- assign blog = blogs[section.settings.blog] -%}{%- endif -%}
  {%- if blog.handle == blank -%}{%- assign blog = blogs.news -%}{%- endif -%}
  {%- if blog.articles_count > 0 -%}
  <section class="brf-wrap" style="padding-bottom:96px">
    <div class="brf-head">
      <div><span class="brf-eyebrow">Guides &amp; inspiration</span><h2 class="brf-h2 brf-serif">From the cutting table</h2></div>
      <a href="{{ blog.url }}">All articles &rarr;</a>
    </div>
    <div class="brf-grid3">
      {%- for article in blog.articles limit: 3 -%}
        <a class="brf-post" href="{{ article.url }}">
          <div class="brf-swatch" style="background-color:{{ swatch_colours[forloop.index0] }}">{% if article.image %}<img src="{{ article.image | img_url: '700x' }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy">{% endif %}</div>
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%-d %B %Y' }}</time>
          <span class="brf-post__title">{{ article.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Homepage (redesign)",
  "class": "brf-home-section",
  "max_blocks": 12,
  "settings": [
    { "type": "color", "id": "accent", "label": "Accent colour", "default": "#1F4D3A" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Small label", "default": "Fabric by the metre · Trade prices for everyone" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Beautiful fabric, cut to order in Birmingham." },
    { "type": "textarea", "id": "hero_text", "label": "Text", "default": "Cotton poplins, satins, taffetas, velvets and upholstery weaves for dressmakers, crafters and the trade — at wholesale prices. Order before 10pm for same-day dispatch, delivered UK-wide and worldwide." },
    { "type": "text", "id": "hero_btn1_label", "label": "Button 1 label", "default": "Shop all fabrics" },
    { "type": "url", "id": "hero_btn1_link", "label": "Button 1 link" },
    { "type": "text", "id": "hero_btn2_label", "label": "Button 2 label", "default": "Trade & wholesale" },
    { "type": "url", "id": "hero_btn2_link", "label": "Button 2 link" },
    { "type": "image_picker", "id": "hero_image_1", "label": "Large image", "info": "Leave empty to use the featured collection's image" },
    { "type": "image_picker", "id": "hero_image_2", "label": "Top-right image" },
    { "type": "image_picker", "id": "hero_image_3", "label": "Bottom-right image" },
    { "type": "collection", "id": "hero_collection", "label": "Featured collection (card over image)" },
    { "type": "text", "id": "hero_card_label", "label": "Card label", "default": "New in" },
    { "type": "text", "id": "hero_card_title", "label": "Card title", "default": "Rose & Hubble Cotton Poplins" },
    { "type": "header", "content": "Home & Lifestyle banner slide" },
    { "type": "checkbox", "id": "hl_enable", "label": "Show Home & Lifestyle slide", "default": true },
    { "type": "text", "id": "hl_eyebrow", "label": "Small label", "default": "Home & Lifestyle" },
    { "type": "text", "id": "hl_heading", "label": "Heading", "default": "Big-brand bits for every room." },
    { "type": "textarea", "id": "hl_text", "label": "Text", "default": "Our new department: homeware, garden, furniture, tech, toys and more, at the same friendly prices as our fabrics. New curtains deserve a comfy new sofa, right?" },
    { "type": "text", "id": "hl_btn_label", "label": "Button label", "default": "Shop Home & Lifestyle" },
    { "type": "range", "id": "hl_autoplay", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "default": 7 },
    { "type": "checkbox", "id": "hs_halloween", "label": "Show Halloween slide", "info": "Hides itself after the Halloween end date below", "default": true },
    { "type": "text", "id": "hs_hw_eyebrow", "label": "Halloween slide label", "default": "Spooky season" },
    { "type": "textarea", "id": "hs_hw_quotes", "label": "Halloween slide quotes", "info": "One per line. Add the author after a | sign", "default": "Double, double toil and trouble; fire burn and cauldron bubble.|William Shakespeare, Macbeth\nDeep into that darkness peering, long I stood there, wondering, fearing.|Edgar Allan Poe, The Raven\nWhen witches go riding and black cats are seen, the moon laughs and whispers, 'tis near Halloween.|Traditional rhyme\nThe needle is sharp, the thread is black, once you sew a cape there's no turning back.|The Bull Ring cutting table" },
    { "type": "header", "content": "Christmas banner slide" },
    { "type": "checkbox", "id": "hs_xmas", "label": "Show Christmas slide", "default": true },
    { "type": "text", "id": "xmas_end", "label": "Hide Christmas slide after", "info": "Date as YYYY-MM-DD. Leave empty to keep showing.", "default": "2026-12-25" },
    { "type": "collection", "id": "xmas_collection", "label": "Christmas collection", "info": "Defaults to Christmas" },
    { "type": "text", "id": "xmas_eyebrow", "label": "Small label", "default": "Christmas at Bull Ring" },
    { "type": "text", "id": "xmas_heading", "label": "Heading", "default": "Deck the halls (and the hems)." },
    { "type": "textarea", "id": "xmas_text", "label": "Text", "default": "Festive prints, sparkly glitter, cosy felts and tartans for stockings, tree skirts, table runners and matching Christmas jumpers. Elves cut to order, same-day dispatch." },
    { "type": "header", "content": "Reassurance strip" },
    { "type": "text", "id": "trust_1_title", "label": "Item 1 title", "default": "Free UK delivery over £65" },
    { "type": "text", "id": "trust_1_text", "label": "Item 1 text", "default": "2-day tracked, UK mainland" },
    { "type": "text", "id": "trust_2_title", "label": "Item 2 title", "default": "Same-day dispatch" },
    { "type": "text", "id": "trust_2_text", "label": "Item 2 text", "default": "Order before 10pm, Mon–Fri" },
    { "type": "text", "id": "trust_3_title", "label": "Item 3 title", "default": "Wholesale & trade" },
    { "type": "text", "id": "trust_3_text", "label": "Item 3 text", "default": "Rolls and job lots for business" },
    { "type": "header", "content": "Clearpay banner" },
    { "type": "checkbox", "id": "cp_show", "label": "Show Clearpay banner", "default": true },
    { "type": "text", "id": "cp_heading", "label": "Heading (Clearpay logo follows)", "default": "Now accepting" },
    { "type": "textarea", "id": "cp_text", "label": "Text", "default": "Craft now, pay later! Split your fabric haul into 4 interest-free payments, one every 2 weeks. Just pick Clearpay at checkout." },
    { "type": "text", "id": "trust_4_title", "label": "Item 4 title", "default": "Secure checkout" },
    { "type": "text", "id": "trust_4_text", "label": "Item 4 text", "default": "PayPal, Apple Pay, cards" },
    { "type": "header", "content": "Halloween" },
    { "type": "checkbox", "id": "show_halloween", "label": "Show Halloween section", "default": true },
    { "type": "text", "id": "halloween_end", "label": "Hide automatically after", "info": "Date as YYYY-MM-DD. Leave empty to keep showing.", "default": "2026-10-31" },
    { "type": "collection", "id": "halloween_collection", "label": "Collection", "info": "Defaults to Halloween" },
    { "type": "text", "id": "halloween_keywords", "label": "Show these first", "info": "Products whose title contains any of these words are picked first", "default": "halloween, skull, spider, pumpkin, ghost, witch, skeleton, cobweb, goth" },
    { "type": "text", "id": "halloween_eyebrow", "label": "Small label", "default": "Spooky season" },
    { "type": "text", "id": "halloween_heading", "label": "Heading", "default": "Fabrics to die for" },
    { "type": "textarea", "id": "halloween_text", "label": "Text", "default": "Sugar skulls, gothic velvets, glittering tulle and spooky prints for costumes, décor and trick-or-treat bags." },
    { "type": "header", "content": "Shop by fabric", "info": "Add 'Fabric tile' blocks to choose your own collections. With no blocks, eight best-sellers are shown." },
    { "type": "text", "id": "fabrics_heading", "label": "Heading", "default": "Our most-loved fabrics" },
    { "type": "header", "content": "Shop by project" },
    { "type": "text", "id": "project_1_title", "label": "Card 1 title", "default": "Dressmaking" },
    { "type": "text", "id": "project_1_text", "label": "Card 1 text", "default": "Poplins, satins, crepe, chiffon, lace and lycra." },
    { "type": "collection", "id": "project_1_collection", "label": "Card 1 collection" },
    { "type": "image_picker", "id": "project_1_image", "label": "Card 1 image" },
    { "type": "text", "id": "project_2_title", "label": "Card 2 title", "default": "Crafts & quilting" },
    { "type": "text", "id": "project_2_text", "label": "Card 2 text", "default": "Craft cotton, felt, fleece, faux fur and polycotton." },
    { "type": "collection", "id": "project_2_collection", "label": "Card 2 collection" },
    { "type": "image_picker", "id": "project_2_image", "label": "Card 2 image" },
    { "type": "text", "id": "project_3_title", "label": "Card 3 title", "default": "Upholstery & curtains" },
    { "type": "text", "id": "project_3_text", "label": "Card 3 text", "default": "Plush velvet, tapestry, faux leather and suede." },
    { "type": "collection", "id": "project_3_collection", "label": "Card 3 collection" },
    { "type": "image_picker", "id": "project_3_image", "label": "Card 3 image" },
    { "type": "header", "content": "Featured products" },
    { "type": "collection", "id": "featured_collection", "label": "Collection", "info": "Defaults to Christmas" },
    { "type": "text", "id": "featured_exclude", "label": "Hide products whose title contains", "info": "Comma-separated, e.g. gift, job lot", "default": "gift, job lot, wholesale, 20m, 10m" },
    { "type": "text", "id": "featured_eyebrow", "label": "Small label", "default": "Seasonal" },
    { "type": "text", "id": "featured_heading", "label": "Heading", "default": "Christmas fabrics have landed" },
    { "type": "select", "id": "featured_count", "label": "Products shown", "options": [ { "value": "4", "label": "4" }, { "value": "8", "label": "8" } ], "default": "4" },
    { "type": "header", "content": "Visit the outlet" },
    { "type": "checkbox", "id": "show_outlet", "label": "Show outlet section", "default": true },
    { "type": "image_picker", "id": "outlet_image", "label": "Shop photo" },
    { "type": "text", "id": "outlet_heading", "label": "Heading", "default": "Our Birmingham outlet" },
    { "type": "textarea", "id": "outlet_text", "label": "Text", "default": "Prefer to see and feel the fabric before you buy? Get in touch to arrange a visit to our Birmingham outlet." },
    { "type": "textarea", "id": "outlet_address", "label": "Address", "info": "Hidden when empty" },
    { "type": "textarea", "id": "outlet_hours", "label": "Opening hours", "info": "Hidden when empty" },
    { "type": "url", "id": "outlet_link", "label": "Link" },
    { "type": "text", "id": "outlet_link_label", "label": "Link label", "default": "Contact & directions" },
    { "type": "header", "content": "Blog" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Defaults to News" }
  ],
  "blocks": [
    {
      "type": "fabric",
      "name": "Fabric tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Short name", "info": "E.g. 'Satin' — leave empty to use the collection title" },
