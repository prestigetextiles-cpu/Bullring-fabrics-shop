          {%- assign c = block.settings.collection -%}{%- if c.handle == blank -%}{%- assign c = collections[block.settings.collection] -%}{%- endif -%}
          {%- if c.handle == blank -%}{%- continue -%}{%- endif -%}
          {%- assign ci = forloop.index0 | modulo: 8 -%}
          <a class="brf-tile" href="{{ c.url }}" {{ block.shopify_attributes }}>
            <div class="brf-swatch" style="background-color:{{ swatch_colours[ci] }}">{% assign img = block.settings.image | default: c.image %}{% if img %}<img src="{{ img | img_url: '600x' }}" alt="{{ block.settings.label | default: c.title | escape }}" loading="lazy">{% endif %}</div>
