  .brf-hs__slide--xmas .brf-hs__chips a{background:rgba(255,255,255,.07);border-color:rgba(227,179,65,.35);color:#F6EEDC}
  .brf-hs__slide--xmas .brf-hs__chips a:hover{border-color:#E3B341}
  .brf-xmas__media .brf-hl-tile{background:#0A2A20;box-shadow:0 0 0 3px rgba(227,179,65,.55),0 16px 30px rgba(0,0,0,.35)}
  .brf-xmas__media .brf-hl-tile span{background:#FFF8EA;color:#0F3B2E}
  .brf-xmas__bow{position:absolute;top:-22px;left:calc(20% - 32px);width:64px;height:48px;z-index:3;filter:drop-shadow(0 4px 6px rgba(0,0,0,.35))}
  .brf-xmas__lights{position:absolute;top:0;left:0;right:0;height:46px;z-index:3;display:flex;justify-content:space-around;pointer-events:none;background:radial-gradient(120% 60px at 50% -30px,transparent 98%,#0A1F17 99%,transparent 100%)}
  .brf-xmas__lights::before{content:"";position:absolute;left:-2%;right:-2%;top:-26px;height:52px;border-bottom:2px solid #0A1F17;border-radius:0 0 50% 50% / 0 0 30px 30px}
  .brf-xmas__lights i{position:relative;top:14px;width:10px;height:16px;border-radius:50% 50% 50% 50% / 60% 60% 40% 40%;background:#E3B341;box-shadow:0 0 12px 3px rgba(227,179,65,.7);animation:brfTwinkle 1.8s infinite alternate}
  .brf-xmas__lights i::before{content:"";position:absolute;top:-4px;left:2px;width:6px;height:5px;border-radius:2px;background:#2A3B33}
  .brf-xmas__lights i:nth-child(3n+1){background:#E8384F;box-shadow:0 0 12px 3px rgba(232,56,79,.7);animation-delay:-.6s}
  .brf-xmas__lights i:nth-child(3n+2){background:#4FD18B;box-shadow:0 0 12px 3px rgba(79,209,139,.7);animation-delay:-1.2s}
  .brf-xmas__lights i:nth-child(odd){top:20px}
  @keyframes brfTwinkle{from{opacity:1}to{opacity:.45}}
  .brf-xmas__snow{position:absolute;inset:0;z-index:1;pointer-events:none}
  .brf-xmas__snow i{position:absolute;top:-10px;width:6px;height:6px;border-radius:50%;background:#fff;opacity:.8;animation:brfSnow 11s linear infinite}
  {%- for i in (1..26) -%}{%- assign l = i | times: 37 | modulo: 100 -%}{%- assign d = i | times: 7 | modulo: 11 -%}{%- assign z = i | modulo: 3 | plus: 3 -%}
  .brf-xmas__snow i:nth-child({{ i }}){left:{{ l }}%;animation-delay:-{{ d }}s;width:{{ z }}px;height:{{ z }}px;animation-duration:{{ z | times: 3 | plus: 2 }}s}
  {%- endfor %}
  @keyframes brfSnow{from{transform:translate3d(0,-10px,0)}50%{transform:translate3d(14px,300px,0)}to{transform:translate3d(-6px,640px,0)}}
  @media (max-width:640px){.brf-hs__slide--xmas>.brf-hero{padding-top:56px}.brf-xmas__lights i:nth-child(n+11){display:none}.brf-xmas__snow i:nth-child(n+14){display:none}.brf-xmas__bow{left:calc(27% - 26px);width:52px;height:40px;top:-18px}}
  @media (prefers-reduced-motion:reduce){.brf-xmas__snow,.brf-xmas__lights i{animation:none}.brf-xmas__snow{display:none}}
  @media (max-width:1023px){
