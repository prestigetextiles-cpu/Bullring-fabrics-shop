        <p>{{ section.settings.hero_text }}</p>
        <div class="brf-hero__ctas">
          <a class="brf-btn brf-btn--solid" href="{{ section.settings.hero_btn1_link | default: '/collections' }}">{{ section.settings.hero_btn1_label }}</a>
