      <button type="button" class="brf-hs__arrow" data-brf-hs-next aria-label="Next slide"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </div>
  <script>
  (function(){
    var root=document.querySelector('[data-brf-hs]');if(!root)return;
    var track=root.querySelector('[data-brf-hs-track]'),slides=track.children,n=slides.length;if(n<2)return;
    var nav=root.querySelector('[data-brf-hs-nav]'),dotsEl=root.querySelector('[data-brf-hs-dots]'),dots=[],cur=0,timer=null,paused=false;
    var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
    for(var i=0;i<n;i++){(function(i){var b=document.createElement('button');b.type='button';b.className='brf-hs__dot';b.setAttribute('aria-label','Slide '+(i+1)+' of '+n);b.onclick=function(){go(i);restart();};dotsEl.appendChild(b);dots.push(b);})(i);}
    nav.hidden=false;
    function mark(i){cur=i;for(var k=0;k<n;k++){dots[k].setAttribute('aria-current',k===i?'true':'false');slides[k].setAttribute('aria-hidden',k===i?'false':'true');slides[k].inert=k!==i;}}
    function go(i){i=(i+n)%n;track.scrollTo({left:slides[i].offsetLeft-track.offsetLeft,behavior:reduce?'auto':'smooth'});mark(i);}
    var t;track.addEventListener('scroll',function(){clearTimeout(t);t=setTimeout(function(){var i=Math.round(track.scrollLeft/track.clientWidth);if(i!==cur)mark(Math.max(0,Math.min(n-1,i)));},80);},{passive:true});
    root.querySelector('[data-brf-hs-prev]').onclick=function(){go(cur-1);restart();};
    root.querySelector('[data-brf-hs-next]').onclick=function(){go(cur+1);restart();};
    function start(){if(reduce||timer)return;timer=setInterval(function(){if(!paused&&!document.hidden)go(cur+1);},{{ section.settings.hl_autoplay | default: 7 | times: 1000 }});}
    function stop(){clearInterval(timer);timer=null;}
    function restart(){stop();start();}
    track.addEventListener('focusin',function(e){if(e.target.matches&&e.target.matches(':focus-visible'))paused=true;});track.addEventListener('focusout',function(){paused=false;});
    track.addEventListener('touchend',restart,{passive:true});
    mark(0);start();
  })();
  (function(){
    var c=document.querySelector('[data-brf-countdown]');
    if(c){var to=new Date(c.getAttribute('data-to')),f=function(n){return n<10?'0'+n:''+n},el=function(k){return c.querySelector('[data-'+k+']')};
      var tick=function(){var ms=to-new Date();if(ms<=0){c.querySelector('.brf-scary__stones').hidden=true;c.querySelector('.brf-scary__count-lbl').hidden=true;c.querySelector('.brf-scary__here').hidden=false;return false;}
        var s=Math.floor(ms/1000);el('d').textContent=Math.floor(s/86400);el('h').textContent=f(Math.floor(s%86400/3600));el('m').textContent=f(Math.floor(s%3600/60));el('s').textContent=f(s%60);return true;};
      if(tick())var iv=setInterval(function(){if(!tick())clearInterval(iv);},1000);}
    var qb=document.querySelector('[data-brf-quotes]');
    if(qb){var qs=qb.children,qi=0;if(qs.length>1&&!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches))setInterval(function(){if(document.hidden)return;qs[qi].classList.remove('is-on');qi=(qi+1)%qs.length;qs[qi].classList.add('is-on');},6000);}
    var sl=document.querySelector('[data-brf-sleeps]');
    if(sl){var d=Math.ceil((new Date(sl.getAttribute('data-to'))-new Date())/864e5);if(d>1)sl.textContent='\u{1F384} '+d+' sleeps to go';else if(d===1)sl.textContent='\u{1F384} 1 sleep to go!';}
  })();
  </script>

