    </section>
    </div>
    </div>
    <div class="brf-hs__nav" data-brf-hs-nav hidden>
      <button type="button" class="brf-hs__arrow" data-brf-hs-prev aria-label="Previous slide"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
      <div class="brf-hs__dots" data-brf-hs-dots></div>
      <button type="button" class="brf-hs__arrow" data-brf-hs-next aria-label="Next slide"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </div>
  <script>
  (function(){
    var root=document.querySelector('[data-brf-hs]');if(!root)return;
    var track=root.querySelector('[data-brf-hs-track]'),slides=track.children,n=slides.length;if(n<2)return;
    var nav=root.querySelector('[data-brf-hs-nav]'),dotsEl=root.querySelector('[data-brf-hs-dots]'),dots=[],cur=0,timer=null,paused=false;
    var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
    for(var i=0;i<n;i++){(function(i){var b=document.createElement('button');b.type='button';b.className='brf-hs__dot';b.setAttribute('aria-label','Slide '+(i+1)+' of '+n);b.onclick=function(){go(i);stop();};dotsEl.appendChild(b);dots.push(b);})(i);}
    nav.hidden=false;
    function mark(i){cur=i;for(var k=0;k<n;k++){dots[k].setAttribute('aria-current',k===i?'true':'false');slides[k].setAttribute('aria-hidden',k===i?'false':'true');slides[k].inert=k!==i;}}
    function go(i){i=(i+n)%n;track.scrollTo({left:slides[i].offsetLeft-track.offsetLeft,behavior:reduce?'auto':'smooth'});mark(i);}
    var t;track.addEventListener('scroll',function(){clearTimeout(t);t=setTimeout(function(){var i=Math.round(track.scrollLeft/track.clientWidth);if(i!==cur)mark(Math.max(0,Math.min(n-1,i)));},80);},{passive:true});
    root.querySelector('[data-brf-hs-prev]').onclick=function(){go(cur-1);stop();};
    root.querySelector('[data-brf-hs-next]').onclick=function(){go(cur+1);stop();};
    function start(){if(reduce||timer)return;timer=setInterval(function(){if(!paused&&!document.hidden)go(cur+1);},{{ section.settings.hl_autoplay | default: 7 | times: 1000 }});}
    function stop(){clearInterval(timer);timer=null;}
    root.addEventListener('mouseenter',function(){paused=true;});root.addEventListener('mouseleave',function(){paused=false;});
    root.addEventListener('focusin',function(){paused=true;});root.addEventListener('focusout',function(){paused=false;});
    track.addEventListener('touchstart',stop,{passive:true});
    mark(0);start();
  })();
  </script>

  {%- comment -%} TRUST STRIP {%- endcomment -%}
  <div class="brf-wrap">
    <div class="brf-trust">
      <div class="brf-trust__item"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><div><strong>{{ section.settings.trust_1_title }}</strong><span>{{ section.settings.trust_1_text }}</span></div></div>
      <div class="brf-trust__item"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg><div><strong>{{ section.settings.trust_2_title }}</strong><span>{{ section.settings.trust_2_text }}</span></div></div>
      <div class="brf-trust__item"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12l9-8 9 8M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg><div><strong>{{ section.settings.trust_3_title }}</strong><span>{{ section.settings.trust_3_text }}</span></div></div>
      <div class="brf-trust__item"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg><div><strong>{{ section.settings.trust_4_title }}</strong><span>{{ section.settings.trust_4_text }}</span></div></div>
    </div>
  </div>

  {%- comment -%} PROMO TILES (scrolling offers strip) {%- endcomment -%}
  {%- render 'brf-promo-strip' -%}

  {%- comment -%} HALLOWEEN (auto-hides after the end date) {%- endcomment -%}
  {%- assign hw_today = 'now' | date: '%Y%m%d' | plus: 0 -%}
  {%- assign hw_end = section.settings.halloween_end | remove: '-' | strip | plus: 0 -%}
  {%- assign hw_show = section.settings.show_halloween -%}
  {%- if hw_end > 0 and hw_today > hw_end -%}{%- assign hw_show = false -%}{%- endif -%}
  {%- assign hw = section.settings.halloween_collection -%}{%- if hw.handle == blank -%}{%- assign hw = collections[section.settings.halloween_collection] -%}{%- endif -%}
  {%- if hw.handle == blank -%}{%- assign hw = collections['halloween'] -%}{%- endif -%}
  {%- if hw_show and hw.handle != blank and hw.products_count > 0 -%}
  {%- assign hw_kw = section.settings.halloween_keywords | downcase | split: ',' -%}
  {%- assign hw_list = ',' -%}{%- assign hw_n = 0 -%}
  {%- for product in hw.products limit: 50 -%}
    {%- if hw_n >= 4 -%}{%- break -%}{%- endif -%}
    {%- unless product.available -%}{%- continue -%}{%- endunless -%}
    {%- assign t = product.title | downcase -%}{%- assign hit = false -%}
    {%- for w in hw_kw -%}{%- assign ws = w | strip -%}{%- if ws != blank and t contains ws -%}{%- assign hit = true -%}{%- endif -%}{%- endfor -%}
    {%- if hit -%}{%- assign hw_list = hw_list | append: product.handle | append: ',' -%}{%- assign hw_n = hw_n | plus: 1 -%}{%- endif -%}
  {%- endfor -%}
  {%- for product in hw.products limit: 50 -%}
    {%- if hw_n >= 4 -%}{%- break -%}{%- endif -%}
    {%- unless product.available -%}{%- continue -%}{%- endunless -%}
    {%- assign key = ',' | append: product.handle | append: ',' -%}
    {%- if hw_list contains key -%}{%- continue -%}{%- endif -%}
    {%- assign hw_list = hw_list | append: product.handle | append: ',' -%}{%- assign hw_n = hw_n | plus: 1 -%}
  {%- endfor -%}
  {%- assign hw_handles = hw_list | split: ',' -%}
  <section class="brf-spooky" aria-labelledby="brf-spooky-title">
    {%- render 'brf-spooky-layer' -%}
    <svg class="brf-spooky__deco brf-spooky__web" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M0 0L200 60M0 0L170 130M0 0L120 180M0 0L55 200M0 0L0 200M0 0L200 0"/><path d="M40 0Q34 12 38 11Q30 22 12 36Q10 40 0 42"/><path d="M85 0Q76 22 82 25Q70 46 42 72Q24 80 0 88"/><path d="M135 0Q124 36 132 42Q114 72 76 110Q50 126 0 138"/><path d="M190 0Q172 50 182 58Q160 100 110 148Q76 170 0 190"/></svg>
    <svg class="brf-spooky__deco brf-spooky__moon" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" fill="#F3E3B8"/><circle cx="44" cy="46" r="8" fill="#E2CE98"/><circle cx="74" cy="72" r="11" fill="#E2CE98"/><circle cx="78" cy="38" r="5" fill="#E2CE98"/></svg>
    <svg class="brf-spooky__deco brf-spooky__bats" viewBox="0 0 180 90" fill="#0B090E" aria-hidden="true"><path d="M20 40c6-8 13-9 18-3 2-4 6-4 8 0 5-6 12-5 18 3-6-2-10 0-12 4-2-2-5-2-7 0-2-2-5-2-7 0-3-4-7-6-18-4z"/><path d="M92 18c4-5 9-6 12-2 1-3 4-3 5 0 3-4 8-3 12 2-4-1-7 0-8 3-1-1-3-1-5 0-1-1-3-1-5 0-2-3-5-4-11-3z"/><path d="M130 62c5-7 11-8 15-3 2-3 5-3 7 0 4-5 10-4 15 3-5-2-9 0-10 3-2-1-4-1-6 0-2-1-4-1-6 0-2-3-6-5-15-3z"/></svg>
    <div class="brf-wrap">
      <div class="brf-head">
        <div>
          <span class="brf-eyebrow">{{ section.settings.halloween_eyebrow }}</span>
          <h2 class="brf-h2 brf-serif" id="brf-spooky-title">{{ section.settings.halloween_heading }}</h2>
          <p class="brf-spooky__lede">{{ section.settings.halloween_text }}</p>
        </div>
      </div>
      <div class="brf-grid4">
        {%- for h in hw_handles -%}
          {%- if h == blank -%}{%- continue -%}{%- endif -%}
          {%- assign product = all_products[h] -%}
          {%- if product.id == blank -%}{%- continue -%}{%- endif -%}
          <div class="brf-card">
            <a class="brf-card__media" href="{{ product.url | within: hw }}">
              <div class="brf-swatch">{% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{% endif %}</div>
              {%- if product.compare_at_price > product.price -%}
                {%- assign save = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                <span class="brf-badge">Save {{ save }}%</span>
              {%- endif -%}
            </a>
            <a class="brf-card__title" href="{{ product.url | within: hw }}">{{ product.title }}</a>
            <div class="brf-card__price">
              {%- if product.price_varies -%}<strong>From {{ product.price_min | money }}</strong>
              {%- elsif product.compare_at_price > product.price -%}<strong class="is-sale">{{ product.price | money }}</strong><s>{{ product.compare_at_price | money }}</s>
              {%- else -%}<strong>{{ product.price | money }}</strong>{%- endif -%}
            </div>
            {%- if product.has_only_default_variant -%}
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="brf-btn brf-btn--line">Add to bag</button>
              {%- endform -%}
            {%- else -%}
              <a class="brf-btn brf-btn--line" href="{{ product.url | within: hw }}">Choose options</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- comment -%} R11. Halloween Home & Décor (smart collection: type Halloween + tag home-lifestyle) {%- endcomment -%}
      {%- assign hd = collections['halloween-home-decor'] -%}
      {%- if hd.products_count > 0 -%}
        <div class="brf-spooky__decor">
          <div class="brf-spooky__decor-head">
            <div>
              <span class="brf-eyebrow">Spooky home décor</span>
              <h3 class="brf-serif">Haunt the house too</h3>
            </div>
            <a class="brf-spooky__decor-all" href="{{ hd.url }}">See all {{ hd.products_count }} &rarr;</a>
          </div>
          <div class="brf-spooky__rail">
            {%- for product in hd.products limit: 8 -%}
              <div class="brf-card">
                <a class="brf-card__media" href="{{ product.url | within: hd }}">
                  <div class="brf-swatch">{% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{% endif %}</div>
                  {%- unless product.available -%}<span class="brf-badge">Sold out</span>{%- endunless -%}
                </a>
                <a class="brf-card__title" href="{{ product.url | within: hd }}">{{ product.title }}</a>
                <div class="brf-card__price">
                  {%- if product.price_varies -%}<strong>From {{ product.price_min | money }}</strong>
                  {%- elsif product.compare_at_price > product.price -%}<strong class="is-sale">{{ product.price | money }}</strong><s>{{ product.compare_at_price | money }}</s>
                  {%- else -%}<strong>{{ product.price | money }}</strong>{%- endif -%}
                </div>
                {%- if product.has_only_default_variant and product.available -%}
                  {%- form 'product', product -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <button type="submit" class="brf-btn brf-btn--line">Add to bag</button>
                  {%- endform -%}
                {%- else -%}
                  <a class="brf-btn brf-btn--line" href="{{ product.url | within: hd }}">{% if product.available %}Choose options{% else %}View{% endif %}</a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <div class="brf-spooky__foot">
        <a class="brf-btn brf-btn--pumpkin" href="{{ hw.url }}">Shop all {{ hw.products_count }} Halloween fabrics</a>
        {%- if hd.products_count > 0 -%}<a class="brf-btn brf-btn--line brf-spooky__foot-2" href="{{ hd.url }}">Shop Halloween décor</a>{%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} SHOP BY FABRIC {%- endcomment -%}
  <section class="brf-wrap brf-section">
    <div class="brf-head">
      <div><span class="brf-eyebrow">Shop by fabric</span><h2 class="brf-h2 brf-serif">{{ section.settings.fabrics_heading }}</h2></div>
      <a href="/collections">View all fabrics &rarr;</a>
