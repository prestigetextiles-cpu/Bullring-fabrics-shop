          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for h in default_handles -%}
          {%- assign c = collections[h] -%}
          {%- if c.handle == blank -%}{%- continue -%}{%- endif -%}
          {%- assign i = forloop.index0 -%}
          <a class="brf-tile" href="{{ c.url }}">
            <div class="brf-swatch" style="background-color:{{ swatch_colours[i] }}">{% if c.image %}<img src="{{ c.image | img_url: '600x' }}" alt="{{ default_labels[i] | escape }}" loading="lazy">{% endif %}</div>
