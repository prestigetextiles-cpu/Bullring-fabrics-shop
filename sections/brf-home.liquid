{%- comment -%}
  Bull Ring Fabrics — redesigned homepage (static section, rendered from templates/index.liquid).
  All styles are scoped under .brf-home so nothing else in the theme is affected.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .brf-home{--brf-ground:#F7F3EC;--brf-surface:#FFFFFF;--brf-ink:#1C1B19;--brf-muted:#5E5A52;--brf-line:#E4DCCD;--brf-accent:{{ section.settings.accent | default: '#1F4D3A' }};--brf-brass:#8A5A1C;--brf-sale:#A3372B;--brf-sand:#EDE3D1;
    background:var(--brf-ground);color:var(--brf-ink);font-family:Figtree,system-ui,-apple-system,sans-serif;font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased}
  .brf-home *,.brf-home *::before,.brf-home *::after{box-sizing:border-box}
  .brf-home a{color:var(--brf-accent);text-decoration:none}
  .brf-home a:hover{text-decoration:underline}
  .brf-home img{display:block;width:100%;height:100%;object-fit:cover}
  .brf-wrap{max-width:1440px;margin:0 auto;padding:0 80px}
  .brf-serif{font-family:Fraunces,Georgia,serif;font-weight:500;letter-spacing:-.01em}
  .brf-eyebrow{display:block;font-size:13px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--brf-brass);margin:0 0 10px}
  .brf-h2{margin:0;font-size:44px;line-height:1.1}
  .brf-section{padding-top:96px;padding-bottom:96px}
  .brf-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:40px}
  .brf-head a{font-size:15px;font-weight:600;white-space:nowrap}
  .brf-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 28px;border-radius:999px;font-size:16px;font-weight:600;border:1.5px solid transparent;cursor:pointer;font-family:inherit;transition:background .15s,color .15s}
  .brf-home a.brf-btn:hover{text-decoration:none}
  .brf-btn--solid{background:var(--brf-accent);color:#fff!important}
  .brf-btn--solid:hover{filter:brightness(.9)}
  .brf-btn--ink{background:var(--brf-ink);color:#fff!important}
  .brf-btn--line{border-color:var(--brf-ink);color:var(--brf-ink)!important;background:transparent}
  .brf-btn--line:hover{background:var(--brf-ink);color:#fff!important}
  .brf-btn--light{background:var(--brf-ground);color:var(--brf-ink)!important}
  .brf-swatch{background-color:#C98B7E;background-image:repeating-linear-gradient(45deg,rgba(255,255,255,.07) 0 2px,transparent 2px 6px),repeating-linear-gradient(-45deg,rgba(0,0,0,.06) 0 2px,transparent 2px 6px);border-radius:6px;overflow:hidden}

  /* Hero */
  .brf-hero{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;padding-top:64px;padding-bottom:64px}
  .brf-hero h1{margin:0 0 24px;font-size:68px;line-height:1.03;letter-spacing:-.02em}
  .brf-hero h1.brf-hero__h1{margin:0;font-size:inherit;line-height:inherit;letter-spacing:normal;font-weight:inherit}
  .brf-hero__title{display:block;margin:0 0 24px;font-size:68px;line-height:1.03;letter-spacing:-.02em}
  .brf-hero p{margin:0 0 32px;font-size:19px;line-height:1.6;color:var(--brf-muted);max-width:520px}
  .brf-hero__ctas{display:flex;flex-wrap:wrap;gap:14px}
  .brf-hero__media{position:relative;height:520px;display:grid;grid-template-columns:1.4fr 1fr;grid-template-rows:1fr 1fr;gap:16px}
  .brf-hero__media>.brf-swatch:first-child{grid-row:1 / span 2}
  .brf-hero__card{position:absolute;left:24px;bottom:24px;background:#fff;border-radius:6px;padding:16px 20px;box-shadow:0 8px 24px rgba(28,27,25,.14);max-width:320px}
  .brf-hero__card .brf-eyebrow{margin-bottom:4px;font-size:12px}
  .brf-hero__card strong{display:block;font-family:Fraunces,Georgia,serif;font-weight:500;font-size:20px;line-height:1.25;margin-bottom:4px}
  .brf-hero__card a{font-size:14px;font-weight:600}

  /* Trust */
  .brf-trust{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;border-top:1px solid var(--brf-line);border-bottom:1px solid var(--brf-line);padding:28px 0}
  .brf-trust__item{display:flex;align-items:center;gap:14px}
  .brf-trust__item svg{flex:none;color:var(--brf-accent)}
  .brf-trust__item strong{display:block;font-size:15px}
  .brf-trust__item span{font-size:13px;color:var(--brf-muted)}

  /* Fabric tiles */
  .brf-grid4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
  .brf-grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  .brf-tile{display:flex;flex-direction:column;gap:14px;color:var(--brf-ink)!important}
  .brf-home a.brf-tile:hover{text-decoration:none}
  .brf-tile .brf-swatch{aspect-ratio:1/1.05}
  .brf-tile .brf-swatch img{transition:transform .5s ease}
  .brf-tile:hover .brf-swatch img{transform:scale(1.04)}
  .brf-tile__meta{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
  .brf-tile__name{font-family:Fraunces,Georgia,serif;font-size:22px;font-weight:500}
  .brf-tile__count{font-size:14px;color:var(--brf-muted);white-space:nowrap}

  /* Projects */
  .brf-project{position:relative;display:flex;height:440px;border-radius:6px;overflow:hidden;color:#fff!important}
  .brf-home a.brf-project:hover{text-decoration:none}
  .brf-project .brf-swatch{position:absolute;inset:0;border-radius:0}
  .brf-project__body{position:relative;margin-top:auto;width:100%;padding:32px;background:rgba(20,18,16,.58)}
  .brf-project__body strong{display:block;font-family:Fraunces,Georgia,serif;font-weight:500;font-size:30px;margin-bottom:6px}
  .brf-project__body span{display:block;font-size:15px;line-height:1.5}
  .brf-project__body em{display:block;font-style:normal;font-weight:600;font-size:15px;margin-top:10px}

  /* Products */
  .brf-products{background:var(--brf-surface)}
  .brf-card{display:flex;flex-direction:column;gap:12px}
  .brf-card__media{position:relative;display:block;aspect-ratio:1/1.15}
  .brf-card__media .brf-swatch{width:100%;height:100%}
  .brf-badge{position:absolute;left:12px;top:12px;padding:5px 10px;background:var(--brf-sale);color:#fff;font-size:12px;font-weight:700;border-radius:999px}
  .brf-card__title{color:var(--brf-ink)!important;font-size:16px;font-weight:500;line-height:1.4}
  .brf-card__price{display:flex;gap:10px;align-items:baseline}
  .brf-card__price strong{font-size:18px}
  .brf-card__price strong.is-sale{color:var(--brf-sale)}
  .brf-card__price s{font-size:14px;color:var(--brf-muted)}
  .brf-card form{margin:0}
  .brf-card .brf-btn{width:100%;min-height:44px;font-size:14px;margin-top:auto}

  /* Promo panels */
  .brf-panels{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  .brf-panel{min-height:400px;padding:48px;border-radius:6px;display:flex;flex-direction:column}
  .brf-panel h2{margin:0 0 16px;font-size:48px;line-height:1.05}
  .brf-panel p{margin:0 0 28px;font-size:17px;line-height:1.6;max-width:460px}
  .brf-panel__ctas{margin-top:auto;display:flex;flex-wrap:wrap;align-items:center;gap:20px}
  .brf-panel__ctas a:not(.brf-btn){font-weight:600;font-size:15px}
  .brf-panel--sand{background:var(--brf-sand)}
  .brf-panel--sand p{color:var(--brf-muted)}
  .brf-panel--dark{background:var(--brf-accent);color:var(--brf-ground)}
  .brf-panel--dark .brf-eyebrow{color:#E7C98F}
  .brf-panel--dark p{color:#E9E2D4}
  .brf-panel--dark .brf-panel__ctas a:not(.brf-btn){color:var(--brf-ground)}

  /* Outlet */
  .brf-outlet{display:grid;grid-template-columns:1fr 1fr;background:var(--brf-surface);border:1px solid var(--brf-line);border-radius:6px;overflow:hidden;min-height:420px}
  .brf-outlet .brf-swatch{border-radius:0;background-color:#8C5A3C}
  .brf-outlet__body{padding:56px;display:flex;flex-direction:column;gap:18px}
  .brf-outlet__body h2{margin:0;font-size:40px;line-height:1.1}
  .brf-outlet__body p{margin:0;font-size:17px;line-height:1.6;color:var(--brf-muted)}
  .brf-outlet__facts{display:grid;grid-template-columns:1fr 1fr;gap:24px;font-size:15px;line-height:1.6}
  .brf-outlet__facts span{color:var(--brf-muted)}
  .brf-outlet__body > a{margin-top:auto;font-weight:600}

  /* Blog */
  .brf-post{display:flex;flex-direction:column;gap:14px;color:var(--brf-ink)!important}
  .brf-home a.brf-post:hover{text-decoration:none}
  .brf-post:hover .brf-post__title{text-decoration:underline}
  .brf-post .brf-swatch{aspect-ratio:16/10}
  .brf-post time{font-size:13px;color:var(--brf-muted)}
  .brf-post__title{font-family:Fraunces,Georgia,serif;font-weight:500;font-size:23px;line-height:1.3}

  /* Halloween */
  .brf-spooky{position:relative;overflow:hidden;background:#16121B;color:#EDE6DA;padding:88px 0}
  .brf-spooky__deco{position:absolute;pointer-events:none;color:#EDE6DA}
  .brf-spooky__web{top:0;left:0;width:220px;height:220px;opacity:.16}
  .brf-spooky__moon{top:48px;right:96px;width:120px;height:120px}
  .brf-spooky__bats{top:150px;right:230px;width:180px;height:90px;opacity:.85}
  .brf-spooky .brf-head{position:relative}
  .brf-spooky .brf-eyebrow{color:#F08A24}
  .brf-spooky .brf-h2{color:#FBF6EE;font-size:52px}
  .brf-spooky__lede{margin:14px 0 0;max-width:560px;font-size:17px;line-height:1.6;color:#C9C0D3}
  .brf-home .brf-spooky .brf-head a{color:#F5A04A}
  .brf-btn--pumpkin{background:#F08A24;color:#16121B!important}
  .brf-btn--pumpkin:hover{background:#F5A04A}
  .brf-spooky .brf-card__title{color:#F3EDE4!important}
  .brf-spooky .brf-card__price strong{color:#FBF6EE}
  .brf-spooky .brf-card__price strong.is-sale{color:#F5A04A}
  .brf-spooky .brf-card__price s{color:#9D93A8}
  .brf-spooky .brf-badge{background:#F08A24;color:#16121B}
  .brf-spooky .brf-swatch{background-color:#2A2233}
  .brf-spooky .brf-btn--line{border-color:#EDE6DA;color:#EDE6DA!important}
  .brf-spooky .brf-btn--line:hover{background:#EDE6DA;color:#16121B!important}
  .brf-spooky__foot{position:relative;margin-top:40px;display:flex;justify-content:center;flex-wrap:wrap;gap:12px}
  /* R11. Halloween home décor rail inside the spooky section */
  .brf-spooky__decor{position:relative;margin-top:56px;padding-top:40px;border-top:1px solid rgba(237,230,218,.14)}
  .brf-spooky__decor-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px}
  .brf-spooky__decor-head h3{margin:6px 0 0;font-size:clamp(24px,2.4vw,32px);line-height:1.1;color:#F3E3B8}
  .brf-spooky__decor-all{flex:0 0 auto;font-weight:600;color:#F2A65A!important;text-decoration:none;white-space:nowrap}
  .brf-spooky__decor-all:hover{text-decoration:underline}
  .brf-spooky__rail{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 72px) / 4);gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding-bottom:4px}
  .brf-spooky__rail::-webkit-scrollbar{display:none}
  .brf-spooky__rail>.brf-card{scroll-snap-align:start}
  .brf-spooky__foot .brf-spooky__foot-2{color:#EDE6DA!important;border-color:rgba(237,230,218,.45)!important}
  @media (max-width:999px){.brf-spooky__rail{grid-auto-columns:calc((100% - 24px) / 2.3)}}
  @media (max-width:640px){.brf-spooky__decor{margin-top:40px;padding-top:28px}.brf-spooky__rail{grid-auto-columns:62%;gap:12px;margin:0 -20px;padding:0 20px 4px;scroll-padding:0 20px}}

  /* Older Safari (before 15) has no aspect-ratio or inset: without these, the image boxes have no height
     and the grid columns grow to the image's full size. Padding-box fallback keeps the same proportions. */
  .brf-grid4>*,.brf-grid3>*{min-width:0}
  .brf-project .brf-swatch{top:0;right:0;bottom:0;left:0}
  @supports not (aspect-ratio:1/1){
    .brf-card__media{height:0;padding-bottom:115%}
    .brf-card__media .brf-swatch{position:absolute;top:0;left:0}
    .brf-tile .brf-swatch{position:relative;height:0;padding-bottom:105%}
    .brf-post .brf-swatch{position:relative;height:0;padding-bottom:62.5%}
    .brf-tile .brf-swatch img,.brf-post .brf-swatch img{position:absolute;top:0;left:0}
  }

  /* hero gallery banner */
  .brf-hs{position:relative}
  .brf-hs__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-ms-overflow-style:none;scroll-behavior:smooth;overscroll-behavior-x:contain}
  .brf-hs__track::-webkit-scrollbar{display:none}
  .brf-hs__slide{flex:0 0 100%;min-width:0;display:flex;align-items:center;scroll-snap-align:start;scroll-snap-stop:always}
  .brf-hs__slide>.brf-hero{flex:1 1 auto;min-width:0}
  .brf-hs__slide .brf-hero{padding-bottom:40px}
  .brf-hs__nav{display:flex;align-items:center;justify-content:center;gap:14px;padding:0 0 36px}
  .brf-hs__dots{display:flex;gap:8px}
  .brf-hs__dot{width:8px;height:8px;padding:0;border:0;border-radius:99px;background:rgba(28,27,25,.22);cursor:pointer;transition:width .35s ease,background .35s ease}
  .brf-hs__dot[aria-current="true"]{width:28px;background:#1C1B19}
  .brf-hs__arrow{width:36px;height:36px;border-radius:50%;border:1px solid rgba(28,27,25,.18);background:#fff;color:#1C1B19;display:grid;place-items:center;cursor:pointer;padding:0;transition:background .2s,color .2s}
  .brf-hs__arrow:hover{background:#1C1B19;color:#fff}
  .brf-hs__h{display:block;margin:0 0 24px;font-size:64px;line-height:1.03;letter-spacing:-.02em;font-weight:inherit}
  .brf-hs__h .brf-eyebrow{font-size:13px;line-height:1.4;letter-spacing:.18em;margin-bottom:14px}
  .brf-hs__new{display:inline-block;margin-right:8px;padding:3px 8px;border-radius:99px;background:#1C1B19;color:#fff;letter-spacing:.12em}
  .brf-hs__chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 30px;padding:0;list-style:none;max-width:560px}
  .brf-hs__chips a{display:inline-block;padding:6px 12px;border-radius:99px;background:#fff;border:1px solid rgba(28,27,25,.12);font-size:13.5px;font-weight:600;color:#1C1B19;text-decoration:none;white-space:nowrap;transition:border-color .2s,transform .2s}
  .brf-hs__chips a:hover{border-color:#1C1B19;transform:translateY(-1px)}
  .brf-hero__media--hl{grid-template-columns:1.25fr 1fr 1fr}
  .brf-hl-tile{position:relative;display:block;border-radius:6px;overflow:hidden;background:#fff;text-decoration:none;color:#1C1B19}
  .brf-hl-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:14px 14px 44px;transition:transform .5s ease}
  .brf-hl-tile.is-photo img{object-fit:cover;padding:0}
  .brf-hl-tile:hover img{transform:scale(1.04)}
  .brf-hl-tile span{position:absolute;left:10px;bottom:10px;padding:6px 11px;border-radius:99px;background:rgba(255,255,255,.92);box-shadow:0 2px 8px rgba(28,27,25,.12);font-size:13px;font-weight:700;line-height:1.2;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
  .brf-hero__media--hl>.brf-hl-tile:first-child{grid-row:1 / span 2}
  .brf-hero__media--hl>.brf-hl-tile:first-child span{font-size:15px}
  .brf-hs__slide .brf-hero>*{min-width:0}
  @media (max-width:1023px){.brf-hs__h{font-size:52px}.brf-hs__slide .brf-hero{grid-template-columns:minmax(0,1fr)}}
  @media (max-width:640px){
    .brf-hs__slide .brf-hero{padding-bottom:20px}
    .brf-hs__nav{padding-bottom:28px}
    .brf-hs__arrow{display:none}
    .brf-hs__h{font-size:38px;margin-bottom:14px}
    .brf-hs__chips{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin:0 -16px 22px;padding:0 16px;max-width:none}
    .brf-hs__chips::-webkit-scrollbar{display:none}
    .brf-hero__media--hl{grid-template-columns:1.2fr 1fr;grid-template-rows:1fr 1fr}
    .brf-hero__media--hl>.brf-hl-tile:nth-child(n+4){display:none}
    .brf-hl-tile img{padding:10px 10px 38px}
    .brf-hl-tile span{font-size:12px;padding:5px 9px;left:8px;bottom:8px}
  }
  @media (prefers-reduced-motion:reduce){.brf-hs__track{scroll-behavior:auto}}
  @media (max-width:1023px){
    .brf-wrap{padding:0 32px}
    .brf-hero{grid-template-columns:1fr;gap:40px}
    .brf-hero__media{height:420px}
    .brf-grid4{grid-template-columns:repeat(2,minmax(0,1fr))}
    .brf-trust{grid-template-columns:repeat(2,1fr)}
    .brf-panels,.brf-outlet{grid-template-columns:1fr}
    .brf-outlet .brf-swatch{min-height:280px}
    .brf-spooky__moon,.brf-spooky__bats{display:none}
  }
  @media (max-width:640px){
    .brf-wrap{padding:0 16px}
    .brf-section{padding-top:48px;padding-bottom:48px}
    .brf-hero{padding-top:20px;padding-bottom:36px;gap:24px}
    .brf-hero__media{order:-1;height:300px;gap:8px}
    .brf-hero__card{display:none}
    .brf-hero h1{font-size:40px;margin-bottom:16px}
    .brf-hero__title{font-size:40px;margin-bottom:16px}
    .brf-hero p{font-size:16px;margin-bottom:24px}
    .brf-hero__ctas{flex-direction:column}
    .brf-hero__ctas .brf-btn{width:100%}
    .brf-h2{font-size:30px}
    .brf-head{margin-bottom:22px}
    .brf-head .brf-eyebrow{display:none}
    .brf-grid4{gap:16px 12px}
    .brf-grid3{grid-template-columns:1fr;gap:16px}
    .brf-tile{gap:8px}
    .brf-tile__name{font-family:inherit;font-size:15px;font-weight:600}
    .brf-tile__count{display:none}
    .brf-project{height:260px}
    .brf-project__body{padding:20px}
    .brf-project__body strong{font-size:24px}
    .brf-trust{gap:18px 12px;padding:20px 0}
    .brf-trust__item svg{display:none}
    .brf-panel{min-height:0;padding:32px 24px}
    .brf-panel h2{font-size:32px}
    .brf-outlet__body{padding:32px 24px}
    .brf-outlet__body h2{font-size:30px}
    .brf-outlet__facts{grid-template-columns:1fr}
    .brf-card__title{font-size:14px}
    .brf-spooky{padding:48px 0}
    .brf-spooky .brf-h2{font-size:34px}
    .brf-spooky__lede{font-size:15px}
    .brf-spooky__foot .brf-btn{width:100%}
  }
</style>

{%- comment -%} Default content used until blocks/settings are filled in the theme editor {%- endcomment -%}
{%- assign fabric_blocks = section.blocks | where: 'type', 'fabric' -%}
{%- assign default_handles = 'rose-hubble,satin,lace,taffeta,plush-velvet,craft-cotton,tapestry,denim' | split: ',' -%}
{%- assign default_labels = 'Cotton Poplin,Satin,Lace,Taffeta,Plush Velvet,Craft Cotton,Tapestry,Denim' | split: ',' -%}
{%- assign swatch_colours = '#C98B7E,#D9C3A0,#E6DCCB,#6B3A4B,#1F4A4F,#C9A23A,#8C5A3C,#3B5270' | split: ',' -%}

<div class="brf-home">

  {%- comment -%} HERO {%- endcomment -%}
  {%- assign hero_col = section.settings.hero_collection -%}{%- if hero_col.handle == blank -%}{%- assign hero_col = collections[section.settings.hero_collection] -%}{%- endif -%}
  {%- if hero_col == blank or hero_col.handle == blank -%}{%- assign hero_col = collections['rose-hubble'] -%}{%- endif -%}
  {%- assign hl_items = nil -%}
  {%- for l in linklists['main-menu-2026'].links -%}{%- assign lt = l.title | strip | handleize -%}{%- if lt == 'home-lifestyle' -%}{%- assign hl_items = l.links -%}{%- endif -%}{%- endfor -%}
  {%- assign hl_col = collections['home-lifestyle'] -%}
  <div class="brf-hs" data-brf-hs>
    <div class="brf-hs__track" data-brf-hs-track tabindex="-1">
