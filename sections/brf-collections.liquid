{%- comment -%}
  Bull Ring Fabrics — "All collections" page (/collections). Groups are built from the header menu,
  so new collections added to the menu appear here automatically.
{%- endcomment -%}
<style>
  .brf-cl{font-family:Figtree,system-ui,-apple-system,sans-serif;color:#1C1B19;-webkit-font-smoothing:antialiased;background:#F7F3EC}
  .brf-cl *{box-sizing:border-box}
  .brf-cl a{text-decoration:none}
  .brf-cl__wrap{max-width:1480px;margin:0 auto;padding:0 40px}
  .brf-cl__serif{font-family:Fraunces,Georgia,serif;font-weight:500;letter-spacing:-.01em}

  .brf-cl__hero{position:relative;min-height:420px;display:flex;align-items:flex-end;background:#1C1B19 center/cover no-repeat;color:#F7F3EC}
  .brf-cl__hero::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,18,16,.9) 0%,rgba(20,18,16,.7) 45%,rgba(20,18,16,.25) 100%)}
  .brf-cl__hero-inner{position:relative;width:100%;padding-top:72px;padding-bottom:48px}
  .brf-cl__brand{display:flex;align-items:center;gap:14px;margin-bottom:18px}
  .brf-cl__brand img{height:64px;width:64px;object-fit:contain;border-radius:10px;background:#fff;padding:4px}
  .brf-cl__brand span{font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#E7C98F}
  .brf-cl__hero h1{margin:0;font-size:58px;line-height:1.04;color:#FBF6EE;max-width:720px}
  .brf-cl__hero p{margin:14px 0 0;max-width:600px;font-size:17px;line-height:1.6;color:#E9E2D4}
  .brf-cl__search{margin-top:26px;display:flex;max-width:560px;background:#fff;border-radius:999px;padding:6px;gap:6px}
  .brf-cl__search label{position:absolute;left:-9999px}
  .brf-cl__search input{flex:1;border:0;background:transparent;padding:0 18px;font:inherit;font-size:16px;color:#1C1B19;min-height:46px;outline:none}
  .brf-cl__search button{border:0;border-radius:999px;background:#1F4D3A;color:#fff;font:inherit;font-weight:600;font-size:15px;padding:0 24px;min-height:46px;cursor:pointer}
  .brf-cl__search button:hover{background:#143427}
  .brf-cl__jump{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
  .brf-cl__jump a{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border-radius:999px;border:1px solid rgba(247,243,236,.35);color:#F7F3EC!important;font-size:14px;font-weight:500}
  .brf-cl__jump a:hover{background:#F7F3EC;color:#1C1B19!important}

  .brf-cl__trust{background:#fff;border-bottom:1px solid #E4DCCD}
  .brf-cl__trust-row{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:18px 0}
  .brf-cl__trust-item{display:flex;align-items:center;gap:12px;line-height:1.35}
  .brf-cl__trust-item svg{flex:none;color:#1F4D3A}
  .brf-cl__trust-item strong{display:block;font-size:14px}
  .brf-cl__trust-item span{color:#5E5A52;font-size:13px}

  .brf-cl__group{padding:56px 0 8px;scroll-margin-top:120px}
  .brf-cl__head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:22px;padding-bottom:14px;border-bottom:1px solid #E4DCCD}
  .brf-cl__head h2{margin:0;font-size:34px;line-height:1.1}
  .brf-cl__head p{margin:6px 0 0;color:#5E5A52;font-size:15px}
  .brf-cl__head span{font-size:13px;font-weight:600;color:#6B665D;white-space:nowrap}
  .brf-cl__grid{display:grid;grid-template-columns:repeat(6,1fr);gap:18px}
  .brf-cl__grid--featured{grid-template-columns:repeat(4,1fr);gap:20px}
  .brf-cl__card{display:flex;flex-direction:column;background:#fff;border:1px solid #E4DCCD;border-radius:8px;overflow:hidden;color:#1C1B19!important;transition:box-shadow .2s,transform .2s}
  .brf-cl__card:hover{box-shadow:0 10px 24px rgba(28,27,25,.1);transform:translateY(-2px)}
  .brf-cl__img{aspect-ratio:1/1;background:#EDE3D1;overflow:hidden}
  .brf-cl__grid--featured .brf-cl__img{aspect-ratio:4/3}
  .brf-cl__img img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
  .brf-cl__card:hover .brf-cl__img img{transform:scale(1.05)}
  .brf-cl__meta{padding:12px 14px 14px;display:flex;flex-direction:column;gap:2px}
  .brf-cl__meta strong{font-size:15px;font-weight:600;line-height:1.3}
  .brf-cl__grid--featured .brf-cl__meta strong{font-family:Fraunces,Georgia,serif;font-weight:500;font-size:22px}
  .brf-cl__meta span{font-size:13px;color:#6B665D}

  .brf-cl__help{margin:64px 0 0;padding:56px 0;background:#1F4D3A;color:#F7F3EC}
  .brf-cl__help-row{display:flex;align-items:center;justify-content:space-between;gap:32px;flex-wrap:wrap}
  .brf-cl__help h2{margin:0 0 6px;font-size:32px;color:#FBF6EE}
  .brf-cl__help p{margin:0;color:#E9E2D4;font-size:16px;max-width:620px;line-height:1.6}
  .brf-cl__help-ctas{display:flex;gap:12px;flex-wrap:wrap}
  .brf-cl__btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;border-radius:999px;font-weight:600;font-size:15px}
  .brf-cl__btn--light{background:#F7F3EC;color:#1C1B19!important}
  .brf-cl__btn--ghost{border:1.5px solid #F7F3EC;color:#F7F3EC!important}

  @media (max-width:1199px){.brf-cl__grid{grid-template-columns:repeat(4,1fr)}}
  @media (max-width:1023px){
    .brf-cl__wrap{padding:0 24px}
    .brf-cl__hero h1{font-size:44px}
    .brf-cl__trust-row{grid-template-columns:repeat(2,1fr)}
    .brf-cl__grid,.brf-cl__grid--featured{grid-template-columns:repeat(3,1fr)}
  }
  @media (max-width:640px){
    .brf-cl__wrap{padding:0 16px}
    .brf-cl__hero{min-height:0}
    .brf-cl__hero-inner{padding-top:40px;padding-bottom:28px}
    .brf-cl__hero h1{font-size:34px}
    .brf-cl__hero p{font-size:15px}
    .brf-cl__jump{flex-wrap:nowrap;overflow-x:auto;margin-left:-16px;margin-right:-16px;padding:0 16px;scrollbar-width:none}
    .brf-cl__jump::-webkit-scrollbar{display:none}
    .brf-cl__jump a{flex:none}
    .brf-cl__trust-item svg{display:none}
    .brf-cl__group{padding-top:36px}
    .brf-cl__head h2{font-size:26px}
    .brf-cl__head span{display:none}
    .brf-cl__grid,.brf-cl__grid--featured{grid-template-columns:repeat(2,1fr);gap:12px}
    .brf-cl__grid--featured .brf-cl__meta strong{font-size:18px}
    .brf-cl__help h2{font-size:26px}
    .brf-cl__help-ctas .brf-cl__btn{flex:1 1 100%}
  }
</style>

{%- assign menu = linklists[section.settings.menu] -%}
{%- if section.settings.menu == blank or menu.links.size == 0 -%}{%- assign menu = linklists['main-menu-2026'] -%}{%- endif -%}
{%- capture hero_bg -%}{%- if section.settings.banner -%}{{ section.settings.banner | img_url: '2000x' }}{%- else -%}https://cdn.shopify.com/s/files/1/0289/3443/8987/files/multiple-rolls-of-fabric-on-shelves.jpg?width=2000{%- endif -%}{%- endcapture -%}

<div class="brf-cl">
  <section class="brf-cl__hero" style="background-image:url('{{ hero_bg | strip }}')">
    <div class="brf-cl__wrap brf-cl__hero-inner">
      <div class="brf-cl__brand">
        {%- if section.settings.logo -%}<img src="{{ section.settings.logo | img_url: '200x' }}" alt="{{ shop.name | escape }}" width="64" height="64">{%- else -%}<img src="https://cdn.shopify.com/s/files/1/0289/3443/8987/files/Bullring_Logo.png?width=200" alt="Bull Ring Fabrics" width="64" height="64">{%- endif -%}
        <span>{{ section.settings.eyebrow }}</span>
      </div>
      <h1 class="brf-cl__serif">{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <form class="brf-cl__search" action="{{ routes.search_url }}" method="get" role="search">
        <label for="brf-cl-q">Search fabrics</label>
        <input id="brf-cl-q" type="search" name="q" placeholder="Search fabrics — e.g. velvet, poplin, organza">
        <input type="hidden" name="type" value="product">
        <button type="submit">Search</button>
      </form>
      <nav class="brf-cl__jump" aria-label="Jump to a category">
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}<a href="#brf-cl-{{ link.title | handleize }}">{{ link.title }}</a>{%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
  </section>

  <div class="brf-cl__trust">
    <div class="brf-cl__wrap brf-cl__trust-row">
      <div class="brf-cl__trust-item"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><div><strong>Free UK delivery over £65</strong><span>Tracked, UK mainland</span></div></div>
      <div class="brf-cl__trust-item"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg><div><strong>Same-day dispatch</strong><span>Order before 10pm, Mon–Fri</span></div></div>
      <div class="brf-cl__trust-item"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12l9-8 9 8M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg><div><strong>Wholesale &amp; trade</strong><span>Rolls and job lots for business</span></div></div>
      <div class="brf-cl__trust-item"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg><div><strong>Secure checkout</strong><span>PayPal, Apple Pay, cards</span></div></div>
    </div>
  </div>

  {%- comment -%} Featured ranges: top-level menu links that point straight to a collection {%- endcomment -%}
  {%- capture featured_cards -%}
    {%- for link in menu.links -%}
      {%- if link.links.size == 0 and link.type == 'collection_link' -%}
        {%- assign c = link.object -%}
        {%- assign img = c.image | default: c.products.first.featured_image -%}
        <a class="brf-cl__card" href="{{ c.url }}">
          <div class="brf-cl__img">{% if img %}<img src="{{ img | img_url: '700x' }}" alt="{{ link.title | escape }}" loading="lazy">{% endif %}</div>
          <div class="brf-cl__meta"><strong>{{ link.title }}</strong><span>{{ c.products_count }} products</span></div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if featured_cards != blank -%}
  <section class="brf-cl__group">
    <div class="brf-cl__wrap">
      <div class="brf-cl__head"><div><h2 class="brf-cl__serif">{{ section.settings.featured_heading }}</h2><p>{{ section.settings.featured_text }}</p></div></div>
      <div class="brf-cl__grid brf-cl__grid--featured">{{ featured_cards }}</div>
    </div>
  </section>
  {%- endif -%}

  {%- for link in menu.links -%}
    {%- if link.links.size == 0 -%}{%- continue -%}{%- endif -%}
    {%- case link.title -%}
      {%- when 'Dress Fabric' -%}{%- assign blurb = section.settings.dress_text -%}
      {%- when 'Craft Fabric' -%}{%- assign blurb = section.settings.craft_text -%}
      {%- when 'Upholstery & Curtains' -%}{%- assign blurb = section.settings.upholstery_text -%}
      {%- when 'Home & Lifestyle' -%}{%- assign blurb = section.settings.home_text -%}
      {%- else -%}{%- assign blurb = '' -%}
    {%- endcase -%}
    <section class="brf-cl__group" id="brf-cl-{{ link.title | handleize }}">
      <div class="brf-cl__wrap">
        <div class="brf-cl__head">
          <div><h2 class="brf-cl__serif">{{ link.title }}</h2>{% if blurb != blank %}<p>{{ blurb }}</p>{% endif %}</div>
          <span>{{ link.links.size }} collections</span>
        </div>
        <div class="brf-cl__grid">
          {%- for child in link.links -%}
            {%- assign c = child.object -%}
            {%- if child.type != 'collection_link' or c == blank -%}{%- continue -%}{%- endif -%}
            {%- assign img = c.image | default: c.products.first.featured_image -%}
            <a class="brf-cl__card" href="{{ c.url }}">
              <div class="brf-cl__img">{% if img %}<img src="{{ img | img_url: '500x' }}" alt="{{ child.title | escape }}" loading="lazy">{% endif %}</div>
              <div class="brf-cl__meta"><strong>{{ child.title }}</strong><span>{{ c.products_count }} products</span></div>
            </a>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endfor -%}

  <section class="brf-cl__help">
    <div class="brf-cl__wrap brf-cl__help-row">
      <div>
        <h2 class="brf-cl__serif">{{ section.settings.help_heading }}</h2>
        <p>{{ section.settings.help_text }}</p>
      </div>
      <div class="brf-cl__help-ctas">
        <a class="brf-cl__btn brf-cl__btn--light" href="/pages/contact">Contact us</a>
        <a class="brf-cl__btn brf-cl__btn--ghost" href="/pages/wholesale-trade-enquiries">Trade enquiries</a>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "All collections page",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu to build the page from", "info": "Leave empty to use Main menu (2026 redesign). Top-level items with a dropdown become sections; single links become featured ranges." },
    { "type": "image_picker", "id": "banner", "label": "Banner image", "info": "Defaults to a photo of fabric rolls" },
    { "type": "image_picker", "id": "logo", "label": "Logo shown on banner" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Bull Ring Fabrics · Birmingham" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop all fabrics" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Dress, craft and upholstery fabrics by the metre, seasonal prints and trade rolls — all at wholesale prices and dispatched the same day when you order before 10pm." },
    { "type": "text", "id": "featured_heading", "label": "Featured ranges heading", "default": "Featured ranges" },
    { "type": "text", "id": "featured_text", "label": "Featured ranges text", "default": "Our most popular ranges, seasonal edits and bargain rails." },
    { "type": "textarea", "id": "dress_text", "label": "Dress Fabric intro", "default": "Poplins, satins, lace, velvet and more for dressmaking and costumes." },
    { "type": "textarea", "id": "craft_text", "label": "Craft Fabric intro", "default": "Craft cottons, felt, fleece, faux fur and polycotton for makes of every size." },
    { "type": "textarea", "id": "upholstery_text", "label": "Upholstery intro", "default": "Hard-wearing velvets, tapestry, faux leather and curtaining for the home." },
    { "type": "textarea", "id": "home_text", "label": "Home & Lifestyle intro", "default": "Household essentials, tools, garden and storage." },
    { "type": "text", "id": "help_heading", "label": "Help heading", "default": "Can't find what you're looking for?" },
    { "type": "textarea", "id": "help_text", "label": "Help text", "default": "Our team can help you find the right fabric, check stock or quote for bulk and trade orders." }
  ]
}
{% endschema %}
