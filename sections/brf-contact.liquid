    });
  });

  /* Map loads only when asked (keeps the page fast and cookie-free until then) */
  var map = root.querySelector('[data-ct-map]');
  if (map) map.querySelector('[data-ct-map-load]').addEventListener('click', function(){
    var f = document.createElement('iframe'); f.src = map.getAttribute('data-src'); f.title = 'Map showing Bullring Fabrics'; f.loading = 'lazy'; f.referrerPolicy = 'no-referrer-when-downgrade';
    map.innerHTML = ''; map.appendChild(f);
  });

  /* Guided form: the topic decides the hint and whether we ask for an order number */
  var form = root.querySelector('#ct-contact-form'); if (!form) return;
  var hint = form.querySelector('[data-ct-hint]'), orderF = form.querySelector('[data-ct-order]'), msg = form.querySelector('[data-ct-msg]'), count = form.querySelector('[data-ct-count]');
  var HINTS = {
    'An order I’ve placed': 'Pop your order number in below and we’ll find it straight away. To see where your parcel is, the tracking link is in your dispatch email.',
    'Delivery': 'Orders placed by 10pm Monday to Friday leave us the same day. Your tracking link is in your dispatch email. <a href="/pages/delivery-times">Delivery details</a>',
    'Returns & refunds': 'Tell us your order number and which items you’d like to return, and we’ll send you a returns label. <a href="/pages/returns-policy">Returns policy</a>',
    'Fabric advice': 'Tell us about your project, the look you’re after and any colours. A link to the fabric you’re considering helps too!',
    'Wholesale & trade': 'For full rolls and bulk pricing, our <a href="/pages/wholesale-trade-enquiries">trade enquiry form</a> gets you to the right person fastest.',
    'Something else': ''
  };
  var PH = {order: 'How can we help with your order?', advice: 'Tell us about your project…', trade: 'What are you looking for, and roughly how much?', other: 'How can we help?'};
  [].forEach.call(form.querySelectorAll('.ct-topic input'), function(r){
    r.addEventListener('change', function(){
      var h = HINTS[r.value] || '';
      hint.innerHTML = h; hint.hidden = !h;
      if (h) { hint.style.animation = 'none'; void hint.offsetWidth; hint.style.animation = ''; }
      orderF.hidden = r.getAttribute('data-kind') !== 'order';
      var lab = form.querySelector('label[for="ct-msg"]'); if (lab) lab.textContent = PH[r.getAttribute('data-kind')] || PH.other;
    });
  });
  if (msg && count) msg.addEventListener('input', function(){ var n = msg.value.length; count.textContent = n > 20 ? n + ' characters' : ''; });
  form.addEventListener('submit', function(){ var b = form.querySelector('.ct-send'); if (b) { b.classList.add('is-busy'); b.querySelector('span').textContent = 'Sending…'; } });

  /* After sending, bring the thank-you into view */
  var sent = root.querySelector('[data-ct-sent]');
  if (sent) setTimeout(function(){ sent.scrollIntoView({behavior: calm ? 'auto' : 'smooth', block: 'center'}); }, 200);
})();
</script>

{% schema %}
{
  "name": "Contact us page",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone number", "default": "0330 088 2120" },
    { "type": "text", "id": "email", "label": "Email address", "info": "Leave empty to use the store's email address" },
    { "type": "text", "id": "address", "label": "Address (comma separated lines)", "default": "Unit 1 Byron Road, Birmingham, B10 0EN" },
    { "type": "text", "id": "weekday_open", "label": "Monday to Friday opens (24h, e.g. 10:00)", "default": "10:00" },
    { "type": "text", "id": "weekday_close", "label": "Monday to Friday closes (24h, e.g. 18:00)", "default": "18:00" },
    { "type": "text", "id": "saturday", "label": "Saturday", "info": "Closed, or hours like 10:00 – 16:00", "default": "Closed" },
    { "type": "text", "id": "sunday", "label": "Sunday", "info": "Closed, or hours like 10:00 – 16:00", "default": "Closed" },
    { "type": "text", "id": "collection_note", "label": "Note under the address", "default": "We’re an online warehouse, so collection in person is currently unavailable. Everything ships fast, though!" },
    { "type": "text", "id": "facebook", "label": "Facebook page link", "default": "https://www.facebook.com/bullringfabrics" }
  ]
}
