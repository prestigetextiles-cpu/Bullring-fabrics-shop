{%- comment -%}
  Bull Ring Fabrics — bespoke Contact us page (/pages/contact, rendered by templates/page.contact.liquid).
  Live "open now" badge (UK time), three ways to reach us, quick answers before writing, a guided
  contact form (topic chips, order number when it matters), find-us card with map and hours, and
  the most-asked questions (with FAQ structured data). Phone, email, hours and address are editable
  in Customize.
{%- endcomment -%}
{%- liquid
  assign c_phone = section.settings.phone | default: '0330 088 2120'
  assign c_tel = c_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
  assign c_email = section.settings.email | default: shop.email
  assign c_addr = section.settings.address | default: 'Unit 1 Byron Road, Birmingham, B10 0EN'
  assign c_map_q = c_addr | url_encode
  assign wk_open = section.settings.weekday_open | default: '10:00'
  assign wk_close = section.settings.weekday_close | default: '18:00'
  assign sat = section.settings.saturday | default: 'Closed'
  assign sun = section.settings.sunday | default: 'Closed'
-%}

<div class="ct" data-ct data-open="{{ wk_open }}" data-close="{{ wk_close }}" data-sat="{{ sat | escape }}" data-sun="{{ sun | escape }}">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <section class="ct-hero">
    <div class="ct-hero__glow" aria-hidden="true"></div>
    <div class="container ct-hero__in">
      <div class="ct-hero__copy ct-rise">
        <nav class="ct-crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span aria-current="page">Contact us</span></nav>
        <p class="ct-status" data-ct-status hidden><span class="ct-status__dot" aria-hidden="true"></span><span data-ct-status-t></span></p>
        <h1 class="ct-hero__title">Let’s talk fabric.</h1>
        <p class="ct-hero__text">Whether it’s a question about an order, help choosing the right fabric, or a roll for your business, our Birmingham team is happy to help. Real people, real fabric know-how.</p>
        <ul class="ct-hero__chips" role="list">
          <li>Same-day dispatch before 10pm</li>
          <li>Free UK delivery over £65</li>
          <li>30-day returns</li>
        </ul>
      </div>

      <ul class="ct-ways" role="list">
        <li class="ct-rise">
          <a class="ct-way" href="tel:{{ c_tel }}">
            <span class="ct-way__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3.5l1.8 4.4-2.2 1.4a11 11 0 0 0 6.1 6.1l1.4-2.2L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z"/></svg></span>
            <span class="ct-way__t">Call us</span>
            <span class="ct-way__v">{{ c_phone }}</span>
            <span class="ct-way__s" data-ct-phone-note>Monday to Friday, {{ wk_open }} to {{ wk_close }}</span>
          </a>
        </li>
        <li class="ct-rise">
          <a class="ct-way" href="mailto:{{ c_email }}">
            <span class="ct-way__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg></span>
            <span class="ct-way__t">Email us</span>
            <span class="ct-way__v ct-way__v--sm">{{ c_email }}</span>
            <span class="ct-way__s">Include your order number if you have one</span>
          </a>
          <button type="button" class="ct-copy" data-ct-copy="{{ c_email | escape }}" aria-label="Copy email address"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg><span>Copy</span></button>
        </li>
        <li class="ct-rise">
          <a class="ct-way" href="#ct-form" data-ct-jump>
            <span class="ct-way__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5z"/><path d="M8 8.5h8M8 11.5h5"/></svg></span>
            <span class="ct-way__t">Send a message</span>
            <span class="ct-way__v ct-way__v--sm">Use our quick form</span>
            <span class="ct-way__s">Pick a topic and we’ll get it to the right person</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {%- comment -%} ---------- QUICK ANSWERS ---------- {%- endcomment -%}
  <section class="ct-sec" aria-labelledby="ct-quick-t">
    <div class="container">
      <div class="ct-sec__head ct-rise">
        <h2 class="ct-sec__title" id="ct-quick-t">Quick answers, no waiting.</h2>
        <p class="ct-sec__sub">Most questions are answered here in seconds.</p>
      </div>
      <div class="ct-quick">
        <a class="ct-q ct-q--track ct-rise" href="{{ routes.account_url }}">
          <span class="ct-q__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg></span>
          <span class="ct-q__t">Where’s my order?</span>
          <span class="ct-q__s">We email a tracking link the moment your parcel leaves us. You can also see every order in your account.</span>
          <span class="ct-q__go">Track an order <span aria-hidden="true">›</span></span>
        </a>
        <a class="ct-q ct-rise" href="/pages/delivery-times">
          <span class="ct-q__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg></span>
          <span class="ct-q__t">Delivery &amp; dispatch</span>
          <ul class="ct-q__list" role="list">
            <li>Order by 10pm Mon–Fri, dispatched the same day</li>
            <li>Free UK delivery over £65, or £3.99</li>
            <li>Free next day over £150 (order by 9pm)</li>
            <li>Europe from £13.95, free over £400</li>
          </ul>
          <span class="ct-q__go">Delivery details <span aria-hidden="true">›</span></span>
        </a>
        <a class="ct-q ct-rise" href="/pages/returns-policy">
          <span class="ct-q__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg></span>
          <span class="ct-q__t">Returns &amp; refunds</span>
          <span class="ct-q__s">30 days to return unused, uncut items. Email us your order number and we’ll send a returns label. Fabric cut to your length can only come back if it’s faulty.</span>
          <span class="ct-q__go">Returns policy <span aria-hidden="true">›</span></span>
        </a>
        <a class="ct-q ct-rise" href="/pages/how-much-fabric-do-i-need">
          <span class="ct-q__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16.5 16.5 3l4.5 4.5L7.5 21z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/></svg></span>
          <span class="ct-q__t">How much fabric do I need?</span>
          <span class="ct-q__s">Our quantity guide works it out for dresses, curtains, cushions, sofas and more. Fabric is sold by the metre and cut in one continuous length.</span>
          <span class="ct-q__go">Read the guide <span aria-hidden="true">›</span></span>
        </a>
        <a class="ct-q ct-rise" href="/pages/wholesale-trade-enquiries">
          <span class="ct-q__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16v12H4z"/><path d="M9 7V5h6v2"/><path d="M4 12h16"/></svg></span>
          <span class="ct-q__t">Wholesale &amp; trade</span>
          <span class="ct-q__s">Full rolls and bulk pricing for schools, theatres, upholsterers and makers. We aim to reply to trade enquiries within 2 working days.</span>
          <span class="ct-q__go">Trade enquiry <span aria-hidden="true">›</span></span>
        </a>
        <a class="ct-q ct-rise" href="/pages/how-to-buy-fabrics">
          <span class="ct-q__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="7" r="2.5"/><circle cx="6" cy="17" r="2.5"/><path d="M8 8.5 20 17M8 15.5 20 7"/></svg></span>
          <span class="ct-q__t">Buying by the metre</span>
          <span class="ct-q__s">Need 8 metres? Choose a quantity of 8. Want it cut into pieces? Add a note at checkout and we’ll cut it to suit.</span>
          <span class="ct-q__go">How it works <span aria-hidden="true">›</span></span>
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- FORM + FIND US ---------- {%- endcomment -%}
  <section class="ct-sec ct-sec--form" id="ct-form">
    <div class="container ct-split">
      <div class="ct-card ct-card--form ct-rise">
        {%- form 'contact', id: 'ct-contact-form', class: 'ct-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="ct-sent" data-ct-sent>
              <span class="ct-sent__tick" aria-hidden="true"><svg viewBox="0 0 52 52" width="64" height="64"><circle cx="26" cy="26" r="24" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M15 27l7 7 15-15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <h2 class="ct-sent__t">Message received. Thank you!</h2>
              <p class="ct-sent__s">It’s on its way to our team, and we’ll reply by email as soon as we can. In the meantime, why not have a browse?</p>
              <div class="ct-sent__ctas">
                <a class="ct-btn ct-btn--dark" href="{{ routes.collections_url }}">Browse fabrics</a>
                <a class="ct-btn ct-btn--ghost" href="/collections/new-arrivals">New arrivals</a>
              </div>
            </div>
          {%- else -%}
            <h2 class="ct-form__t">Send us a message</h2>
            <p class="ct-form__s">Tell us a little about what you need and we’ll take it from there.</p>

            {%- if form.errors -%}
              <div class="ct-err" role="alert">
                {%- for field in form.errors -%}
                  <p>{%- if field == 'form' -%}{{ form.errors.messages[field] }}{%- else -%}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}{%- endif -%}</p>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <fieldset class="ct-topics">
              <legend class="ct-label">What’s it about?</legend>
              <div class="ct-topics__row">
                {%- assign topics = 'An order I’ve placed|order,Delivery|order,Returns & refunds|order,Fabric advice|advice,Wholesale & trade|trade,Something else|other' | split: ',' -%}
                {%- for t in topics -%}
                  {%- assign tb = t | split: '|' -%}
                  <label class="ct-topic"><input type="radio" name="contact[Topic]" value="{{ tb[0] | escape }}" data-kind="{{ tb[1] }}"{% if forloop.first %} required{% endif %}><span>{{ tb[0] | escape }}</span></label>
                {%- endfor -%}
              </div>
            </fieldset>

            <div class="ct-hint" data-ct-hint hidden></div>

            <div class="ct-grid">
              <div class="ct-field">
                <input id="ct-name" type="text" name="contact[name]" autocomplete="name" placeholder=" " required{% if customer %} value="{{ customer.name | escape }}"{% endif %}>
                <label for="ct-name">Your name</label>
              </div>
              <div class="ct-field">
                <input id="ct-email" type="email" name="contact[email]" autocomplete="email" placeholder=" " required{% if customer %} value="{{ customer.email | escape }}"{% endif %}>
                <label for="ct-email">Email address</label>
              </div>
              <div class="ct-field">
                <input id="ct-phone" type="tel" name="contact[phone]" autocomplete="tel" placeholder=" ">
                <label for="ct-phone">Phone <em>(optional)</em></label>
              </div>
              <div class="ct-field" data-ct-order hidden>
                <input id="ct-order" type="text" name="contact[Order number]" inputmode="numeric" placeholder=" ">
                <label for="ct-order">Order number <em>(e.g. #1234)</em></label>
              </div>
            </div>
            <div class="ct-field ct-field--area">
              <textarea id="ct-msg" name="contact[body]" rows="6" placeholder=" " required data-ct-msg></textarea>
              <label for="ct-msg">How can we help?</label>
              <span class="ct-count" data-ct-count aria-hidden="true"></span>
            </div>
            <div class="ct-form__foot">
              <button type="submit" class="ct-btn ct-btn--green ct-send"><span>Send message</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg></button>
              <p class="ct-form__small">We only use your details to reply to you. <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy policy</a></p>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>

      <aside class="ct-find ct-rise" aria-labelledby="ct-find-t">
        <div class="ct-card ct-card--find">
          <h2 class="ct-find__t" id="ct-find-t">Find us</h2>
          <address class="ct-find__addr">Bullring Fabrics<br>{{ c_addr | replace: ', ', '<br>' }}</address>
          <div class="ct-find__ctas">
            <a class="ct-btn ct-btn--dark ct-btn--sm" href="https://www.google.com/maps/dir/?api=1&destination={{ c_map_q }}" target="_blank" rel="noopener">Directions</a>
            <button type="button" class="ct-btn ct-btn--ghost ct-btn--sm" data-ct-copy="Bullring Fabrics, {{ c_addr | escape }}">Copy address</button>
          </div>
          {%- if section.settings.collection_note != blank -%}<p class="ct-find__note">{{ section.settings.collection_note | escape }}</p>{%- endif -%}

          <h3 class="ct-find__h">Opening hours <span>UK time</span></h3>
          <ul class="ct-hours" role="list" data-ct-hours>
            {%- assign days = 'Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday' | split: ',' -%}
            {%- for d in days -%}
              <li data-day="{{ forloop.index | modulo: 7 }}"><span>{{ d }}</span><span>{%- if forloop.index <= 5 -%}{{ wk_open }} – {{ wk_close }}{%- elsif forloop.index == 6 -%}{{ sat | escape }}{%- else -%}{{ sun | escape }}{%- endif -%}</span></li>
            {%- endfor -%}
          </ul>
          <p class="ct-find__small">Orders placed online any time before 10pm, Monday to Friday, still go out the same day.</p>
        </div>
        <div class="ct-map" data-ct-map data-src="https://maps.google.com/maps?q={{ c_map_q }}&z=15&output=embed">
          <button type="button" class="ct-map__btn" data-ct-map-load>
            <span class="ct-map__pin" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
            <span>Show map</span>
          </button>
        </div>
      </aside>
    </div>
  </section>

  {%- comment -%} ---------- FAQS ---------- {%- endcomment -%}
  {%- capture faq_rows -%}
How quickly will my order be dispatched?|Every order placed before 10pm (UK time), Monday to Friday, is dispatched the same day. Orders placed after 10pm, at the weekend or on a bank holiday go out the next working day.
How much does delivery cost?|UK standard delivery is £3.99, and free on orders over £65. Next day delivery is £6.99, or free on orders over £150 placed before 9pm. Europe Express is £13.95 and the rest of the world £20–£24.95, both free over £400.
Will my fabric arrive in one piece?|Yes. Fabric is cut from the roll in one continuous length wherever possible. If you’d like it cut into specific pieces, add a note to your order.
Can I return fabric?|Unused, uncut items can be returned within 30 days. Fabric cut to your chosen length can only be returned if it’s faulty. Email us with your order number to start a return.
Is everything on the website in stock?|Our fabrics are held at our West Midlands warehouse, and the website shows the stock available on the day you order.
Do you sell wholesale or full rolls?|Yes. We supply trade buyers across the UK with full rolls and bulk quantities. Send a trade enquiry and we aim to reply within 2 working days.
  {%- endcapture -%}
  {%- assign faqs = faq_rows | strip | newline_to_br | split: '<br />' -%}
  <section class="ct-sec ct-sec--faq" aria-labelledby="ct-faq-t">
    <div class="container ct-faq">
      <div class="ct-faq__head ct-rise">
        <h2 class="ct-sec__title" id="ct-faq-t">Often asked.</h2>
        <p class="ct-sec__sub">The questions we hear most, answered.</p>
        <a class="ct-btn ct-btn--ghost" href="/pages/faqs">All FAQs</a>
      </div>
      <div class="ct-faq__list ct-rise">
        {%- for f in faqs -%}
          {%- assign fb = f | strip | split: '|' -%}
          {%- if fb.size < 2 -%}{%- continue -%}{%- endif -%}
          <details class="ct-acc"{% if forloop.first %} open{% endif %}>
            <summary><span>{{ fb[0] }}</span><i aria-hidden="true"></i></summary>
            <div class="ct-acc__a"><p>{{ fb[1] }}</p></div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {%- for f in faqs -%}{%- assign fb = f | strip | split: '|' -%}{%- if fb.size < 2 -%}{%- continue -%}{%- endif -%}{%- unless forloop.first -%},{%- endunless -%}
    {"@type":"Question","name":{{ fb[0] | json }},"acceptedAnswer":{"@type":"Answer","text":{{ fb[1] | json }}}}
    {%- endfor -%}
  ]}
  </script>

  {%- comment -%} ---------- SIGN-OFF BAND ---------- {%- endcomment -%}
  <section class="ct-sec ct-sec--band">
    <div class="container">
      <div class="ct-band ct-rise">
        <div>
          <h2 class="ct-band__t">Buying for a business?</h2>
          <p class="ct-band__s">Schools, theatres, upholsterers, event stylists and makers get full rolls at trade prices.</p>
        </div>
        <div class="ct-band__ctas">
          <a class="ct-btn ct-btn--light" href="/pages/wholesale-trade-enquiries">Make a trade enquiry</a>
          {%- if section.settings.facebook != blank -%}<a class="ct-btn ct-btn--line" href="{{ section.settings.facebook }}" target="_blank" rel="noopener">Follow us on Facebook</a>{%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <div class="ct-toast" data-ct-toast role="status" aria-live="polite"></div>
</div>

<style>
  .ct{--ink:#1D1D1F;--sub:#6B665F;--line:#E4DDD1;--sand:#F6F3EE;--green:#149954;--deep:#1F4D3A;color:var(--ink)}
  .ct a{color:inherit}
  .template-page .ct{margin-bottom:24px}

  .ct-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 24px;border:0;border-radius:980px;font:inherit;font-size:15px;font-weight:600;text-decoration:none;cursor:pointer;white-space:nowrap;transition:transform .2s,background .2s,box-shadow .2s}
  .ct-btn--sm{height:40px;padding:0 18px;font-size:14px}
  .ct-btn--dark{background:var(--ink);color:#fff!important}
  .ct-btn--dark:hover{background:#000;transform:translateY(-1px)}
  .ct-btn--ghost{background:rgba(255,255,255,.7);box-shadow:inset 0 0 0 1px var(--ink);color:var(--ink)}
  .ct-btn--ghost:hover{background:#fff;transform:translateY(-1px)}
  .ct-btn--green{background:linear-gradient(180deg,#1DAE65 0%,#149954 52%,#0F884A 100%);color:#fff!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 10px 22px -12px rgba(20,153,84,.9)}
  .ct-btn--green:hover{transform:translateY(-1px)}
  .ct-btn--light{background:#fff;color:var(--ink)!important}
  .ct-btn--light:hover{transform:translateY(-1px)}
  .ct-btn--line{box-shadow:inset 0 0 0 1px rgba(255,255,255,.6);color:#fff!important}
  .ct-btn--line:hover{background:rgba(255,255,255,.1)}
  .ct-btn:focus-visible,.ct-way:focus-visible,.ct-q:focus-visible,.ct-copy:focus-visible{outline:3px solid rgba(20,153,84,.45);outline-offset:3px}

  /* Hero */
  .ct-hero{position:relative;overflow:hidden;background:linear-gradient(180deg,#FBF9F5 0%,#F3EEE6 100%)}
  .ct-hero__glow{position:absolute;inset:-20% -10% auto auto;width:70%;height:140%;pointer-events:none;
    background:radial-gradient(closest-side,rgba(255,182,219,.35),rgba(255,182,219,0) 70%) 10% 30%/55% 55% no-repeat,radial-gradient(closest-side,rgba(146,206,255,.35),rgba(146,206,255,0) 70%) 70% 20%/60% 60% no-repeat,radial-gradient(closest-side,rgba(140,230,186,.35),rgba(140,230,186,0) 70%) 50% 75%/60% 60% no-repeat;
    filter:blur(10px);animation:ct-drift 18s ease-in-out infinite alternate}
  @keyframes ct-drift{to{transform:translate(-6%,4%) rotate(8deg)}}
  .ct-hero__in{position:relative;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);align-items:center;gap:48px;padding-top:40px;padding-bottom:64px}
  .ct-crumbs{display:flex;gap:8px;margin:0 0 22px;font-size:13px;color:var(--sub)}
  .ct-crumbs a{text-decoration:none}
  .ct-crumbs a:hover{text-decoration:underline}
  .ct-status{display:inline-flex;align-items:center;gap:8px;margin:0 0 16px;padding:7px 14px 7px 12px;border-radius:980px;font-size:13.5px;line-height:1.35;font-weight:600;
    background:rgba(255,255,255,.74);-webkit-backdrop-filter:saturate(180%) blur(16px);backdrop-filter:saturate(180%) blur(16px);border:1px solid rgba(255,255,255,.6);box-shadow:0 1px 0 rgba(255,255,255,.8) inset,0 6px 18px -8px rgba(0,0,0,.2)}
  .ct-status__dot{position:relative;width:8px;height:8px;border-radius:50%;background:#B3B0A9}
  .ct-status.is-open .ct-status__dot{background:var(--green)}
