  "name": "Sale landing",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The Bull Ring Sale" },
    { "type": "text", "id": "heading", "label": "Heading (used if no discount can be worked out)", "default": "Fabric sale" },
    { "type": "textarea", "id": "text", "label": "Text", "info": "[count] = number of products in the sale, [best] = biggest discount.", "default": "[count] fabrics reduced across dress, craft and upholstery. Same-day dispatch, while stocks last." },
    { "type": "range", "id": "deal_min", "label": "\"Biggest savings\" shows products with at least this % off", "min": 10, "max": 70, "step": 5, "unit": "%", "default": 35 }
  ]
}
