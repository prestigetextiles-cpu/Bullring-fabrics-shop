    it = it || c.items[0];
    toast.innerHTML = (it.image ? '<img src="' + esc(img(it.image, 100)) + '" alt="" width="46" height="46">' : '<span class="brf-hc__ph"></span>') +
      '<span class="brf-hc__toast-tx"><span class="brf-hc__toast-h"><i aria-hidden="true">✓</i>In the bag!</span><span class="brf-hc__toast-t">' + esc(it.product_title) + '</span></span>' +
      '<span class="brf-hc__toast-go">View bag ›</span>';
    placeAt(toast);
    clearTimeout(toastT);
    toast.classList.remove('is-on'); void toast.offsetWidth; toast.classList.add('is-on');
    toastT = setTimeout(hideToast, 3600);
  }
  toast.addEventListener('mouseenter', function(){ clearTimeout(toastT); });
  toast.addEventListener('mouseleave', function(){ toastT = setTimeout(hideToast, 1200); });
  function quietAdd(force){
    cartData = null;
    setTimeout(function(){ loadCart(true).then(function(c){ syncCount(true); if (force || root.classList.contains('brf-hc')) showToast(c); }); }, 150);
  }
  window.brfBag = {
    added: function(variantId, force){ if (variantId) lastVariant = variantId; quietAdd(force); },
    open: openBag, close: closeBag
  };
  /* remember which variant was just added, so the note can show it */
  doc.addEventListener('submit', function(e){ var f = e.target, id = f && f.querySelector && f.querySelector('[name="id"]'); if (id && /\/cart\/add/.test(f.getAttribute('action') || '')) lastVariant = id.value; }, true);
  doc.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('[data-action="add-to-cart"], form[action*="/cart/add"] [type="submit"]');
    var f = b && b.closest('form'), id = f && f.querySelector('[name="id"]');
    if (id) lastVariant = id.value;
  }, true);
  /* the theme announces a theme-handled add with "product:added" on its way up to <html>, where its cart opens the drawer.
     While the capsule shows, or when the add came from the quick view (the drawer would open behind it), show our note instead. */
  doc.body.addEventListener('product:added', function(e){
    if (!desk.matches) return;
    var qv = e.target && e.target.closest && e.target.closest('.modal[id^="modal-quick-view"]');
    if (!qv && !root.classList.contains('brf-hc')) return;
    e.stopPropagation();
    if (e.detail && e.detail.variant && e.detail.variant.id) lastVariant = e.detail.variant.id;
    root.dispatchEvent(new CustomEvent('cart:refresh', {bubbles: true, detail: {scrollToTop: false}}));
    quietAdd(!!qv);
  });
  /* our own add-to-bag forms (see brf-v3-polish) ask before opening the drawer */
  doc.addEventListener('brf:bag-added', function(){ quietAdd(); });
  root.addEventListener('cart:rerendered', function(){ if (!busy) cartData = null; }, true);

  /* ---------- Scroll: condense ---------- */
  var ticking = false;
  function update(){
    ticking = false;
    if (!desk.matches) return;
    var stuck = hdr.getBoundingClientRect().top <= topVal + 0.5 && window.scrollY > 0;
    root.classList.toggle('brf-hc', stuck && !revealed);
    if (searching && !(stuck && !revealed)) closeSearch();
    if (!(stuck && !revealed)) { if (bagOpen) closeBag(true); hideToast(); }
  }
  hdr.addEventListener('transitionend', function(e){ if (e.target === hdr) update(); });
  window.addEventListener('scroll', function(){ if (!ticking) { ticking = true; requestAnimationFrame(update); } }, {passive: true});
  window.addEventListener('resize', function(){ if (row.offsetHeight !== rowH || !root.classList.contains('brf-hc-on') !== !desk.matches) measure(); }, {passive: true});
  if (desk.addEventListener) desk.addEventListener('change', function(){ rowH = 0; measure(); });
  if (window.ResizeObserver) new ResizeObserver(function(){ if (row.offsetHeight !== rowH) measure(); }).observe(row);

  /* ---------- Gliding hover highlight ---------- */
  var items = [].slice.call(mm.querySelectorAll('.brf-mm__top'));
  function glideTo(el){
    if (!el || !root.classList.contains('brf-hc') || searching) { glide.classList.remove('is-on'); return; }
    var p = pill.getBoundingClientRect(), r = el.getBoundingClientRect(), inset = 2;
    glide.style.width = (r.width - inset * 2) + 'px';
    glide.style.transform = 'translateX(' + (r.left - p.left + inset) + 'px)';
    glide.classList.add('is-on');
  }
  function glideRest(){ var open = mm.querySelector('.brf-mm__item.is-open .brf-mm__top'); glideTo(open); }
  items.forEach(function(t){
    t.addEventListener('mouseenter', function(){ glideTo(t); });
    t.addEventListener('focus', function(){ glideTo(t); });
  });
  mm.querySelector('.brf-mm__bar').addEventListener('mouseleave', function(){ setTimeout(glideRest, 200); });
  if (window.MutationObserver) new MutationObserver(function(){ if (!mm.querySelector('.brf-mm__bar:hover')) glideRest(); }).observe(mm.querySelector('.brf-mm__bar'), {attributes: true, attributeFilter: ['class'], subtree: true});

  measure();
  /* Only animate the header sliding after the first paint, so a restored scroll position doesn't animate */
  requestAnimationFrame(function(){ requestAnimationFrame(function(){ root.classList.add('brf-hc-anim'); }); });
})();
</script>
