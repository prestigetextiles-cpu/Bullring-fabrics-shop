          '<span class="brf-hc__bag-tx"><a class="brf-hc__bag-t" href="' + esc(it.url) + '">' + esc(it.product_title) + '</a>' + (v ? '<span class="brf-hc__bag-v">' + esc(v) + '</span>' : '') +
