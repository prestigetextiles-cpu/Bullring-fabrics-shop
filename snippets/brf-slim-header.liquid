  var bagPinned = false; var bag = doc.createElement('div'); bag.className = 'brf-hc__bag'; bag.id = 'brf-hc-bag'; bag.setAttribute('role', 'dialog'); bag.setAttribute('aria-label', 'Your bag');
  var toast = doc.createElement('a'); toast.className = 'brf-hc__toast'; toast.href = '{{ routes.cart_url }}'; toast.setAttribute('role', 'status'); toast.setAttribute('aria-live', 'polite');
  pill.insertBefore(glide, pill.firstChild);
