{%- comment -%}
  Bull Ring Fabrics — slim scrolling header for desktop (1000px and wider).
  As you scroll, the logo/search row slides away and the menu bar floats on as a slim glass capsule
  with a mini logo, search and bag, and a gliding hover highlight.
  Search: the menu melts into one long search field, the page behind blurs and a fun line appears.
  Bag: hovering the capsule bag or the full header's bag shows what's in it (change quantities or remove
  items right there), clicking goes to the bag page, and anything added while the capsule is showing or
  from the quick view gets a small "In the bag!" note instead of the cart drawer (window.brfBag).
  The full header slides back in when the account popover is opened or anything in it gets keyboard
  focus. Phones and tablets keep the existing header.
  How: the sticky header gets a negative top equal to the logo row's height, so only the menu bar
  stays pinned; nothing changes size, so the page below never jumps.
{%- endcomment -%}
<style>
  @media (min-width:1000px){
    html.brf-hc-on #shopify-section-header#shopify-section-header{top:var(--brf-hc-top,0px)!important}
    html.brf-hc-anim #shopify-section-header#shopify-section-header{transition:top .42s cubic-bezier(.2,.8,.2,1),background-color .3s ease,border-color .3s ease}
    html.brf-hc-reveal #shopify-section-header#shopify-section-header{top:0!important}

    /* Capsule parts are hidden until the header condenses */
    .brf-hc__logo,.brf-hc__acts,.brf-hc__glide,.brf-hc__veil,.brf-hc__quip{display:none}

    /* ---------- Condensed state ---------- */
    html.brf-hc #shopify-section-header#shopify-section-header{background:transparent!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;border-bottom-color:transparent!important;box-shadow:none!important;pointer-events:none}
    html.brf-hc #shopify-section-header [data-brf-mm]{border-top-color:transparent}
    html.brf-hc [data-brf-mm]>.container{
      position:relative;display:flex;align-items:center;gap:4px;height:54px;margin-top:6px;margin-bottom:-14px;
      max-width:min(1320px,calc(100% - 32px));padding:0 7px 0 8px;border-radius:980px;pointer-events:auto;
      background:rgba(255,255,255,.74);-webkit-backdrop-filter:saturate(180%) blur(22px);backdrop-filter:saturate(180%) blur(22px);
      box-shadow:inset 0 1px 0 rgba(255,255,255,.85),inset 0 0 0 .5px rgba(255,255,255,.6),0 0 0 .5px rgba(29,29,31,.08),0 12px 32px -14px rgba(29,29,31,.32);
      animation:brf-hc-in .62s cubic-bezier(.2,.9,.25,1.12) both}
    html.brf-hc.brf-mm-open [data-brf-mm]>.container,html.brf-hc.brf-hc-bagging [data-brf-mm]>.container{background:rgba(255,255,255,.94)}
    html.brf-hc.brf-hc-searching [data-brf-mm]>.container{background:rgba(255,255,255,.97);box-shadow:inset 0 1px 0 #fff,0 0 0 .5px rgba(29,29,31,.1),0 0 0 8px rgba(255,255,255,.55),0 24px 60px -18px rgba(29,29,31,.45),0 0 90px 10px rgba(255,255,255,.75);transition:box-shadow .4s ease,background .3s ease}
    @keyframes brf-hc-in{from{opacity:.4;transform:translateY(-12px) scaleX(.94)}to{opacity:1;transform:none}}

    html.brf-hc .brf-mm__bar{flex:1 1 auto;min-width:0;position:static;z-index:1}
    html.brf-hc .brf-mm__top{height:54px;padding:0 13px;font-size:14px}
    html.brf-hc .brf-mm__top::after{display:none}
    html.brf-hc .brf-mm__top:focus-visible{outline-offset:-6px;border-radius:980px}

    /* Gliding highlight that follows the pointer between menu items */
    html.brf-hc .brf-hc__glide{display:block;position:absolute;top:8px;left:0;height:38px;width:0;border-radius:980px;background:rgba(29,29,31,.07);opacity:0;pointer-events:none;z-index:0;
      transition:transform .38s cubic-bezier(.3,1.3,.4,1),width .38s cubic-bezier(.3,1.3,.4,1),opacity .2s ease}
    html.brf-hc .brf-hc__glide.is-on{opacity:1}

    /* Mega menu panels drop down as a floating glass card the width of the capsule.
       The shared full-width glass layer (brf-apple-ux) is switched off here: it sits outside the capsule
       and would paint over the panel. */
    html.brf-hc [data-brf-mm]>.container{z-index:30}
    html.brf-hc [data-brf-mm] .brf-mm__bg{display:none!important}
    html.brf-hc [data-brf-mm] .brf-mm__panel{top:calc(100% + 10px);border-radius:26px;
      background:rgba(250,250,252,.96)!important;-webkit-backdrop-filter:saturate(180%) blur(24px);backdrop-filter:saturate(180%) blur(24px);
      box-shadow:0 0 0 .5px rgba(29,29,31,.08),0 34px 80px -24px rgba(29,29,31,.4)!important}
    html.brf-hc [data-brf-mm] .brf-mm__panel>.container{max-width:none}

    /* Mini logo + actions (wide screens only; 1000–1199px keeps just the menu) */
    @media (min-width:1200px){
      html.brf-hc .brf-hc__logo{display:flex;align-items:center;justify-content:center;flex:0 0 auto;width:42px;height:42px;margin-right:6px;border-radius:50%;background:#fff;
        box-shadow:0 0 0 .5px rgba(29,29,31,.1),0 2px 6px -2px rgba(29,29,31,.2);animation:brf-hc-pop .7s cubic-bezier(.3,1.5,.4,1) .08s both}
      html.brf-hc .brf-hc__logo img{width:32px;height:32px;object-fit:contain}
      html.brf-hc .brf-hc__acts{display:flex;align-items:center;gap:2px;flex:0 0 auto;margin-left:4px;animation:brf-hc-pop .7s cubic-bezier(.3,1.5,.4,1) .14s both}
    }
    @keyframes brf-hc-pop{from{opacity:0;transform:scale(.4) rotate(-20deg)}to{opacity:1;transform:none}}
    .brf-hc__btn{position:relative;display:grid;place-items:center;width:40px;height:40px;padding:0;border:0;border-radius:50%;background:transparent;color:#1D1D1F;cursor:pointer;text-decoration:none;transition:background .2s,transform .3s cubic-bezier(.3,1.5,.4,1)}
    .brf-hc__btn:hover{background:rgba(29,29,31,.07)}
    .brf-hc__btn:active{transform:scale(.9)}
    .brf-hc__btn:focus-visible{outline:2px solid #149954;outline-offset:1px}
    .brf-hc__btn--cart{width:auto;min-width:40px;padding:0 13px 0 10px;gap:7px;display:inline-flex;align-items:center;background:#1D1D1F;color:#fff!important;border-radius:980px;font-size:13px;font-weight:600}
    .brf-hc__btn--cart:hover{background:#000}
    .brf-hc__bag-ic{display:block;flex:0 0 auto;width:21px;height:21px;margin:-2px 0 0}
    .brf-hc__count{min-width:18px;height:18px;padding:0 5px;border-radius:980px;background:#149954;color:#fff;font-size:11px;line-height:18px;text-align:center}
    .brf-hc__count[data-n="0"]{background:rgba(255,255,255,.2)}
    .brf-hc__count.is-bump{animation:brf-hc-bump .5s cubic-bezier(.3,1.6,.4,1)}
    @keyframes brf-hc-bump{0%{transform:scale(1)}40%{transform:scale(1.45)}100%{transform:scale(1)}}

    /* ---------- Search: the menu melts away and the capsule becomes one long search field ---------- */
    .brf-hc__search,.brf-hc__sugg{display:none}
    html.brf-hc .brf-mm__bar{transition:opacity .28s ease,transform .45s cubic-bezier(.2,.8,.2,1),filter .28s ease}
    html.brf-hc.brf-hc-searching .brf-mm__bar{opacity:0;transform:scale(.96);filter:blur(6px);pointer-events:none}
    html.brf-hc.brf-hc-searching .brf-hc__glide{opacity:0}
    @media (min-width:1200px){
      html.brf-hc .brf-hc__search{display:flex;position:absolute;top:6px;bottom:6px;left:var(--brf-hc-sl,52px);right:var(--brf-hc-sr,150px);z-index:2;align-items:center;gap:10px;margin:0;padding:0 8px 0 18px;
        border-radius:980px;background:#fff;box-shadow:inset 0 0 0 1px rgba(29,29,31,.1),0 0 0 4px rgba(20,153,84,0);opacity:0;pointer-events:none;
        clip-path:inset(0 0 0 calc(100% - 42px) round 980px);transition:clip-path .6s cubic-bezier(.2,.9,.25,1.04),opacity .18s ease,box-shadow .3s ease}
      html.brf-hc.brf-hc-searching .brf-hc__search{opacity:1;pointer-events:auto;clip-path:inset(0 0 0 0 round 980px);box-shadow:inset 0 0 0 1.5px #1D1D1F,0 0 0 4px rgba(29,29,31,.08)}
      .brf-hc__search svg{flex:0 0 auto;color:#1D1D1F}
      .brf-hc__search input{flex:1 1 auto;min-width:0;height:100%;margin:0;padding:0;border:0;outline:0;background:transparent;font:500 15px/1 var(--text-font-family,Inter,-apple-system,sans-serif);color:#1D1D1F;-webkit-appearance:none;appearance:none}
      .brf-hc__search input::placeholder{color:#8C867D}
      .brf-hc__search input::-webkit-search-cancel-button{display:none}
      .brf-hc__esc{flex:0 0 auto;padding:4px 8px;border:0;border-radius:8px;background:#F2F0EC;color:#6B665F;font:600 11px/1 var(--text-font-family,Inter,sans-serif);letter-spacing:.04em;cursor:pointer}
      .brf-hc__esc:hover{background:#E7E3DC;color:#1D1D1F}
      html.brf-hc.brf-hc-searching [data-brf-hc-search]{background:#1D1D1F;color:#fff}

      /* Live suggestions drop down from the capsule like the mega menu */
      html.brf-hc.brf-hc-searching .brf-hc__sugg.is-on{display:block;position:absolute;left:0;right:0;top:calc(100% + 10px);z-index:31;padding:18px;border-radius:26px;
        background:rgba(250,250,252,.97);-webkit-backdrop-filter:saturate(180%) blur(24px);backdrop-filter:saturate(180%) blur(24px);
        box-shadow:0 0 0 .5px rgba(29,29,31,.08),0 34px 80px -24px rgba(29,29,31,.4);animation:brf-hc-drop .35s cubic-bezier(.2,.9,.25,1.05) both}
      @keyframes brf-hc-drop{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
      .brf-hc__sugg-h{margin:0 6px 10px;font-size:12px;color:#6E6E73}
      .brf-hc__sugg-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:0;padding:0;list-style:none}
      .brf-hc__sugg-a{display:flex;align-items:center;gap:12px;padding:8px;border-radius:16px;text-decoration:none;color:#1D1D1F;transition:background .2s}
      .brf-hc__sugg-a:hover,.brf-hc__sugg-a.is-active{background:rgba(29,29,31,.06)}
      .brf-hc__sugg-a img,.brf-hc__sugg-a .brf-hc__ph{flex:0 0 52px;width:52px;height:52px;border-radius:12px;object-fit:cover;background:#ECE6DC}
      .brf-hc__sugg-t{display:-webkit-box;font-size:13.5px;font-weight:500;line-height:1.3;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
      .brf-hc__sugg-p{display:block;margin-top:3px;font-size:13px;font-weight:600}
      .brf-hc__sugg-all{display:inline-flex;margin:12px 6px 0;font-size:13.5px;font-weight:600;color:#1D1D1F;text-decoration:none}
      .brf-hc__sugg-all:hover{text-decoration:underline}
      .brf-hc__sugg-none{margin:4px 6px;font-size:14px;color:#6B665F}
    }
    @media (prefers-reduced-motion:reduce){
      html.brf-hc .brf-mm__bar,html.brf-hc .brf-hc__search{transition:none}
    }

    @media (min-width:1200px){
      /* The page behind the search blurs like frosted glass */
      html.brf-hc .brf-hc__veil{display:block;position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:0;visibility:hidden;
        background:rgba(246,244,240,.38);-webkit-backdrop-filter:blur(14px) saturate(140%);backdrop-filter:blur(14px) saturate(140%);
        transition:opacity .35s ease,visibility 0s linear .35s}
      html.brf-hc.brf-hc-searching .brf-hc__veil{opacity:1;visibility:visible;pointer-events:auto;cursor:default;transition:opacity .35s ease}

      /* A fun line under the search field, different every time */
      html.brf-hc .brf-hc__quip{display:block;position:absolute;left:50%;top:calc(100% + 14px);z-index:31;max-width:calc(100% - 40px);padding:9px 16px;border-radius:980px;
        background:rgba(255,255,255,.9);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);
        box-shadow:0 0 0 .5px rgba(29,29,31,.08),0 14px 34px -16px rgba(29,29,31,.35);
        font:500 14px/1.3 var(--text-font-family,Inter,sans-serif);color:#1D1D1F;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
        opacity:0;visibility:hidden;transform:translate(-50%,-6px);pointer-events:none;transition:opacity .25s ease,transform .35s cubic-bezier(.2,.9,.25,1.1),visibility 0s linear .25s}
      html.brf-hc.brf-hc-searching .brf-hc__quip.is-on{opacity:1;visibility:visible;transform:translate(-50%,0);transition:opacity .3s ease .18s,transform .5s cubic-bezier(.2,.9,.25,1.1) .18s}
      html.brf-hc.brf-hc-searching .brf-hc__sugg.is-on~.brf-hc__quip{opacity:0;visibility:hidden}

    }

    /* Filter bar under the capsule: one compact glass strip instead of a full-width band */
    html.brf-hc .brf-fstick.brf-fstick.is-stuck::before{opacity:0!important}
    html.brf-hc .brf-fstick.is-stuck .brf-fstick__in{width:-moz-fit-content;width:fit-content;max-width:min(1180px,calc(100% - 64px));margin:0 auto;transform:translateY(22px);padding:5px 6px 5px 6px!important;border-radius:980px;
      background:rgba(255,255,255,.84);-webkit-backdrop-filter:saturate(180%) blur(24px);backdrop-filter:saturate(180%) blur(24px);
      box-shadow:inset 0 1px 0 rgba(255,255,255,.8),0 0 0 .5px rgba(29,29,31,.08),0 10px 28px -16px rgba(29,29,31,.35);animation:brf-hc-fin .45s cubic-bezier(.2,.9,.25,1.05) both}
    @keyframes brf-hc-fin{from{opacity:0;transform:translateY(14px) scale(.97)}to{opacity:1;transform:translateY(22px)}}
    html.brf-hc.brf-hw-page .brf-fstick.is-stuck .brf-fstick__in{background:rgba(28,22,34,.72);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 0 0 .5px rgba(240,138,36,.25),0 10px 28px -16px rgba(0,0,0,.6)}
    html.brf-hc .brf-fstick.is-stuck .brf-fbar__row{gap:10px;flex-wrap:nowrap}
    html.brf-hc .brf-fstick.is-stuck .brf-fbar__pills{flex:0 1 auto;flex-wrap:nowrap;gap:6px;overflow-x:auto;scrollbar-width:none}
    html.brf-hc .brf-fstick.is-stuck .brf-fbar__pills::-webkit-scrollbar{display:none}
    html.brf-hc .brf-fstick.is-stuck .brf-pill{padding:5px 12px;font-size:13px;line-height:17px;border-color:transparent;background:rgba(29,29,31,.05);box-shadow:none!important}
    html.brf-hc .brf-fstick.is-stuck .brf-pill:hover{background:rgba(29,29,31,.09)}
    html.brf-hc .brf-fstick.is-stuck .brf-pill.is-active,html.brf-hc .brf-fstick.is-stuck .brf-pill.is-open{background:#fff;box-shadow:0 0 0 1px #2F4A73 inset!important}
    html.brf-hc .brf-fstick.is-stuck .brf-fbar__meta{gap:10px;padding-left:10px;border-left:1px solid rgba(29,29,31,.1)}
    html.brf-hc .brf-fstick.is-stuck .brf-fbar__count{display:none}
    html.brf-hc .brf-fstick.is-stuck .brf-switch{font-size:13px;gap:6px}
    html.brf-hc .brf-fstick.is-stuck .brf-switch__track{transform:scale(.85)}
    html.brf-hc .brf-fstick.is-stuck .brf-sort{font-size:13px;padding:5px 8px 5px 4px}
    html.brf-hc .brf-fstick.is-stuck .brf-fbar .brf-panel{top:calc(100% + 14px);min-width:min(720px,calc(100vw - 64px))}
    html.brf-hc .brf-fstick.is-stuck .brf-fbar .brf-panel--sort{min-width:0}
    html.brf-hc.brf-hc-searching .brf-fstick{opacity:.35;transition:opacity .3s}
  }
  @media (min-width:1000px) and (prefers-reduced-motion:reduce){
    html.brf-hc [data-brf-mm]>.container,html.brf-hc .brf-hc__logo,html.brf-hc .brf-hc__acts{animation:none}
    html.brf-hc-anim #shopify-section-header#shopify-section-header,html.brf-hc .brf-hc__glide{transition:none}
  }

  /* ---------- Bag peek + "In the bag!" note: used by the capsule and the full header (desktop) ---------- */
  .brf-hc__bag,.brf-hc__toast{display:none}
  @media (min-width:1000px){
      /* Bag: hover to peek inside */
      .brf-hc__bag{display:block;position:fixed;right:16px;top:70px;z-index:2147483001;width:380px;max-width:calc(100vw - 32px);border-radius:26px;overflow:hidden;
        background:rgba(250,250,252,.97);-webkit-backdrop-filter:saturate(180%) blur(24px);backdrop-filter:saturate(180%) blur(24px);
        box-shadow:0 0 0 .5px rgba(29,29,31,.08),0 34px 80px -24px rgba(29,29,31,.45);
        opacity:0;visibility:hidden;transform:translateY(-8px) scale(.98);transform-origin:90% 0;pointer-events:none;
        transition:opacity .2s ease,transform .3s cubic-bezier(.2,.9,.25,1.05),visibility 0s linear .2s}
      .brf-hc__bag.is-open{opacity:1;visibility:visible;transform:none;pointer-events:auto;transition:opacity .2s ease,transform .35s cubic-bezier(.2,.9,.25,1.05)}
      .brf-hc__bag-h{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:18px 20px 10px;font-weight:600;font-size:15px;color:#1D1D1F}
      .brf-hc__bag-h span{font-weight:400;font-size:13px;color:#6E6E73}
      .brf-hc__bag-h span{margin-left:auto}
      .brf-hc__bag-x{align-self:center;flex:0 0 28px;width:28px;height:28px;margin:-4px -6px -4px 0;display:grid;place-items:center;border:0;border-radius:50%;padding:0;
        background:rgba(29,29,31,.06);color:#1D1D1F;font:400 20px/1 inherit;cursor:pointer;transition:background .2s,transform .2s}
      .brf-hc__bag-x:hover{background:rgba(29,29,31,.12)}
      .brf-hc__bag-x:active{transform:scale(.9)}
      .brf-hc__bag-list{max-height:min(330px,calc(100vh - 300px));overflow:auto;margin:0;padding:0 10px;list-style:none;overscroll-behavior:contain;scrollbar-width:thin}
      .brf-hc__bag-li{display:flex;gap:12px;align-items:center;padding:8px 10px;border-radius:16px;text-decoration:none;color:#1D1D1F;transition:background .2s}
      .brf-hc__bag-li:hover{background:rgba(29,29,31,.05)}
      .brf-hc__bag-li img,.brf-hc__bag-li .brf-hc__ph{flex:0 0 54px;width:54px;height:54px;border-radius:12px;object-fit:cover;background:#ECE6DC}
      .brf-hc__bag-tx{flex:1 1 auto;min-width:0}
      .brf-hc__bag-t{display:-webkit-box;font-size:13.5px;font-weight:500;line-height:1.3;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
      .brf-hc__bag-v{display:block;margin-top:2px;font-size:12px;color:#6E6E73}
      .brf-hc__bag-p{flex:0 0 auto;font-size:13.5px;font-weight:600;white-space:nowrap}
      .brf-hc__bag-free{margin:10px 20px 0;font-size:12.5px;color:#3A3835}
      .brf-hc__bag-free i{display:block;height:5px;margin-top:7px;border-radius:5px;background:#ECE6DC;overflow:hidden}
      .brf-hc__bag-free i b{display:block;height:100%;border-radius:5px;background:linear-gradient(90deg,#149954,#0F7A42);transition:width .6s cubic-bezier(.2,.8,.2,1)}
      .brf-hc__bag-sub{display:flex;justify-content:space-between;margin:14px 20px 0;padding-top:12px;border-top:1px solid rgba(29,29,31,.08);font-size:14px}
      .brf-hc__bag-sub b{font-size:16px}
      .brf-hc__bag-btns{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:14px 16px 16px}
      .brf-hc__bag-btns a{display:flex;align-items:center;justify-content:center;height:44px;border-radius:980px;font-size:14px;font-weight:600;text-decoration:none;transition:background .2s,transform .2s}
      .brf-hc__bag-btns a:active{transform:scale(.97)}
      .brf-hc__bag-view{background:rgba(29,29,31,.07);color:#1D1D1F!important}
      .brf-hc__bag-view:hover{background:rgba(29,29,31,.12)}
      .brf-hc__bag-go{background:#149954;color:#fff!important}
      .brf-hc__bag-go:hover{background:#0F7A42}
      .brf-hc__bag-empty{padding:26px 22px 22px;text-align:center;font-size:14px;color:#3A3835}
      .brf-hc__bag-empty b{display:block;margin-bottom:4px;font-size:16px;color:#1D1D1F}
      .brf-hc__bag-load{padding:34px;text-align:center;font-size:13px;color:#6E6E73}

      /* "In the bag!" note when something is added while the capsule is showing */
      .brf-hc__toast{display:flex;align-items:center;gap:12px;position:fixed;right:16px;top:70px;z-index:2147483002;width:340px;padding:10px 12px 10px 10px;border-radius:22px;
        background:rgba(255,255,255,.95);-webkit-backdrop-filter:saturate(180%) blur(24px);backdrop-filter:saturate(180%) blur(24px);
        box-shadow:0 0 0 .5px rgba(29,29,31,.08),0 24px 60px -22px rgba(29,29,31,.45);color:#1D1D1F;text-decoration:none;
        opacity:0;visibility:hidden;transform:translateY(-10px) scale(.96);transform-origin:90% 0;pointer-events:none;
        transition:opacity .25s ease,transform .35s cubic-bezier(.2,.9,.25,1.1),visibility 0s linear .25s}
      .brf-hc__toast.is-on{opacity:1;visibility:visible;transform:none;pointer-events:auto;transition:opacity .25s ease,transform .5s cubic-bezier(.2,1.3,.3,1)}
      .brf-hc__toast img,.brf-hc__toast .brf-hc__ph{flex:0 0 46px;width:46px;height:46px;border-radius:12px;object-fit:cover;background:#ECE6DC}
      .brf-hc__toast-tx{flex:1 1 auto;min-width:0}
      .brf-hc__toast-h{display:flex;align-items:center;gap:6px;font-size:13.5px;font-weight:700}
      .brf-hc__toast-h i{display:grid;place-items:center;width:18px;height:18px;border-radius:50%;background:#149954;color:#fff;font-style:normal;font-size:11px}
      .brf-hc__toast-t{display:block;margin-top:2px;font-size:12.5px;color:#6E6E73;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .brf-hc__toast-go{flex:0 0 auto;font-size:12.5px;font-weight:600;color:#149954}
      .brf-hc__bag-li{position:relative}
      .brf-hc__bag-im{flex:0 0 auto;display:block;line-height:0}
      a.brf-hc__bag-t{color:inherit;text-decoration:none}
      a.brf-hc__bag-t:hover{text-decoration:underline}
      .brf-hc__bag-ctl{display:flex;align-items:center;gap:8px;margin-top:6px}
      .brf-hc__bag-q{display:inline-flex;align-items:center;height:28px;border-radius:980px;background:#fff;box-shadow:inset 0 0 0 1px #DDD5C8}
      .brf-hc__bag-q button{width:28px;height:28px;padding:0;border:0;background:transparent;border-radius:980px;color:#1D1D1F;font:600 15px/1 var(--text-font-family,sans-serif);cursor:pointer;transition:background .15s}
      .brf-hc__bag-q button:hover{background:rgba(29,29,31,.07)}
      .brf-hc__bag-q button:disabled{color:#C9C2B7;cursor:default;background:transparent}
      .brf-hc__bag-q span{min-width:24px;text-align:center;font-size:13px;font-weight:600}
      .brf-hc__bag-rm{display:inline-grid;place-items:center;width:28px;height:28px;padding:0;border:0;border-radius:50%;background:transparent;color:#8C867D;cursor:pointer;transition:background .15s,color .15s}
      .brf-hc__bag-rm:hover{background:rgba(224,38,43,.09);color:#C4161C}
      .brf-hc__bag-rm svg{width:15px;height:15px}
      .brf-hc__bag-li.is-busy{opacity:.5;pointer-events:none;transition:opacity .2s}
      .brf-hc__bag-li.is-gone{opacity:0;transform:translateX(16px);transition:opacity .25s ease,transform .3s ease}
      .brf-hc__bag-msg{margin:6px 20px 0;padding:8px 12px;border-radius:12px;background:#FFF4E5;color:#7A4B00;font-size:12.5px}
      .brf-hc__bag-msg:empty{display:none}
  }
</style>
{%- capture brf_hc_bag_icon -%}{%- render 'brf-bag-icon', cls: 'brf-hc__bag-ic' -%}{%- endcapture -%}
<script>
(function(){
