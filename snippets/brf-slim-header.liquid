      '<div class="brf-hc__bag-sub"><span>Subtotal</span><b>' + esc(fmt(c.total_price)) + '</b></div>' +
      '<div class="brf-hc__bag-btns"><a class="brf-hc__bag-view" href="{{ routes.cart_url }}">View bag</a><a class="brf-hc__bag-go" href="/checkout">Checkout</a></div>';
    var nl = bag.querySelector('.brf-hc__bag-list'); if (nl && st) nl.scrollTop = st;
  }
  /* change a line's quantity (0 removes it) right from the peek */
  var busy = false;
