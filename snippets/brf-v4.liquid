{%- comment -%}
  Bull Ring Fabrics — v4 polish (October 2026)
  1  Product cards: quantity box + "Add to bag" (compact after the first add); quick view is a frosted eye on the photo
  2  Quick view: liquid glass, rounded image, soft close, closes on any outside click, no tax/shipping line, readable old price
  3  Breadcrumbs as liquid-glass pills everywhere
  4  Product page: no thumbnail strip when there is only one photo, no hover zoom
  5  Home & Lifestyle descriptions read as plain text (sub-headings as bold lines)
  6  Delivery options card: always opens below the link on desktop, bottom sheet on phones and tablets
  7  Header bag icon sizing
  8  Search: click anywhere to close the main header search; an empty search shows a joke instead
{%- endcomment -%}
<style>
  /* ---------- 1. Product cards: quantity box + Add to bag, quick view eye on the photo ---------- */
  .product-item .brf-qa-form{flex-direction:row;flex-wrap:nowrap;align-items:center;gap:8px}
  html .product-item .brf-qa-form>.product-item__action-button{flex:1 1 auto;margin:0!important;min-width:0}
  .brf-qa__qty{display:flex;align-items:center;flex:0 0 104px;min-width:0;height:40px;border-radius:980px;background:#fff;box-shadow:inset 0 0 0 1px #DDD5C8;transition:box-shadow .2s}
  .brf-qa__qty:focus-within{box-shadow:inset 0 0 0 1.5px #1D1D1F}
  .brf-qa__step{flex:0 0 32px;height:100%;padding:0;border:0;background:transparent;color:#1D1D1F;font:600 18px/1 var(--text-font-family,sans-serif);cursor:pointer;border-radius:980px;transition:background .15s,color .15s}
  .brf-qa__step:hover{background:rgba(29,29,31,.06)}
  .brf-qa__step:disabled{color:#C9C2B7;cursor:default;background:transparent}
  .brf-qa__in{flex:1 1 auto;min-width:0;width:100%;height:100%;padding:0;border:0;background:transparent;text-align:center;font:600 15px/1 var(--text-font-family,sans-serif);color:#1D1D1F;-moz-appearance:textfield;appearance:textfield}
  .brf-qa__in::-webkit-inner-spin-button,.brf-qa__in::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
  .brf-qa__in:focus{outline:0}
  .brf-qa__qty.is-max{animation:brf-qa-nudge .4s ease}
  @keyframes brf-qa-nudge{25%{transform:translateX(-3px)}75%{transform:translateX(3px)}}
  html .product-item .brf-qa__add{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:40px;line-height:1;padding:0 14px;white-space:nowrap;overflow:hidden;
    transition:background .25s,color .25s,transform .2s,max-width .45s cubic-bezier(.2,.9,.25,1.05),padding .3s}
  .brf-qa__add svg{flex:0 0 auto;width:16px;height:16px}
  /* after an add: a quick "Added" tick, then the button settles as a compact "Add" next to the box */
  html .product-item .brf-qa__add.is-done{background:#1D1D1F!important;border-color:#1D1D1F!important;color:#fff!important}
  html .product-item .brf-qa-form.is-compact .brf-qa__qty{flex:1 1 auto}
  html .product-item .brf-qa-form.is-compact .brf-qa__add{flex:0 0 auto;padding:0 14px}
  .brf-qa__add.is-pop{animation:brf-qa-pop .45s cubic-bezier(.2,1.4,.3,1)}
  @keyframes brf-qa-pop{40%{transform:scale(1.06)}}
  @media (max-width:640px){
    .product-item .brf-qa-form{flex-wrap:wrap;gap:6px}
    .brf-qa__qty,html .product-item .brf-qa-form.is-compact .brf-qa__qty{flex:1 1 100%;height:36px}
    html .product-item .brf-qa-form>.product-item__action-button,html .product-item .brf-qa-form.is-compact .brf-qa__add{flex:1 1 100%;height:38px}
  }
  /* quick view: a frosted eye on the photo, shown on hover */
  .brf-pi-media{position:relative}
  .brf-qv-eye{position:absolute;top:12px;right:12px;z-index:3;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;cursor:pointer;color:#1D1D1F;
    background:rgba(255,255,255,.55);-webkit-backdrop-filter:saturate(180%) blur(16px);backdrop-filter:saturate(180%) blur(16px);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 0 0 .5px rgba(29,29,31,.1),0 10px 24px -10px rgba(29,29,31,.45);
    opacity:0;transform:scale(.8);transition:opacity .25s ease,transform .35s cubic-bezier(.2,1.3,.3,1),background .2s}
  .brf-qv-eye svg{width:21px;height:21px}
  .brf-qv-eye:hover{background:rgba(255,255,255,.82);transform:scale(1.08)!important}
  .product-item:hover .brf-qv-eye,.brf-qv-eye:focus-visible{opacity:1;transform:none}
  @media (hover:none),(max-width:999px){.brf-qv-eye{display:none}}
  @supports not ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))){.brf-qv-eye{background:rgba(255,255,255,.92)}}

  /* ---------- 2. Quick view ---------- */
  html .modal[id^="modal-quick-view"]{background:rgba(29,29,31,.16)!important;-webkit-backdrop-filter:blur(6px) saturate(120%);backdrop-filter:blur(6px) saturate(120%);
    transition:opacity .55s cubic-bezier(.4,0,.2,1) .05s,visibility 0s linear .6s}
  /* the theme only treats the window as open once "visibility" has finished its transition, so it must always run */
  html .modal[id^="modal-quick-view"][aria-hidden="false"]{transition:opacity .3s ease,visibility .3s linear}
  html .modal[id^="modal-quick-view"] .modal__dialog,html.brf-hw-page .modal[id^="modal-quick-view"] .modal__dialog{
    background:linear-gradient(140deg,rgba(255,255,255,.66) 0%,rgba(255,255,255,.46) 55%,rgba(255,255,255,.58) 100%)!important;
    -webkit-backdrop-filter:saturate(190%) blur(34px)!important;backdrop-filter:saturate(190%) blur(34px)!important;
    border:1px solid rgba(255,255,255,.75)!important;border-radius:30px!important;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -1px 0 rgba(255,255,255,.35),0 0 0 .5px rgba(29,29,31,.06),0 40px 100px -30px rgba(29,29,31,.5)!important;
    /* closing: the glass softly melts away */
    opacity:0;transform:translateY(26px) scale(.95);filter:blur(10px);
    transition:transform .55s cubic-bezier(.4,0,.6,1),opacity .45s ease,filter .5s ease,visibility .55s linear!important}
  html .modal[id^="modal-quick-view"][aria-hidden="false"] .modal__dialog{opacity:1;transform:none;filter:none;
    transition:transform .6s cubic-bezier(.2,1.15,.3,1),opacity .3s ease,filter .4s ease,visibility 0s linear!important}
  .modal[id^="modal-quick-view"] .modal__close{background:rgba(255,255,255,.7);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
  /* rounded main photo */
  html .modal[id^="modal-quick-view"] .product-gallery__carousel-wrapper,
  html .modal[id^="modal-quick-view"] .product-gallery__carousel,
  html .modal[id^="modal-quick-view"] .product-gallery__carousel .flickity-viewport{border-radius:24px!important;overflow:hidden!important;-webkit-mask-image:-webkit-radial-gradient(#fff,#000);isolation:isolate}
  html .modal[id^="modal-quick-view"] .product-gallery__image,
  html .modal[id^="modal-quick-view"] .product-gallery__carousel-item{border-radius:24px}
  html .modal[id^="modal-quick-view"] .quantity-selector,html .modal[id^="modal-quick-view"] select{background:rgba(255,255,255,.75)}
  /* no "Tax included, shipping calculated" line, and an easy-to-read old price */
  html .modal[id^="modal-quick-view"] p.product-form__price-info,html .modal[id^="modal-quick-view"] .brf-ship{display:none!important}
  html .modal[id^="modal-quick-view"] .price--compare{color:#fff!important;opacity:1!important;font-weight:600;text-decoration:none!important;
    text-shadow:0 1px 2px rgba(29,29,31,.6),0 0 12px rgba(29,29,31,.3)}
  html .modal[id^="modal-quick-view"] .price--compare::before{display:block!important;height:2px!important;margin-top:-1px;border-radius:2px;background:#E0262B!important;box-shadow:0 1px 2px rgba(29,29,31,.35)}
  @media (prefers-reduced-motion:reduce){
    html .modal[id^="modal-quick-view"] .modal__dialog{filter:none;transition:opacity .2s ease!important}
  }

  /* ---------- 3. Breadcrumbs as liquid glass ---------- */
  html body .breadcrumb,.brf-chead__crumbs,.dl-crumbs,.sl-crumbs{
    display:inline-flex!important;align-items:center;flex-wrap:wrap;gap:2px 8px;width:auto;max-width:100%;padding:7px 16px!important;border-radius:980px!important;
    background:linear-gradient(135deg,rgba(255,255,255,.62) 0%,rgba(255,255,255,.34) 50%,rgba(255,255,255,.5) 100%)!important;
    -webkit-backdrop-filter:blur(28px) saturate(200%) brightness(1.06)!important;backdrop-filter:blur(28px) saturate(200%) brightness(1.06)!important;
    border:1px solid rgba(255,255,255,.8)!important;
    box-shadow:inset 0 1px 1px rgba(255,255,255,.95),inset 0 -1px 1px rgba(255,255,255,.35),inset 0 0 18px rgba(255,255,255,.35),0 0 0 .5px rgba(29,29,31,.07),0 10px 28px -12px rgba(29,29,31,.3)!important;
    text-shadow:0 1px 0 rgba(255,255,255,.7);
    font-size:12.5px!important;line-height:1.3}
  html body .breadcrumb__list{display:flex;flex-wrap:wrap;align-items:center;gap:2px 0}
  html body .breadcrumb__link,.brf-chead__crumbs a,.dl-crumbs a,.sl-crumbs a{color:#515154!important;text-decoration:none!important;transition:color .2s}
  html body .breadcrumb a.breadcrumb__link:hover,.brf-chead__crumbs a:hover,.dl-crumbs a:hover,.sl-crumbs a:hover{color:#1D1D1F!important}
  html body .breadcrumb__link[aria-current],.brf-chead__crumbs [aria-current],.dl-crumbs [aria-current],.sl-crumbs [aria-current]{color:#1D1D1F!important;font-weight:600}
  html body .breadcrumb .icon{color:#A19A90}
  .dl-hero--photo .dl-crumbs{background:linear-gradient(135deg,rgba(255,255,255,.26),rgba(255,255,255,.1))!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 0 0 .5px rgba(255,255,255,.25),0 8px 20px -12px rgba(0,0,0,.5)!important}
  .dl-hero--photo .dl-crumbs a,.dl-hero--photo .dl-crumbs [aria-current]{color:#fff!important}
  html.brf-hw-page body .breadcrumb,html.brf-hw-page .brf-chead__crumbs{background:linear-gradient(135deg,rgba(40,32,48,.7),rgba(28,22,34,.5))!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 0 0 .5px rgba(240,138,36,.25)!important}
  html.brf-hw-page body .breadcrumb__link,html.brf-hw-page .brf-chead__crumbs a,html.brf-hw-page .brf-chead__crumbs [aria-current]{color:#EDE6DA!important}
  @supports not ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))){
    html body .breadcrumb,.brf-chead__crumbs,.dl-crumbs,.sl-crumbs{background:rgba(255,255,255,.92)!important}
  }

  /* ---------- 4. Product photos ---------- */
  html .product-gallery--single>.scroller,html .product-gallery--single .product-gallery__thumbnail-list{display:none!important}
  .drift-zoom-pane,.drift-bounding-box,.product__zoom-wrapper{display:none!important}
  @media (hover:hover) and (pointer:fine){
    .product-gallery__carousel--zoomable .product-gallery__image,.product-gallery__carousel--zoomable{cursor:default!important}
  }

  /* ---------- 5. Home & Lifestyle descriptions ---------- */
  .rte .brf-desc-h{margin:1.2em 0 .35em!important;font-weight:700;font-size:1.02em;color:#1D1D1F}
  .rte .brf-desc-h+ul{margin-top:0}

  /* ---------- 6. Delivery card on desktop: always opens below the link, never over the product title ---------- */
  @media (min-width:1000px){
    .brf-ship__card{margin-left:var(--brf-ship-dx,0px)}
    .brf-ship__card::after{margin-left:calc(-1 * var(--brf-ship-dx,0px))}
    html .brf-ship .brf-ship__card{top:calc(100% + 12px)!important;bottom:auto!important;transform:translate(-50%,-6px)}
    html .brf-ship.is-open .brf-ship__card{transform:translate(-50%,0)}
    html .brf-ship .brf-ship__card::after{top:-6px!important;bottom:auto!important;box-shadow:-1px -1px 0 rgba(29,29,31,.06)}
  }

  /* ---------- 7. Bag icon in the header ---------- */
  html .header .icon--cart{width:28px;height:28px;margin-top:-3px}

  /* ---------- 8. Empty search: a friendly giggle instead of an empty results page ---------- */
  .brf-nothing{position:fixed;z-index:2147483000;left:50%;top:0;max-width:min(560px,calc(100vw - 32px));margin:0;padding:11px 18px;border-radius:980px;pointer-events:none;
    background:rgba(255,255,255,.94);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);
    box-shadow:0 0 0 .5px rgba(29,29,31,.08),0 18px 40px -16px rgba(29,29,31,.45);
    font:500 14.5px/1.35 var(--text-font-family,Inter,sans-serif);color:#1D1D1F;text-align:center;
    opacity:0;visibility:hidden;transform:translate(-50%,-8px) scale(.96);transition:opacity .25s ease,transform .3s ease,visibility 0s linear .25s}
  .brf-nothing.is-on{opacity:1;visibility:visible;transform:translate(-50%,0);transition:opacity .25s ease,transform .5s cubic-bezier(.2,1.4,.3,1)}
  .brf-shake{animation:brf-shake .45s cubic-bezier(.36,.07,.19,.97)}
  @keyframes brf-shake{15%,85%{transform:translateX(-2px)}30%,70%{transform:translateX(4px)}45%{transform:translateX(-6px)}60%{transform:translateX(6px)}}
  @media (prefers-reduced-motion:reduce){.brf-shake{animation:none}}
</style>

<script>
(function(){
  var doc = document, root = doc.documentElement;
  if (root.__brfV4) return; root.__brfV4 = true;
  var desk = window.matchMedia('(min-width:1000px)');

  /* ---------- 1. Product cards: quantity box + Add to bag ---------- */
  function clampQty(input, v){
    var max = parseInt(input.getAttribute('max'), 10); if (isNaN(max) || max < 1) max = 9999;
    v = parseInt(v, 10); if (isNaN(v) || v < 1) v = 1;
    var hit = v > max; v = Math.min(v, max);
    input.value = v;
    var box = input.closest('.brf-qa__qty');
    if (box) {
      var minus = box.querySelector('[data-d="-1"]'), plus = box.querySelector('[data-d="1"]');
      if (minus) minus.disabled = v <= 1;
      if (plus) plus.disabled = v >= max;
      if (hit) { box.classList.remove('is-max'); void box.offsetWidth; box.classList.add('is-max'); }
    }
    return v;
  }
  doc.addEventListener('click', function(e){
    var st = e.target.closest && e.target.closest('.brf-qa__step'); if (!st) return;
    e.preventDefault();
    var input = st.parentNode.querySelector('.brf-qa__in'); if (!input) return;
    clampQty(input, (parseInt(input.value, 10) || 1) + parseInt(st.getAttribute('data-d'), 10));
  });
  doc.addEventListener('change', function(e){ if (e.target.classList && e.target.classList.contains('brf-qa__in')) clampQty(e.target, e.target.value); });
  doc.addEventListener('keydown', function(e){
    if (e.key !== 'Enter' || !e.target.classList || !e.target.classList.contains('brf-qa__in')) return;
    e.preventDefault(); clampQty(e.target, e.target.value);
    var add = e.target.closest('form').querySelector('.brf-qa__add'); if (add) add.click();
  });
  /* make sure a half-typed number is tidied before the theme reads the form */
  doc.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('.brf-qa__add'); if (!b) return;
    var input = b.form && b.form.querySelector('.brf-qa__in'); if (input) clampQty(input, input.value);
    pending = b;
  }, true);
  var pending = null;
  function added(btn){
    var form = btn.closest('form'), lbl = btn.querySelector('.brf-qa__lbl');
    if (!lbl) return;
    clearTimeout(btn.__brfT);
    btn.classList.add('is-done', 'is-pop'); lbl.textContent = 'Added!';
    btn.__brfT = setTimeout(function(){
      btn.classList.remove('is-done', 'is-pop');
      lbl.textContent = 'Add';
      if (form) form.classList.add('is-compact');
      btn.setAttribute('aria-label', 'Add more to bag');
      var input = form && form.querySelector('.brf-qa__in'); if (input) clampQty(input, 1);
    }, 1400);
  }

  /* ---------- 2. Quick view: adds show the "In the bag!" note on top, the window closes properly ---------- */
  var QV = '.modal[id^="modal-quick-view"]';
  /* the slim header (brf-slim-header) swaps the drawer for its note; here we just make sure the window closes */
  doc.body.addEventListener('product:added', function(e){
    var t = e.target, qv = t && t.closest && t.closest(QV);
    if (qv) { setTimeout(function(){ closeQv(qv); }, 80); return; }
    var b = pending; pending = null;
    if (b && b.isConnected && t && t.contains && t.contains(b)) added(b);
  });
  function closeQv(m){
    m = m || doc.querySelector(QV + '[aria-hidden="false"]'); if (!m || m.getAttribute('aria-hidden') !== 'false') return;
    doc.dispatchEvent(new CustomEvent('modal:close'));
    /* belt and braces: if the theme lost track of the window, close it ourselves */
    setTimeout(function(){
      if (m.getAttribute('aria-hidden') === 'false') {
        m.setAttribute('aria-hidden', 'true');
        m.dispatchEvent(new CustomEvent('modal:closed'));
      }
      if (!doc.querySelector('.modal[aria-hidden="false"]')) root.classList.remove('is-locked');
    }, 120);
  }
  /* click anywhere outside the quick view box to close it */
  doc.addEventListener('click', function(e){
    var m = doc.querySelector(QV + '[aria-hidden="false"]'); if (!m) return;
    var t = e.target, dlg = m.querySelector('.modal__dialog');
    if ((dlg && dlg.contains(t)) || !t.closest || t.closest('.brf-hc__toast, .brf-hc__bag, [data-action="open-modal"]')) return;
    e.preventDefault(); e.stopPropagation();
    closeQv(m);
  }, true);

  /* ---------- 6. Delivery card: below the link on desktop, nudged into view if needed ---------- */
  function placeShip(w, scroll){
    if (!desk.matches) return;
    var link = w.querySelector('a'), card = w.querySelector('.brf-ship__card'); if (!link || !card) return;
    var r = link.getBoundingClientRect(), h = card.offsetHeight || 300, wd = card.offsetWidth || 320;
    var cx = r.left + r.width / 2, left = cx - wd / 2, dx = 0;
    if (left < 12) dx = 12 - left; else if (left + wd > window.innerWidth - 12) dx = window.innerWidth - 12 - (left + wd);
    card.style.setProperty('--brf-ship-dx', Math.round(dx) + 'px');
    var deficit = r.bottom + 12 + h + 16 - window.innerHeight;
    if (scroll && deficit > 0) window.scrollBy({top: deficit, behavior: window.matchMedia('(prefers-reduced-motion:reduce)').matches ? 'auto' : 'smooth'});
  }
  function initShip(){
    var w = doc.querySelector('.brf-ship'); if (!w || w.__brfV4) return; w.__brfV4 = true;
    var was = false;
    new MutationObserver(function(){
      var on = w.classList.contains('is-open');
      if (on && !was) placeShip(w, true);
      was = on;
    }).observe(w, {attributes: true, attributeFilter: ['class']});
    w.addEventListener('mouseenter', function(){ placeShip(w, false); });
  }
  initShip();
  window.addEventListener('load', initShip);
  setTimeout(initShip, 1500);

  /* ---------- 8. Main header search: click anywhere to close; an empty search gets a giggle instead ---------- */
  doc.addEventListener('pointerdown', function(e){
    if (!root.classList.contains('brf-so-open') || !window.brfSearchClose) return;
    var t = e.target;
    if (!t.closest || t.closest('#brf-sp, #shopify-section-header form.search-bar, [data-action="toggle-search"], .brf-hc__search')) return;
    window.brfSearchClose();
  }, true);
  var NOTHING = [
    'You came, you saw, you… forgot to type. Happens to the best of us 😄',
    'Our search bar is clever, but it can’t read minds. Yet. 🔮',
    'Searching for nothing? We’ve got loads of that, and it’s free! 😄',
    'Even our bull needs a clue. Pop a word in! 🐂',
    'We searched high and low for “ ” and found… fresh air. Try a fabric! 🌬️',
    'Blank search, blank canvas. Type a fabric and let’s fill it 🎨',
    'Needle threaded, scissors sharpened… we just need a word ✂️',
    'Psst… the magic only works when you type something ✨',
    'Bold move, searching for nothing. Bolder move: type “velvet” 😉',
    'You searched for absolutely nothing. Very zen. Very calm. Very unhelpful 🧘',
    'Nothing in, nothing out. Even a quilt starts with one square 🧵',
    'Our bull pressed the button too. Nothing happened for him either 🐂'
  ];
  var nAt = -1;
  window.brfNothingQuip = function(){
    var i = Math.floor(Math.random() * NOTHING.length);
    if (i === nAt) i = (i + 1) % NOTHING.length;
    nAt = i; return NOTHING[i];
  };
  var mform = doc.querySelector('#shopify-section-header form.search-bar');
  var minput = mform && mform.querySelector('.search-bar__input');
  if (mform && minput) {
    var note = doc.createElement('p'); note.className = 'brf-nothing'; note.setAttribute('role', 'status'); note.setAttribute('aria-live', 'polite');
    doc.body.appendChild(note);
    var nT = 0;
    var showNote = function(){
      var r = mform.getBoundingClientRect();
      note.textContent = window.brfNothingQuip();
      note.style.top = Math.round(r.bottom + 12) + 'px';
      note.style.left = Math.round(r.left + r.width / 2) + 'px';
      note.classList.remove('is-on'); void note.offsetWidth; note.classList.add('is-on');
      mform.classList.remove('brf-shake'); void mform.offsetWidth; mform.classList.add('brf-shake');
      clearTimeout(nT); nT = setTimeout(function(){ note.classList.remove('is-on'); }, 3800);
      try { minput.focus({preventScroll: true}); } catch (err) {}
    };
    mform.addEventListener('submit', function(e){
      if (minput.value.trim()) { note.classList.remove('is-on'); return; }
      e.preventDefault(); e.stopImmediatePropagation(); showNote();
    }, true);
    minput.addEventListener('input', function(){ if (minput.value.trim()) note.classList.remove('is-on'); });
    window.addEventListener('scroll', function(){ note.classList.remove('is-on'); }, {passive: true});
  }
})();
</script>
