{%- comment -%}
  Homepage "star buy" banner: one product in a banner of its own, under the hero slider.
  Params: p (product), eyebrow, heading, text, btn. Hidden when the product is missing or sold out.
{%- endcomment -%}
{%- if p != blank and p.available -%}
{%- assign v = p.selected_or_first_available_variant -%}
<style>
  .brf-spot{position:relative;margin:28px 0 8px;border-radius:14px;overflow:hidden;background:linear-gradient(120deg,#FBF4E6 0%,#F3E2C2 100%);border:1px solid #E7D3AE;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);align-items:center}
  .brf-spot::before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(138,90,28,.10) 1.4px,transparent 1.6px);background-size:18px 18px;pointer-events:none}
  .brf-spot__body{position:relative;padding:44px 48px}
  .brf-spot__tag{display:inline-flex;align-items:center;gap:8px;margin:0 0 14px;padding:6px 12px;border-radius:999px;background:#8A5A1C;color:#fff;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .brf-spot__h{margin:0 0 6px;font-family:Fraunces,Georgia,serif;font-weight:500;font-size:46px;line-height:1.05;letter-spacing:-.015em;color:var(--brf-ink)}
  .brf-spot__name{margin:0 0 14px;font-size:15px;font-weight:600;color:var(--brf-muted)}
  .brf-spot__text{margin:0 0 22px;font-size:17px;line-height:1.6;color:var(--brf-muted);max-width:480px}
  .brf-spot__buy{display:flex;flex-wrap:wrap;align-items:center;gap:14px 18px}
  .brf-spot__price{font-family:Fraunces,Georgia,serif;font-size:38px;font-weight:600;line-height:1;color:var(--brf-sale)}
  .brf-spot__price s{margin-left:8px;font-family:Figtree,system-ui,sans-serif;font-size:17px;font-weight:500;color:var(--brf-muted)}
  .brf-spot__form{margin:0}
  .brf-spot__ship{display:flex;align-items:center;gap:8px;margin:18px 0 0;font-size:14px;font-weight:600;color:var(--brf-accent)}
  .brf-spot__media{position:relative;z-index:1;align-self:stretch;min-height:380px;display:block;background:#fff}
  .brf-home .brf-spot__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:22px}
  .brf-spot__burst{position:absolute;top:18px;right:18px;z-index:1;width:96px;height:96px;display:grid;place-items:center;text-align:center;border-radius:50%;background:var(--brf-sale);color:#fff;font-weight:800;font-size:13px;line-height:1.1;letter-spacing:.04em;text-transform:uppercase;transform:rotate(10deg);box-shadow:0 0 0 5px rgba(163,55,43,.18)}
  .brf-spot__burst b{display:block;font-family:Fraunces,Georgia,serif;font-size:24px;letter-spacing:0}
  @media (max-width:1023px){.brf-spot__body{padding:36px 32px}.brf-spot__h{font-size:38px}}
  @media (max-width:640px){
    .brf-spot{grid-template-columns:minmax(0,1fr);margin:18px 0 4px}
    .brf-spot__media{order:-1;min-height:210px}
    .brf-home .brf-spot__media img{padding:12px}
    .brf-spot__burst{top:10px;right:10px;width:72px;height:72px;font-size:10.5px}
    .brf-spot__burst b{font-size:18px}
    .brf-spot__body{padding:22px 18px 24px}
    .brf-spot__tag{font-size:10.5px;margin-bottom:10px}
    .brf-spot__h{font-size:30px}
    .brf-spot__name{font-size:13.5px;margin-bottom:10px}
    .brf-spot__text{font-size:15px;margin-bottom:16px}
    .brf-spot__price{font-size:32px}
    .brf-spot__price{flex:1 0 100%}
    .brf-spot__form,.brf-spot__buy>.brf-btn{flex:1 1 130px}
    .brf-spot__form .brf-btn{width:100%}
    .brf-spot__buy .brf-btn{min-height:48px;padding:0 14px;font-size:15px;white-space:nowrap}
  }
</style>
<section class="brf-spot" aria-labelledby="brf-spot-h">
  <a class="brf-spot__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
    <span class="brf-spot__burst"><span>Only<b>{{ v.price | money_without_trailing_zeros }}</b></span></span>
    {%- if p.featured_image -%}<img src="{{ p.featured_image | img_url: '900x' }}" alt="" loading="lazy">{%- endif -%}
  </a>
  <div class="brf-spot__body">
    <p class="brf-spot__tag">&#9733; {{ eyebrow | default: 'Star buy' }}</p>
    <h2 class="brf-spot__h" id="brf-spot-h">{{ heading | default: p.title }}</h2>
    {%- if heading != blank -%}<p class="brf-spot__name">{{ p.title }}</p>{%- endif -%}
    {%- if text != blank -%}<p class="brf-spot__text">{{ text }}</p>{%- endif -%}
    <div class="brf-spot__buy">
      <span class="brf-spot__price">{{ v.price | money }}{%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}</span>
      <form class="brf-spot__form" method="post" action="{{ routes.cart_add_url }}">
        <input type="hidden" name="id" value="{{ v.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="brf-btn brf-btn--solid">Add to bag</button>
      </form>
      <a class="brf-btn brf-btn--line" href="{{ p.url }}">{{ btn | default: 'Take a look' }}</a>
    </div>
    {%- if p.tags contains 'in-stock' -%}
    <p class="brf-spot__ship"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>In stock, sent out same day (order by 10pm, Mon to Fri)</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
