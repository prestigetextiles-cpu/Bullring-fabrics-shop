{%- comment -%}
  Halloween animation layer – flying bats, floating ghosts, a dangling spider, twinkling stars and rolling fog.
  Pure SVG + CSS (no GIF downloads), GPU-friendly transforms only, fewer creatures on phones,
  and everything stops for visitors who prefer reduced motion.
  Usage: place inside any position:relative dark section:  {% render 'brf-spooky-layer' %}
{%- endcomment -%}
<div class="brf-boo" aria-hidden="true">
  <span class="brf-boo__star" style="left:12%;top:18%"></span>
  <span class="brf-boo__star" style="left:34%;top:9%;animation-delay:-1.2s"></span>
  <span class="brf-boo__star" style="left:58%;top:22%;animation-delay:-2.1s"></span>
  <span class="brf-boo__star" style="left:81%;top:12%;animation-delay:-.6s"></span>
  <span class="brf-boo__star brf-boo--desk" style="left:92%;top:30%;animation-delay:-1.7s"></span>

  {%- capture bat -%}<svg viewBox="0 0 64 32"><g class="brf-boo__wing brf-boo__wing--l"><path d="M32 16C26 8 16 5 2 8c6 2 9 6 9 10 4-3 8-3 11 1 2-4 6-5 10-3z"/></g><g class="brf-boo__wing brf-boo__wing--r"><path d="M32 16c6-8 16-11 30-8-6 2-9 6-9 10-4-3-8-3-11 1-2-4-6-5-10-3z"/></g><ellipse cx="32" cy="17" rx="4" ry="6"/><path d="M29 12l1-4 2 3 2-3 1 4z"/><circle cx="30.6" cy="14.5" r=".9" fill="#F5A04A"/><circle cx="33.4" cy="14.5" r=".9" fill="#F5A04A"/></svg>{%- endcapture -%}
  <div class="brf-boo__bat" style="--y:14%;--d:14s;--delay:-2s;--s:1">{{ bat }}</div>
  <div class="brf-boo__bat" style="--y:34%;--d:19s;--delay:-9s;--s:.7">{{ bat }}</div>
  <div class="brf-boo__bat brf-boo--desk" style="--y:8%;--d:24s;--delay:-15s;--s:.55">{{ bat }}</div>

  {%- capture ghost -%}<svg viewBox="0 0 60 72"><path d="M30 3C15 3 6 15 6 30v36l7-6 7 6 7-6 6 6 7-6 7 6 7-6V30C54 15 45 3 30 3z" fill="#F4EFF8"/><ellipse cx="22" cy="28" rx="4" ry="5.5" fill="#241B2E"/><ellipse cx="38" cy="28" rx="4" ry="5.5" fill="#241B2E"/><ellipse cx="30" cy="42" rx="5" ry="6" fill="#241B2E"/></svg>{%- endcapture -%}
  <div class="brf-boo__ghost" style="right:6%;bottom:18%">{{ ghost }}</div>
  <div class="brf-boo__ghost brf-boo--desk" style="left:3%;bottom:30%;--gd:7.5s;--gs:.7;animation-delay:-3s">{{ ghost }}</div>

  <div class="brf-boo__spider" style="left:78%">
    <span class="brf-boo__thread"></span>
    <svg viewBox="0 0 40 40"><g stroke="#EDE6DA" stroke-width="1.6" fill="none" stroke-linecap="round"><path d="M14 18L4 12M14 21L3 21M14 24L4 30M15 27l-6 9M26 18l10-6M26 21h11M26 24l10 6M25 27l6 9"/></g><ellipse cx="20" cy="22" rx="7" ry="8" fill="#0B090E" stroke="#EDE6DA" stroke-width="1"/><circle cx="20" cy="13" r="4.5" fill="#0B090E" stroke="#EDE6DA" stroke-width="1"/><circle cx="18.4" cy="12.4" r="1" fill="#F08A24"/><circle cx="21.6" cy="12.4" r="1" fill="#F08A24"/></svg>
  </div>

  <span class="brf-boo__fog"></span>
  <span class="brf-boo__fog brf-boo__fog--2"></span>
</div>
<style>
  .brf-boo{position:absolute;top:0;right:0;bottom:0;left:0;overflow:hidden;pointer-events:none;z-index:0;contain:strict}
  .brf-boo ~ .brf-wrap,.brf-boo ~ .brf-hw__wrap{position:relative;z-index:1}
  .brf-boo__star{position:absolute;width:3px;height:3px;border-radius:50%;background:#FFF6DA;box-shadow:0 0 6px 1px rgba(255,236,190,.7);animation:brfBooTwinkle 3.2s ease-in-out infinite}
  @keyframes brfBooTwinkle{0%,100%{opacity:.15;transform:scale(.6)}50%{opacity:1;transform:scale(1.2)}}

  .brf-boo__bat{position:absolute;left:0;top:var(--y);width:64px;height:32px;fill:#0B090E;filter:drop-shadow(0 0 6px rgba(240,138,36,.35));
    animation:brfBooFly var(--d) linear var(--delay) infinite;will-change:transform}
  .brf-boo__bat svg{display:block;width:100%;height:100%;overflow:visible;transform:scale(var(--s));animation:brfBooBob 1.6s ease-in-out infinite}
  .brf-boo__wing{transform-box:fill-box;animation:brfBooFlap .32s ease-in-out infinite alternate}
  .brf-boo__wing--l{transform-origin:100% 50%}
  .brf-boo__wing--r{transform-origin:0 50%}
  @keyframes brfBooFly{0%{transform:translateX(-90px)}100%{transform:translateX(calc(100vw + 90px))}}
  @keyframes brfBooBob{0%,100%{transform:translateY(0) scale(var(--s))}50%{transform:translateY(-14px) scale(var(--s))}}
  @keyframes brfBooFlap{from{transform:scaleY(1)}to{transform:scaleY(.25)}}

  .brf-boo__ghost{position:absolute;width:54px;opacity:.85;filter:drop-shadow(0 0 14px rgba(244,239,248,.45));
    transform:scale(var(--gs,1));animation:brfBooFloat var(--gd,6s) ease-in-out infinite}
  .brf-boo__ghost svg{display:block;width:100%}
  @keyframes brfBooFloat{0%,100%{transform:translate(0,0) rotate(-4deg) scale(var(--gs,1));opacity:.35}50%{transform:translate(-10px,-22px) rotate(4deg) scale(var(--gs,1));opacity:.9}}

  .brf-boo__spider{position:absolute;top:0;width:34px;display:flex;flex-direction:column;align-items:center;animation:brfBooDrop 7s ease-in-out infinite}
  .brf-boo__thread{width:1px;height:90px;background:linear-gradient(rgba(237,230,218,.1),rgba(237,230,218,.6))}
  .brf-boo__spider svg{width:34px;animation:brfBooSway 2.6s ease-in-out infinite;transform-origin:50% 0}
  @keyframes brfBooDrop{0%,100%{transform:translateY(-70px)}45%,60%{transform:translateY(10px)}}
  @keyframes brfBooSway{0%,100%{transform:rotate(-8deg)}50%{transform:rotate(8deg)}}

  .brf-boo__fog{position:absolute;left:-50%;bottom:-30px;width:200%;height:120px;opacity:.45;
    background:radial-gradient(40% 60% at 25% 60%,rgba(201,192,211,.35),transparent 70%),radial-gradient(35% 55% at 70% 50%,rgba(201,192,211,.28),transparent 70%);
    filter:blur(8px);animation:brfBooFog 26s linear infinite}
  .brf-boo__fog--2{bottom:-50px;opacity:.3;animation-duration:38s;animation-direction:reverse}
  @keyframes brfBooFog{from{transform:translateX(0)}to{transform:translateX(25%)}}

  @media (max-width:767px){
    .brf-boo--desk{display:none}
    .brf-boo__ghost{width:40px}
    .brf-boo__thread{height:60px}
    .brf-boo__spider{left:auto!important;right:14px}
  }
  @media (prefers-reduced-motion:reduce){
    .brf-boo *{animation:none!important}
    .brf-boo__bat{transform:translateX(70vw)}
  }
</style>
