{%- comment -%}
  Scrolling promo tiles at the top of the homepage (Costco-style).
  Rendered from sections/brf-home.liquid, above the Halloween block. Edit the tile list below
  (one tile per line). A tile hides itself if its collection is missing or empty.
{%- endcomment -%}

{%- comment -%} Tiles: collection handle (or #anchor) | title | badge text | badge colour | icon {%- endcomment -%}
{%- capture promo_defaults -%}
pound-fabrics|Pound Fabrics|From £1 a metre|#8A5A1C|pound
cheap-fabric-under-5|Fabric under £5|Budget buys|#A3372B|tag
home-lifestyle|Home &amp; Lifestyle|New · Shop now|#1F4D3A|home
garden-outdoor|Garden &amp; Outdoor|New in|#3E7B3A|garden
storage-organisation|Storage &amp; Organisation|New in|#1F6F78|storage
cleaning-household|Cleaning &amp; Household|New in|#2F5FA8|cleaning
diy-tools|DIY &amp; Tools|New in|#C0621B|diy
electricals-small-appliances|Homeware &amp; Electricals|New in|#6B3FA0|electricals
#brf-signup|Not a member yet?|Get 10% off|#1F4D3A|club
{%- endcapture -%}
{%- assign promo_rows = promo_defaults | strip | newline_to_br | split: '<br />' -%}

{%- capture promo_tiles -%}
  {%- for promo_row in promo_rows -%}
    {%- assign p_col = nil -%}{%- assign p_url = '' -%}
      {%- assign row = promo_row | strip | split: '|' -%}
      {%- if row[0] contains '#' -%}{%- assign p_url = row[0] -%}{%- else -%}{%- assign p_col = collections[row[0]] -%}{%- endif -%}
      {%- assign p_title = row[1] -%}{%- assign p_badge = row[2] -%}{%- assign p_colour = row[3] -%}{%- assign p_icon = row[4] -%}
    {%- if p_url == blank -%}
      {%- if p_col.handle == blank or p_col.products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign p_url = p_col.url -%}
    {%- endif -%}
    {%- if p_title == blank -%}{%- continue -%}{%- endif -%}
    <li class="brf-ptiles__item">
      <a class="brf-ptiles__tile" href="{{ p_url }}" style="--tile:{{ p_colour }}">
        <span class="brf-ptiles__icon" aria-hidden="true">
          {%- case p_icon -%}
            {%- when 'pound' -%}<svg viewBox="0 0 56 56"><ellipse cx="20" cy="44" rx="14" ry="5" fill="#A57425"/><rect x="6" y="36" width="28" height="8" fill="#A57425"/><ellipse cx="20" cy="36" rx="14" ry="5" fill="#E2B14F"/><rect x="6" y="30" width="28" height="6" fill="#A57425"/><ellipse cx="20" cy="30" rx="14" ry="5" fill="#EFC56A"/><circle cx="36" cy="20" r="15" fill="#E2B14F" stroke="#A57425" stroke-width="3"/><path d="M40.5 13.5c-1-1.6-2.6-2.4-4.4-2.4-3 0-5 2.1-5 5v10.4M28.5 20.5h8.5M28 27.5h13" fill="none" stroke="#7A5314" stroke-width="2.6" stroke-linecap="round"/></svg>
            {%- when 'tag' -%}<svg viewBox="0 0 56 56"><path d="M8 10h19l21 21-17 17L10 27z" fill="#E5574A"/><path d="M8 10h19l21 21-17 17L10 27z" fill="none" stroke="#A3372B" stroke-width="2.5" stroke-linejoin="round"/><circle cx="17" cy="19" r="3.5" fill="#fff"/><text x="30" y="36" text-anchor="middle" transform="rotate(45 30 32)" font-family="Figtree,Arial,sans-serif" font-weight="800" font-size="13" fill="#fff">£5</text></svg>
            {%- when 'home' -%}<svg viewBox="0 0 56 56"><path d="M8 27L28 9l20 18" fill="none" stroke="#1F4D3A" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 24v22h30V24L28 11z" fill="#DCEBDF"/><path d="M13 25v21h30V25" fill="none" stroke="#1F4D3A" stroke-width="3" stroke-linejoin="round"/><path d="M28 41s-8-4.6-8-10a4.2 4.2 0 018-1.8 4.2 4.2 0 018 1.8c0 5.4-8 10-8 10z" fill="#E5574A"/></svg>
            {%- when 'garden' -%}<svg viewBox="0 0 56 56"><path d="M16 34h24l-3 14H19z" fill="#C0621B"/><rect x="14" y="31" width="28" height="5" rx="1.5" fill="#E07B2E"/><path d="M28 31V17" stroke="#3E7B3A" stroke-width="3" stroke-linecap="round"/><path d="M28 21c0-8 6-12 14-12 0 8-6 12-14 12zM28 26c0-6-5-10-12-10 0 6 5 10 12 10z" fill="#5DA34F"/></svg>
            {%- when 'storage' -%}<svg viewBox="0 0 56 56"><rect x="8" y="12" width="40" height="10" rx="2" fill="#1F6F78"/><path d="M11 22h34v24a2 2 0 01-2 2H13a2 2 0 01-2-2z" fill="#6FB7BE"/><rect x="22" y="28" width="12" height="5" rx="2.5" fill="#1F6F78"/></svg>
            {%- when 'cleaning' -%}<svg viewBox="0 0 56 56"><path d="M20 22h14l3 8v16a2 2 0 01-2 2H19a2 2 0 01-2-2V30z" fill="#6FA3E0"/><rect x="21" y="14" width="12" height="8" rx="1.5" fill="#2F5FA8"/><path d="M33 16h7l-3 4h-4" fill="#2F5FA8"/><rect x="21" y="32" width="12" height="9" rx="1.5" fill="#fff"/><circle cx="45" cy="12" r="1.8" fill="#6FA3E0"/><circle cx="48" cy="17" r="1.5" fill="#6FA3E0"/><circle cx="45" cy="21" r="1.2" fill="#6FA3E0"/></svg>
            {%- when 'diy' -%}<svg viewBox="0 0 56 56"><path d="M14 44l18-18" stroke="#7A4A22" stroke-width="5" stroke-linecap="round"/><path d="M27 13l9-4 11 11-4 9-5-5-6 6-6-6 6-6z" fill="#C0621B"/><path d="M41 44L22 25" stroke="#8F959B" stroke-width="5" stroke-linecap="round"/><path d="M13 10a8 8 0 0110.5 10.5L18 26l-6-6 5.5-5.5A8 8 0 0113 10z" fill="#B4BAC0"/></svg>
            {%- when 'electricals' -%}<svg viewBox="0 0 56 56"><path d="M14 20h24v18a10 10 0 01-10 10h-4a10 10 0 01-10-10z" fill="#B69BE0"/><path d="M38 24h4a5 5 0 010 10h-4" fill="none" stroke="#6B3FA0" stroke-width="3.5"/><rect x="12" y="16" width="28" height="6" rx="2" fill="#6B3FA0"/><path d="M22 16v-4a4 4 0 018 0v4" fill="none" stroke="#6B3FA0" stroke-width="3"/><path d="M27 27l-4 7h5l-3 7" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- when 'club' -%}<svg viewBox="0 0 56 56"><rect x="6" y="16" width="44" height="28" rx="5" fill="#1F4D3A"/><path d="M6 23h44" stroke="#E7C98F" stroke-width="3"/><circle cx="37" cy="34" r="8" fill="#E7C98F"/><text x="37" y="37.5" text-anchor="middle" font-family="Figtree,Arial,sans-serif" font-weight="800" font-size="9.5" fill="#1F4D3A">10%</text><rect x="12" y="30" width="14" height="3" rx="1.5" fill="#fff" opacity=".8"/><rect x="12" y="36" width="9" height="3" rx="1.5" fill="#fff" opacity=".5"/></svg>
            {%- else -%}<svg viewBox="0 0 56 56"><path d="M28 7l6.2 13.3 14.3 1.7-10.6 9.8 2.8 14.2L28 38.9 15.3 46l2.8-14.2L7.5 22l14.3-1.7z" fill="#E2B14F" stroke="#A57425" stroke-width="2.5" stroke-linejoin="round"/></svg>
          {%- endcase -%}
        </span>
        <span class="brf-ptiles__text">
          <span class="brf-ptiles__title">{{ p_title }}</span>
          {%- if p_badge != blank -%}<span class="brf-ptiles__badge">{{ p_badge }}</span>{%- endif -%}
        </span>
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- if promo_tiles contains 'brf-ptiles__item' -%}
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@600;700;800&display=swap" rel="stylesheet">
<div class="brf-ptiles-host">
<section class="brf-wrap brf-ptiles" aria-roledescription="carousel" aria-label="Offers and new categories" data-brf-ptiles>
  <div class="brf-ptiles__viewport">
    <div class="brf-ptiles__bg" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    <button type="button" class="brf-ptiles__arrow brf-ptiles__arrow--prev" aria-label="Previous offers" data-brf-ptiles-prev><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <ul class="brf-ptiles__track" data-brf-ptiles-track>{{ promo_tiles }}</ul>
    <button type="button" class="brf-ptiles__arrow brf-ptiles__arrow--next" aria-label="Next offers" data-brf-ptiles-next><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  </div>
  <div class="brf-ptiles__controls">
    <div class="brf-ptiles__dots" data-brf-ptiles-dots></div>
    <button type="button" class="brf-ptiles__pause" aria-label="Pause scrolling" data-brf-ptiles-pause>
      <svg class="brf-ptiles__i-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>
      <svg class="brf-ptiles__i-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 5l12 7-12 7z" fill="currentColor"/></svg>
    </button>
  </div>
</section>
</div>

<style>
  .brf-ptiles{padding-top:40px;padding-bottom:40px}
  /* Colourful backdrop that the frosted-glass tiles blur */
  .brf-ptiles__viewport{position:relative;padding:22px}
  .brf-ptiles__bg{position:absolute;top:0;right:0;bottom:0;left:0;border-radius:22px;overflow:hidden;background:linear-gradient(120deg,#F4E9D6 0%,#EFE3F1 45%,#DDEEE6 100%);box-shadow:inset 0 0 0 1px rgba(255,255,255,.6)}
  .brf-ptiles__bg span{position:absolute;border-radius:50%;filter:blur(38px);opacity:.75;animation:brf-ptiles-drift 18s ease-in-out infinite alternate}
  .brf-ptiles__bg span:nth-child(1){width:260px;height:180px;left:2%;top:-40px;background:#F2B64A}
  .brf-ptiles__bg span:nth-child(2){width:240px;height:200px;left:24%;bottom:-70px;background:#EF6B5E;animation-delay:-4s}
  .brf-ptiles__bg span:nth-child(3){width:280px;height:180px;left:46%;top:-60px;background:#4FB07A;animation-delay:-8s}
  .brf-ptiles__bg span:nth-child(4){width:240px;height:200px;left:66%;bottom:-80px;background:#5C8EE0;animation-delay:-12s}
  .brf-ptiles__bg span:nth-child(5){width:220px;height:180px;right:-2%;top:-50px;background:#A77BE0;animation-delay:-16s}
  @keyframes brf-ptiles-drift{from{transform:translate3d(0,0,0) scale(1)}to{transform:translate3d(40px,18px,0) scale(1.15)}}
  .brf-ptiles__track{position:relative;display:flex;gap:14px;margin:0;padding:4px 0;list-style:none;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
  .brf-ptiles__track::-webkit-scrollbar{display:none}
  .brf-ptiles__item{flex:0 0 calc((100% - 42px) / 4);scroll-snap-align:start;margin:0;padding:0}
  /* Frosted glass tile */
  .brf-home a.brf-ptiles__tile{position:relative;overflow:hidden;isolation:isolate;display:flex;align-items:center;gap:14px;height:100%;min-height:104px;padding:14px 18px;border-radius:16px;
    background:linear-gradient(135deg,rgba(255,255,255,.72),rgba(255,255,255,.38));
    -webkit-backdrop-filter:blur(18px) saturate(170%);backdrop-filter:blur(18px) saturate(170%);
    border:1px solid rgba(255,255,255,.75);
    box-shadow:0 10px 28px rgba(60,40,20,.12),inset 0 1px 0 rgba(255,255,255,.95),inset 0 -1px 0 rgba(255,255,255,.25);
    color:var(--brf-ink);text-decoration:none;transition:transform .2s,box-shadow .2s,background .2s}
  /* Glossy highlight across the top */
  .brf-home a.brf-ptiles__tile::before{content:"";position:absolute;inset:0 0 52% 0;z-index:-1;border-radius:16px 16px 40% 40%/16px 16px 22px 22px;background:linear-gradient(180deg,rgba(255,255,255,.7),rgba(255,255,255,0));pointer-events:none}
  /* Shine that sweeps across on hover */
  .brf-home a.brf-ptiles__tile::after{content:"";position:absolute;top:-20%;bottom:-20%;left:-60%;width:40%;z-index:1;background:linear-gradient(100deg,rgba(255,255,255,0),rgba(255,255,255,.65),rgba(255,255,255,0));transform:skewX(-18deg);transition:left .6s ease;pointer-events:none}
  .brf-home a.brf-ptiles__tile:hover{transform:translateY(-3px);background:linear-gradient(135deg,rgba(255,255,255,.82),rgba(255,255,255,.5));box-shadow:0 16px 34px rgba(60,40,20,.18),inset 0 1px 0 #fff;text-decoration:none}
  .brf-home a.brf-ptiles__tile:hover::after{left:125%}
  .brf-home a.brf-ptiles__tile:focus-visible{outline:3px solid var(--brf-accent);outline-offset:3px}
  @supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.brf-home a.brf-ptiles__tile{background:rgba(255,255,255,.86)}}
  .brf-ptiles__icon{flex:0 0 56px;width:56px;height:56px;filter:drop-shadow(0 3px 5px rgba(0,0,0,.12))}
  .brf-ptiles__icon svg{display:block;width:100%;height:100%}
  .brf-ptiles__text{display:flex;flex-direction:column;align-items:flex-start;gap:7px;min-width:0}
  .brf-ptiles__title{font-size:21px;line-height:1.02;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;color:var(--brf-ink)}
  .brf-ptiles__badge{display:inline-block;padding:3px 9px;border-radius:999px;background:var(--tile,#1F4D3A);color:#fff;font-size:11.5px;line-height:1.3;font-weight:700;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,.15),inset 0 1px 0 rgba(255,255,255,.3)}
  .brf-ptiles__arrow{position:absolute;top:50%;z-index:3;display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin-top:-22px;padding:0;border:1px solid rgba(255,255,255,.8);border-radius:50%;background:rgba(255,255,255,.7);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);color:var(--brf-ink);box-shadow:0 4px 14px rgba(28,27,25,.18);cursor:pointer}
  .brf-ptiles__arrow--prev{left:-22px}
  .brf-ptiles__arrow--next{right:-22px}
  .brf-ptiles__arrow:hover{background:#fff}
  .brf-ptiles__arrow:focus-visible,.brf-ptiles__pause:focus-visible,.brf-ptiles__dot:focus-visible{outline:3px solid var(--brf-accent);outline-offset:2px}
  .brf-ptiles__controls{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:14px}
  .brf-ptiles__dots{display:flex;gap:4px}
  .brf-ptiles__dot{width:24px;height:24px;padding:0;border:0;background:none;cursor:pointer;display:flex;align-items:center;justify-content:center}
  .brf-ptiles__dot::before{content:"";width:10px;height:10px;border-radius:50%;background:#CFC5B3;transition:background .15s,transform .15s}
  .brf-ptiles__dot[aria-current="true"]::before{background:var(--brf-ink);transform:scale(1.15)}
  .brf-ptiles__pause{display:flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;border:0;border-radius:50%;background:none;color:var(--brf-muted);cursor:pointer}
  .brf-ptiles__pause:hover{color:var(--brf-ink)}
  .brf-ptiles__i-play{display:none}
  .brf-ptiles.is-paused .brf-ptiles__i-play{display:block}
  .brf-ptiles.is-paused .brf-ptiles__i-pause{display:none}
  .brf-ptiles.is-static .brf-ptiles__arrow,.brf-ptiles.is-static .brf-ptiles__controls{display:none}
  @media (max-width:1199px){.brf-ptiles__item{flex-basis:calc((100% - 28px) / 3)}}
  @media (max-width:1023px){.brf-ptiles__arrow--prev{left:-14px}.brf-ptiles__arrow--next{right:-14px}}
  @media (max-width:799px){
    .brf-ptiles__item{flex-basis:calc((100% - 14px) / 2)}
    .brf-ptiles__title{font-size:18px}
  }
  @media (max-width:640px){
    .brf-ptiles{padding-top:28px;padding-bottom:28px}
    .brf-ptiles__viewport{margin:0 -16px;padding:18px 0}
    .brf-ptiles__bg{border-radius:0}
    .brf-ptiles__bg span{filter:blur(30px)}
    .brf-ptiles__track{gap:10px;padding:4px 16px;scroll-padding:0 16px}
    .brf-ptiles__item{flex-basis:74%}
    .brf-home a.brf-ptiles__tile{min-height:88px;padding:12px 14px;gap:12px}
    .brf-ptiles__icon{flex-basis:46px;width:46px;height:46px}
    .brf-ptiles__title{font-size:17px}
    .brf-ptiles__arrow{display:none}
    .brf-ptiles__controls{margin-top:10px}
  }
  @media (prefers-reduced-motion:reduce){.brf-ptiles__track{scroll-behavior:auto}.brf-ptiles__bg span{animation:none}.brf-home a.brf-ptiles__tile,.brf-home a.brf-ptiles__tile::after{transition:none}}
</style>

<script>
  (function(){
    var root = document.querySelector('[data-brf-ptiles]');
    if (!root || root.__brfPtiles) return; root.__brfPtiles = true;
    var track = root.querySelector('[data-brf-ptiles-track]');
    var dotsEl = root.querySelector('[data-brf-ptiles-dots]');
    var pauseBtn = root.querySelector('[data-brf-ptiles-pause]');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var DELAY = 2800, timer = null, userPaused = reduce, hovering = false, visible = true, pages = 1;

    function maxScroll(){ return track.scrollWidth - track.clientWidth; }
    function step(){ var item = track.querySelector('.brf-ptiles__item'); return item ? item.getBoundingClientRect().width + (parseFloat(getComputedStyle(track).columnGap) || 12) : track.clientWidth; }
    function atEnd(){ return track.scrollLeft >= maxScroll() - 4; }
    function go(dir){
      if (dir > 0 && atEnd()) { track.scrollTo({left:0}); return; }
      if (dir < 0 && track.scrollLeft <= 4) { track.scrollTo({left:maxScroll()}); return; }
      track.scrollBy({left:dir * step()});
    }
    function buildDots(){
      var m = maxScroll();
      root.classList.toggle('is-static', m <= 4);
      pages = m <= 4 ? 1 : Math.ceil(track.scrollWidth / track.clientWidth - 0.01);
      dotsEl.innerHTML = '';
      for (var i = 0; i < pages; i++) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'brf-ptiles__dot';
        b.setAttribute('aria-label', 'Show offers ' + (i + 1) + ' of ' + pages);
        (function(n){ b.addEventListener('click', function(){ track.scrollTo({left: pages > 1 ? maxScroll() * n / (pages - 1) : 0}); }); })(i);
        dotsEl.appendChild(b);
      }
      mark();
    }
    function mark(){
      var m = maxScroll();
      var cur = m > 0 ? Math.round(track.scrollLeft / m * (pages - 1)) : 0;
      var dots = dotsEl.children;
      for (var i = 0; i < dots.length; i++) dots[i].setAttribute('aria-current', i === cur ? 'true' : 'false');
    }
    function sync(){
      clearInterval(timer); timer = null;
      root.classList.toggle('is-paused', userPaused);
      pauseBtn.setAttribute('aria-label', userPaused ? 'Play scrolling' : 'Pause scrolling');
      if (!userPaused && !hovering && visible && !root.classList.contains('is-static')) timer = setInterval(function(){ go(1); }, DELAY);
    }

    root.querySelector('[data-brf-ptiles-prev]').addEventListener('click', function(){ go(-1); });
    root.querySelector('[data-brf-ptiles-next]').addEventListener('click', function(){ go(1); });
    pauseBtn.addEventListener('click', function(){ userPaused = !userPaused; sync(); });
    root.addEventListener('pointerenter', function(e){ if (e.pointerType === 'mouse') { hovering = true; sync(); } });
    root.addEventListener('pointerleave', function(e){ if (e.pointerType === 'mouse') { hovering = false; sync(); } });
    root.addEventListener('focusin', function(e){ var f = e.target; try { if (f.matches && !f.matches(':focus-visible')) return; } catch (err) {} hovering = true; sync(); });
    root.addEventListener('focusout', function(e){ if (!root.contains(e.relatedTarget)) { hovering = false; sync(); } });
    /* a swipe pauses autoplay; it picks up again a few seconds after the finger lifts */
    var touchT = null;
    track.addEventListener('touchstart', function(){ clearTimeout(touchT); hovering = true; sync(); }, {passive:true});
    track.addEventListener('touchend', function(){ clearTimeout(touchT); touchT = setTimeout(function(){ hovering = false; sync(); }, 3500); }, {passive:true});
    track.addEventListener('scroll', mark, {passive:true});
    var rt = null;
    window.addEventListener('resize', function(){ clearTimeout(rt); rt = setTimeout(function(){ buildDots(); sync(); }, 150); });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function(entries){ visible = entries[0].isIntersecting; sync(); }).observe(root);
    }
    document.addEventListener('visibilitychange', function(){ visible = !document.hidden; sync(); });
    buildDots(); sync();
  })();
</script>
{%- endif -%}
