{%- comment -%} Bull Ring Fabrics — trust chips under Add to cart + floating glass add-to-cart bar {%- endcomment -%}
<ul class="brf-trust-chips" role="list">
  <li class="brf-glass-chip">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
    Free UK delivery over £65
  </li>
  <li class="brf-glass-chip">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
    Same-day dispatch Mon–Fri
  </li>
  <li class="brf-glass-chip">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
    Secure checkout
  </li>
  <li class="brf-glass-chip">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
    Birmingham fabric specialists
  </li>
  <li class="brf-glass-chip brf-gift-chip">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="9" width="17" height="11.5" rx="1.5"/><path d="M2.5 9h19v-3h-19z"/><path d="M12 6v14.5"/><path d="M12 6c-1.6-3.2-5.6-3.4-5.6-1 0 1.5 2.6 1 5.6 1zM12 6c1.6-3.2 5.6-3.4 5.6-1 0 1.5-2.6 1-5.6 1z"/></svg>
    <span><b>No prices or packing slips in the parcel.</b> Sending it to someone else? Our lips are sealed.</span>
  </li>
</ul>
<style>
  /* Frosted glass tiles (Control Center style): soft grey glass, bright white rim, green icon dot */
  html .brf-trust-chips{gap:10px}
  html .brf-trust-chips .brf-glass-chip{position:relative;isolation:isolate;gap:10px;min-height:52px;padding:8px 14px 8px 8px;border:0;border-radius:20px;overflow:hidden;font-size:13px;font-weight:600;color:#1D1D1F!important;
    background:linear-gradient(180deg,rgba(255,255,255,.66) 0%,rgba(226,221,213,.58) 100%);-webkit-backdrop-filter:saturate(170%) blur(22px);backdrop-filter:saturate(170%) blur(22px);
    box-shadow:inset 0 1.5px 0 #fff,inset 1.5px 0 0 rgba(255,255,255,.8),inset 0 0 0 1px rgba(255,255,255,.5),0 0 0 1px rgba(29,29,31,.08),0 12px 26px -16px rgba(29,29,31,.38),0 2px 6px -3px rgba(29,29,31,.12)!important}
  html .brf-trust-chips .brf-glass-chip::before{content:"";position:absolute;left:10%;right:10%;top:0;height:42%;z-index:-1;border-radius:0 0 50% 50%/0 0 100% 100%;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.55),rgba(255,255,255,0))}
  html .brf-trust-chips .brf-glass-chip svg{position:relative;flex:0 0 32px;width:32px;height:32px;padding:7px;border-radius:50%;color:#fff!important;
    background:linear-gradient(180deg,#1DAE65 0%,#149954 55%,#0F884A 100%);box-shadow:inset 0 1px 0 rgba(255,255,255,.4),inset 0 -1px 0 rgba(0,60,28,.25),0 4px 10px -4px rgba(20,153,84,.7)}
  html .brf-trust-chips .brf-glass-chip span{position:relative}
  html .brf-trust-chips .brf-gift-chip{grid-column:1/-1;font-weight:500;color:#3A3835!important}
  html .brf-trust-chips .brf-gift-chip b{font-weight:700;color:#1D1D1F}
  @media (max-width:767px){html .brf-trust-chips .brf-glass-chip{gap:8px;min-height:48px;padding:7px 10px 7px 7px;border-radius:18px;font-size:12.5px}html .brf-trust-chips .brf-glass-chip svg{flex-basis:28px;width:28px;height:28px;padding:6px}}
  @media (prefers-reduced-transparency:reduce){html .brf-trust-chips .brf-glass-chip{background:#fff;-webkit-backdrop-filter:none;backdrop-filter:none}}
</style>

{%- if template.name == 'product' -%}<script>window.brfIsHL = {% if product.tags contains 'home-lifestyle' %}true{% else %}false{% endif %};</script>{%- endif -%}
{%- if template.name == 'product' and template != 'product.quick-view' and product.template_suffix != 'contact' -%}
  {%- comment -%}
    Floating Add to bag bar (River Island style): the chosen variation's photo, a tap-to-change segment per option,
    and a big Add to bag with the price. Phones: shows whenever the real button is off screen. Bigger screens: once scrolled past it.
  {%- endcomment -%}
  {%- assign brf_sab_first = product.selected_or_first_available_variant -%}
  {%- assign brf_sab_im = brf_sab_first.featured_image | default: product.featured_image -%}
  <div class="brf-sticky-atc brf-sab" data-brf-sticky hidden>
    <div class="brf-sticky-atc__inner brf-sab__bar">
      <button type="button" class="brf-sab__thumb" data-brf-sab-top aria-label="Back to the photos">
        {%- if brf_sab_im -%}<img class="brf-sticky-atc__img" src="{{ brf_sab_im | img_url: '160x160', crop: 'center' }}" alt="" width="52" height="52">{%- endif -%}
      </button>
      <div class="brf-sab__info">
        <p class="brf-sab__title">{{ product.title | escape }}</p>
        <div class="brf-sab__opts" data-brf-sab-opts></div>
        <p class="brf-sab__stock" data-brf-sab-stock hidden></p>
      </div>
      <div class="brf-sab__qty" data-brf-sab-qty>
        <button type="button" class="brf-sab__step" data-d="-1" aria-label="One less">&minus;</button>
        <input class="brf-sab__in" type="number" inputmode="numeric" pattern="[0-9]*" min="1" value="1" aria-label="Quantity">
        <button type="button" class="brf-sab__step" data-d="1" aria-label="One more">+</button>
      </div>
      <button type="button" class="brf-sticky-atc__btn brf-sab__add" data-brf-sticky-btn><span class="brf-sab__lbl">Add to bag</span><span class="brf-sab__price" data-brf-sticky-price></span></button>
    </div>
  </div>
  <script type="application/json" data-brf-sab-img>{
    {%- for v in product.variants -%}
      {%- assign im = v.featured_image | default: product.featured_image -%}
      "{{ v.id }}": {% if im %}{{ im | img_url: '160x160', crop: 'center' | json }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }</script>
  <script type="application/json" data-brf-sab-vars>[
    {%- for v in product.variants -%}
      {"i":{{ v.id }},"a":{{ v.available | json }},"o":[{{ v.option1 | json }},{{ v.option2 | json }},{{ v.option3 | json }}]}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]</script>
  <style>
    /* ---------- R8 redesign: one tight row that hugs its content ----------
       [photo] [title / chosen options] [qty] [Add to bag · price] */
    html body .brf-sab{left:0;right:0;bottom:calc(12px + env(safe-area-inset-bottom));padding:0 10px}
    html body .brf-sab .brf-sab__bar{display:flex!important;align-items:center;gap:10px!important;box-sizing:border-box;width:auto;max-width:100%;height:auto;min-height:0;padding:7px!important;border-radius:18px!important;
      background:rgba(255,255,255,.96)!important;-webkit-backdrop-filter:saturate(180%) blur(20px)!important;backdrop-filter:saturate(180%) blur(20px)!important;border:0!important;
      box-shadow:0 0 0 1px rgba(29,29,31,.08),0 18px 40px -18px rgba(29,29,31,.5),0 3px 10px -5px rgba(29,29,31,.16)!important}
    .brf-sab__thumb{position:relative;flex:0 0 46px;width:46px;height:46px;padding:0;margin:0;border:0;border-radius:12px;overflow:hidden;background:#ECE6DC;cursor:pointer}
    html body .brf-sab .brf-sab__thumb img{display:block;width:100%;height:100%;object-fit:cover;border-radius:0;box-shadow:none;transition:opacity .2s ease,transform .45s cubic-bezier(.2,1.4,.3,1)}
    .brf-sab__thumb.is-swap img{animation:brf-sab-swap .5s cubic-bezier(.2,1.3,.3,1)}
    @keyframes brf-sab-swap{0%{opacity:.2;transform:scale(.7) rotate(-6deg)}100%{opacity:1;transform:none}}
    .brf-sab__info{flex:1 1 auto;min-width:0;display:flex;flex-flow:row wrap;align-content:center;align-items:center;column-gap:10px;row-gap:4px}
    .brf-sab__info .brf-sab__title{flex:1 0 100%}
    html body .brf-sab .brf-sab__title{margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px;font-weight:700;line-height:1.2;letter-spacing:-.01em;color:#1D1D1F}
    .brf-sab__opts{display:flex;gap:6px;min-width:0}
    .brf-sab__opts:empty{display:none}
    .brf-sab__seg{display:inline-flex;align-items:center;gap:5px;flex:0 1 auto;min-width:0;height:26px;margin:0;padding:0 8px 0 7px;border:0;border-radius:8px;background:#F4F0EA;color:#1D1D1F;
      font:600 12.5px/1 inherit;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:background .15s}
    @media (hover:hover){.brf-sab__seg:hover{background:#ECE6DC}.brf-sab__step:hover{background:rgba(29,29,31,.06)}}
    .brf-sab__seg:active{background:#E4DDD2}
    .brf-sab__seg span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .brf-sab__seg svg{flex:0 0 auto;width:9px;height:9px;color:#8C867D}
    .brf-sab__dot{flex:0 0 auto;width:13px;height:13px;border-radius:50%;background:#ddd center/cover no-repeat;box-shadow:inset 0 0 0 1px rgba(0,0,0,.14)}
    .brf-sab__more{flex:0 0 auto;font-size:11px;font-weight:600;color:#8C867D}
    /* stock level */
    html body .brf-sab .brf-sab__stock{display:flex;align-items:center;gap:5px;margin:0;font-size:11.5px;font-weight:600;line-height:1.2;color:#0C6637;white-space:nowrap}
    .brf-sab__stock::before{content:"";flex:0 0 auto;width:6px;height:6px;border-radius:50%;background:#149954;box-shadow:0 0 0 2px rgba(20,153,84,.18)}
    html body .brf-sab .brf-sab__stock.is-low{color:#B45309}
    .brf-sab__stock.is-low::before{background:#E08A00;box-shadow:0 0 0 2px rgba(224,138,0,.2);animation:brf-sab-blink 1.6s ease-in-out infinite}
    @keyframes brf-sab-blink{50%{opacity:.35}}
    .brf-sab__stock[hidden]{display:none!important}
    .brf-sab-sheet__o em.brf-sab-q{color:#0C6637;font-weight:600}
    .brf-sab-sheet__o em.brf-sab-q.is-low{color:#B45309}
    /* quantity */
    .brf-sab__qty{flex:0 0 auto;display:flex;align-items:center;height:40px;padding:0 2px;border-radius:11px;background:#F4F0EA;box-shadow:inset 0 0 0 1px #E6DFD4}
    .brf-sab__step{display:grid;place-items:center;width:28px;height:36px;padding:0;border:0;border-radius:9px;background:transparent;color:#1D1D1F;font:500 18px/1 inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
    .brf-sab__step:disabled{color:#C9C2B7;cursor:default;background:transparent}
    html body .brf-sab .brf-sab__in{width:30px;height:36px;min-height:0;margin:0;padding:0;border:0!important;border-radius:0;background:transparent!important;box-shadow:none!important;color:#1D1D1F;font:700 15px/1 inherit;text-align:center;-moz-appearance:textfield;appearance:textfield}
    .brf-sab__in::-webkit-outer-spin-button,.brf-sab__in::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
    .brf-sab__in:focus{outline:none}
    .brf-sab__qty:focus-within{box-shadow:inset 0 0 0 2px #149954}
    .brf-sab__qty{position:relative}
    .brf-sab__step.is-cap{color:#C9C2B7}
    .brf-sab__qty.is-max{animation:brf-sab-nudge .4s ease}
    @keyframes brf-sab-nudge{20%{transform:translateX(-3px)}40%{transform:translateX(3px)}60%{transform:translateX(-2px)}80%{transform:translateX(1px)}}
    html body .brf-sab .brf-sab__bar{position:relative}
    .brf-sab__tip{position:absolute;left:var(--ax,50%);bottom:calc(100% + 12px);z-index:2;max-width:calc(100vw - 32px);padding:7px 12px;border-radius:10px;background:#1D1D1F;color:#fff;font-size:12.5px;font-weight:600;line-height:1.3;white-space:nowrap;
      transform:translate(-50%,6px);opacity:0;pointer-events:none;transition:opacity .2s ease,transform .25s ease}
    .brf-sab__tip::after{content:"";position:absolute;left:50%;top:100%;margin-left:-6px;border:6px solid transparent;border-top-color:#1D1D1F}
    .brf-sab__tip.is-on{opacity:1;transform:translate(-50%,0)}
    @media (max-width:767px){
      /* phones: a full-width bubble above the bar, its arrow still pointing at the quantity */
      .brf-sab__tip{left:6px;right:6px;max-width:none;white-space:normal;text-align:center;transform:translateY(6px)}
      .brf-sab__tip.is-on{transform:none}
      .brf-sab__tip::after{left:calc(var(--ax,50%) - 6px);margin-left:0}
    }
    /* button: "Add to bag" with the price beside it */
    html body .brf-sab .brf-sab__add{display:flex!important;flex:0 0 auto;flex-direction:row;align-items:center;justify-content:center;gap:8px;min-width:0;height:46px!important;margin:0;padding:0 20px!important;
      border:0!important;border-radius:12px!important;color:#fff!important;font-weight:700!important;line-height:1;white-space:nowrap;cursor:pointer;
      background:linear-gradient(180deg,#1DAE65 0%,#149954 52%,#0F884A 100%)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 8px 18px -10px rgba(20,153,84,.9)!important;transition:transform .15s ease,background .2s ease}
    html body .brf-sab .brf-sab__add:hover{background:linear-gradient(180deg,#18A05C 0%,#0F884A 100%)!important}
    html body .brf-sab .brf-sab__add:active{transform:scale(.97)}
    html body .brf-sab .brf-sab__add.brf-added{background:#0C6637!important}
    html body .brf-sab .brf-sab__add:disabled{background:#ECE6DC!important;color:#8C867D!important;box-shadow:none!important;cursor:default}
    .brf-sab__lbl{font-size:15px;font-weight:700;letter-spacing:-.005em}
    .brf-sab__lbl.is-added::after{content:"\2713";display:inline-block;margin-left:6px;animation:brf-sab-tick .4s cubic-bezier(.2,1.6,.3,1)}
    .brf-sab__price{padding-left:9px;border-left:1px solid rgba(255,255,255,.35);font-size:14px;font-weight:600;opacity:.95}
    .brf-sab__price:empty{display:none}
    html body .brf-sab .brf-sab__add.is-pop{animation:brf-sab-pop .45s cubic-bezier(.2,1.4,.3,1)}
    @keyframes brf-sab-pop{0%{transform:scale(.94)}60%{transform:scale(1.04)}100%{transform:none}}
    @keyframes brf-sab-tick{0%{transform:scale(0)}100%{transform:none}}
    @media (min-width:768px){
      html body .brf-sab .brf-sab__bar{width:fit-content;min-width:460px;max-width:min(760px,calc(100vw - 40px));gap:12px!important;padding:8px!important}
      .brf-sab__thumb{flex-basis:50px;width:50px;height:50px}
      .brf-sab__info{max-width:330px;padding-right:2px}
      html body .brf-sab .brf-sab__add{height:50px!important;padding:0 24px!important}
      .brf-sab__qty{height:44px}
      .brf-sab__step{width:32px;height:40px}
      html body .brf-sab .brf-sab__in{width:34px;height:40px;font-size:16px}
    }
    /* phones: the title gives way to the chosen option; the price sits under the label */
    @media (max-width:767px){
      html body .brf-sab .brf-sab__bar{width:100%;gap:8px!important;padding:6px!important;border-radius:16px!important}
      html body .brf-sab .brf-sab__title{font-size:13px}
      .brf-sab.has-opts .brf-sab__title{display:none}
      .brf-sab__info{flex-flow:column nowrap;align-items:flex-start;justify-content:center;gap:3px}
      .brf-sab__info .brf-sab__title{flex:0 0 auto}
      .brf-sab.has-opts .brf-sab__seg{height:28px}
      html body .brf-sab .brf-sab__stock{font-size:11px;padding-left:2px}
      .brf-sab:not(.has-opts) .brf-sab__title{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;font-size:12.5px;line-height:1.25}
      .brf-sab__seg{height:34px;padding:0 8px;font-size:13px;border-radius:10px}
      .brf-sab__more{display:none}
      .brf-sab__qty{height:38px}
      .brf-sab__step{width:24px;height:34px;font-size:17px}
      html body .brf-sab .brf-sab__in{width:26px;height:34px;font-size:14.5px}
      html body .brf-sab .brf-sab__add{flex-direction:column;gap:2px;height:46px!important;padding:0 12px!important}
      .brf-sab__lbl{font-size:14px}
      .brf-sab__price{padding:0;border:0;font-size:11.5px;font-weight:500;opacity:.9}
    }
    @media (max-width:374px){
      .brf-sab__thumb{flex-basis:40px;width:40px;height:40px}
      html body .brf-sab .brf-sab__bar{gap:6px!important}
      .brf-sab__step{width:21px}
      html body .brf-sab .brf-sab__in{width:23px}
      html body .brf-sab .brf-sab__add{padding:0 9px!important}
      .brf-sab__lbl{font-size:13px}
    }

    /* option sheet */
    .brf-sab-scrim{position:fixed;inset:0;z-index:2147483300;background:rgba(10,10,12,.4);opacity:0;transition:opacity .25s ease;-webkit-tap-highlight-color:transparent}
    .brf-sab-scrim.is-on{opacity:1}
    .brf-sab-sheet{position:fixed;left:0;right:0;bottom:0;z-index:2147483301;max-height:70vh;max-height:70dvh;display:flex;flex-direction:column;padding:8px 16px calc(16px + env(safe-area-inset-bottom));
      border-radius:24px 24px 0 0;background:#fff;box-shadow:0 -20px 50px -20px rgba(0,0,0,.4);transform:translateY(105%);transition:transform .38s cubic-bezier(.2,.9,.25,1)}
    .brf-sab-sheet.is-on{transform:none}
    .brf-sab-sheet__grab{width:38px;height:5px;margin:2px auto 10px;border-radius:5px;background:#DDD5C8}
    .brf-sab-sheet__h{display:flex;align-items:center;justify-content:space-between;margin:0 0 12px;font-size:17px;font-weight:700;color:#1D1D1F}
    .brf-sab-sheet__x{display:grid;place-items:center;width:34px;height:34px;padding:0;border:0;border-radius:50%;background:rgba(29,29,31,.07);color:#1D1D1F;font-size:20px;line-height:1;cursor:pointer}
    .brf-sab-sheet__body{overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding:12px 2px 2px}
    .brf-sab-sheet__g{margin:14px 2px 8px;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#8C867D}
    .brf-sab-sheet__g:first-child{margin-top:0}
    .brf-sab-sheet__list{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}
    .brf-sab-sheet__o{display:flex;align-items:center;gap:10px;min-width:0;padding:10px 12px;border:0;border-radius:14px;background:#F6F3EE;color:#1D1D1F;font:500 14px/1.2 inherit;text-align:left;cursor:pointer;box-shadow:inset 0 0 0 1px transparent;transition:box-shadow .15s,background .15s}
    .brf-sab-sheet__o span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .brf-sab-sheet__o .brf-sab__dot{width:18px;height:18px}
    .brf-sab-sheet__o.is-sel{background:#fff;box-shadow:inset 0 0 0 2px #1D1D1F;font-weight:700}
    .brf-sab-sheet__o.is-oos{color:#9A948B}
    .brf-sab-sheet__o.is-oos span{text-decoration:line-through;text-decoration-thickness:1.5px;text-decoration-color:#B3261E}
    .brf-sab-sheet__o.is-oos .brf-sab__dot{opacity:.45;background-image:linear-gradient(135deg,transparent 46%,#B3261E 46%,#B3261E 54%,transparent 54%)!important}
    .brf-sab-sheet__g b{margin-left:6px;font-weight:700;letter-spacing:0;text-transform:none;color:#1D1D1F}
    .brf-sab-sheet__list.is-sw{grid-template-columns:repeat(auto-fill,minmax(68px,1fr));gap:8px}
    .brf-sab-sheet__o.is-sw{position:relative;flex-direction:column;justify-content:center;gap:6px;min-height:72px;padding:10px 4px 8px;overflow:visible;text-align:center}
    .brf-sab-sheet__o.is-sw .brf-sab__dot{width:30px;height:30px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.14),0 1px 3px rgba(0,0,0,.12)}
    html body .brf-sab-sheet__o.is-sw em{margin:0;font-size:10.5px;line-height:1.15;white-space:nowrap}
    .brf-sab-sheet__o.is-sw.is-sel{box-shadow:inset 0 0 0 2px #1D1D1F}
    /* the colour name: a little bubble on hover (desktop) or on tap (phones) */
