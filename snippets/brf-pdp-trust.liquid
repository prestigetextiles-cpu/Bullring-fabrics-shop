{%- if template.name == 'product' -%}<script>window.brfIsHL = {% if product.tags contains 'home-lifestyle' %}true{% else %}false{% endif %};</script>{%- endif -%}
{%- if template.name == 'product' and template != 'product.quick-view' and product.template_suffix != 'contact' -%}
  {%- comment -%}
    Floating Add to bag bar (River Island style): the chosen variation's photo, a tap-to-change segment per option,
    and a big Add to bag with the price. Phones: shows whenever the real button is off screen. Bigger screens: once scrolled past it.
  {%- endcomment -%}
  {%- assign brf_sab_first = product.selected_or_first_available_variant -%}
  {%- assign brf_sab_im = brf_sab_first.featured_image | default: product.featured_image -%}
  <div class="brf-sticky-atc brf-sab" data-brf-sticky hidden>
    <div class="brf-sticky-atc__inner brf-sab__bar">
      <button type="button" class="brf-sab__thumb" data-brf-sab-top aria-label="Back to the photos">
        {%- if brf_sab_im -%}<img class="brf-sticky-atc__img" src="{{ brf_sab_im | img_url: '160x160', crop: 'center' }}" alt="" width="52" height="52">{%- endif -%}
      </button>
      <div class="brf-sab__opts" data-brf-sab-opts></div>
      <div class="brf-sab__qty" data-brf-sab-qty>
        <button type="button" class="brf-sab__step" data-d="-1" aria-label="One less">&minus;</button>
        <input class="brf-sab__in" type="number" inputmode="numeric" pattern="[0-9]*" min="1" value="1" aria-label="Quantity">
        <button type="button" class="brf-sab__step" data-d="1" aria-label="One more">+</button>
      </div>
      <button type="button" class="brf-sticky-atc__btn brf-sab__add" data-brf-sticky-btn><span class="brf-sab__lbl">Add to bag</span><span class="brf-sab__price" data-brf-sticky-price></span></button>
    </div>
  </div>
  <script type="application/json" data-brf-sab-img>{
    {%- for v in product.variants -%}
      {%- assign im = v.featured_image | default: product.featured_image -%}
      "{{ v.id }}": {% if im %}{{ im | img_url: '160x160', crop: 'center' | json }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }</script>
  <script type="application/json" data-brf-sab-vars>[
    {%- for v in product.variants -%}
      {"a":{{ v.available | json }},"o":[{{ v.option1 | json }},{{ v.option2 | json }},{{ v.option3 | json }}]}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]</script>
  <style>
    html body .brf-sab{left:0;right:0;bottom:calc(12px + env(safe-area-inset-bottom));padding:0 10px}
    html body .brf-sab .brf-sab__bar{display:flex!important;align-items:stretch;gap:0!important;width:100%;max-width:720px;height:64px;padding:6px!important;border-radius:20px!important;
      background:rgba(255,255,255,.97)!important;-webkit-backdrop-filter:saturate(180%) blur(20px)!important;backdrop-filter:saturate(180%) blur(20px)!important;border:0!important;
      box-shadow:0 0 0 1px rgba(29,29,31,.07),0 22px 44px -18px rgba(29,29,31,.5),0 4px 12px -6px rgba(29,29,31,.18)!important}
    .brf-sab__thumb{position:relative;flex:0 0 52px;width:52px;height:52px;padding:0;margin:0 4px 0 0;border:0;border-radius:14px;overflow:hidden;background:#ECE6DC;cursor:pointer}
    html body .brf-sab .brf-sab__thumb img{display:block;width:100%;height:100%;object-fit:cover;border-radius:0;box-shadow:none;transition:opacity .2s ease,transform .45s cubic-bezier(.2,1.4,.3,1)}
    .brf-sab__thumb.is-swap img{animation:brf-sab-swap .5s cubic-bezier(.2,1.3,.3,1)}
    @keyframes brf-sab-swap{0%{opacity:.2;transform:scale(.7) rotate(-6deg)}100%{opacity:1;transform:none}}
    .brf-sab__opts{display:flex;flex:0 1 auto;min-width:0}
    .brf-sab__seg{display:flex;flex-direction:column;justify-content:center;gap:3px;min-width:0;max-width:150px;padding:0 12px;border:0;border-left:1px solid #ECE6DC;background:transparent;color:#1D1D1F;text-align:left;cursor:pointer;font:inherit;-webkit-tap-highlight-color:transparent}
    .brf-sab__seg:first-child{border-left:0}
    .brf-sab__seg:active{background:rgba(29,29,31,.04)}
    .brf-sab__v{display:flex;align-items:center;gap:6px;min-width:0;font-size:13.5px;font-weight:600;line-height:1.1}
    .brf-sab__v span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .brf-sab__dot{flex:0 0 auto;width:16px;height:16px;border-radius:50%;background:#ddd center/cover no-repeat;box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)}
    .brf-sab__n{flex:0 0 auto;font-size:11px;font-weight:600;color:#6B665F}
    .brf-sab__cap{display:flex;align-items:center;gap:4px;font-size:11px;font-weight:500;line-height:1;color:#8C867D;white-space:nowrap}
    .brf-sab__cap svg{width:9px;height:9px}
    html body .brf-sab .brf-sab__add{display:flex!important;flex:1 1 auto;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-width:112px;height:auto!important;margin:0 0 0 6px;padding:0 14px!important;
      border:0!important;border-radius:14px!important;color:#fff!important;font-weight:700!important;line-height:1.1;cursor:pointer;
      background:linear-gradient(180deg,#1DAE65 0%,#149954 52%,#0F884A 100%)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 8px 18px -10px rgba(20,153,84,.9)!important;transition:transform .15s ease}
    html body .brf-sab .brf-sab__add:active{transform:scale(.97)}
    html body .brf-sab .brf-sab__add.brf-added{background:#0C6637!important}
    .brf-sab__lbl.is-added::after{content:"\2713";display:inline-block;margin-left:6px;animation:brf-sab-tick .4s cubic-bezier(.2,1.6,.3,1)}
    html body .brf-sab .brf-sab__add.is-pop{animation:brf-sab-pop .45s cubic-bezier(.2,1.4,.3,1)}
    @keyframes brf-sab-pop{0%{transform:scale(.94)}60%{transform:scale(1.04)}100%{transform:none}}
    @keyframes brf-sab-tick{0%{transform:scale(0)}100%{transform:none}}
    html body .brf-sab .brf-sab__add:disabled{background:#ECE6DC!important;color:#8C867D!important;box-shadow:none!important;cursor:default}
    .brf-sab__lbl{font-size:15px;font-weight:700;letter-spacing:-.005em}
    .brf-sab__price{font-size:12px;font-weight:500;opacity:.88}
    .brf-sab__price:empty{display:none}
    /* quantity box */
    .brf-sab__qty{flex:0 0 auto;display:flex;align-items:center;align-self:center;height:44px;margin:0 0 0 6px;padding:0 2px;border-radius:12px;background:#F6F3EE;box-shadow:inset 0 0 0 1px #E4DDD2}
    .brf-sab__step{display:grid;place-items:center;width:30px;height:40px;padding:0;border:0;border-radius:10px;background:transparent;color:#1D1D1F;font:500 19px/1 inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
    .brf-sab__step:active{background:rgba(29,29,31,.08)}
    .brf-sab__step:disabled{color:#C9C2B7;cursor:default;background:transparent}
    html body .brf-sab .brf-sab__in{width:34px;height:40px;min-height:0;margin:0;padding:0;border:0!important;border-radius:0;background:transparent!important;box-shadow:none!important;color:#1D1D1F;font:700 15px/1 inherit;text-align:center;-moz-appearance:textfield;appearance:textfield}
    .brf-sab__in::-webkit-outer-spin-button,.brf-sab__in::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
    .brf-sab__in:focus{outline:none}
    .brf-sab__qty:focus-within{box-shadow:inset 0 0 0 2px #149954}
    @media (max-width:767px){
      .brf-sab__thumb{flex-basis:46px;width:46px;height:46px;align-self:center;margin-right:2px}
      .brf-sab__qty{height:42px;margin-left:4px}
      .brf-sab__step{width:26px}
      html body .brf-sab .brf-sab__in{width:28px;font-size:14.5px}
      html body .brf-sab .brf-sab__add{min-width:0;padding:0 10px!important}
      .brf-sab__seg{flex:1 1 auto;max-width:none;padding:0 8px}
      .brf-sab__opts{flex:1 1 auto}
    }
    @media (max-width:767px){.brf-sab__n{display:none}}
    @media (max-width:374px){.brf-sab__thumb{flex-basis:40px;width:40px;height:40px}.brf-sab__seg{padding:0 6px}.brf-sab__step{width:21px}html body .brf-sab .brf-sab__in{width:24px}html body .brf-sab .brf-sab__add{padding:0 8px!important}.brf-sab__add{min-width:96px}.brf-sab__lbl{font-size:14px}}

    /* option sheet */
    .brf-sab-scrim{position:fixed;inset:0;z-index:2147483300;background:rgba(10,10,12,.4);opacity:0;transition:opacity .25s ease;-webkit-tap-highlight-color:transparent}
    .brf-sab-scrim.is-on{opacity:1}
    .brf-sab-sheet{position:fixed;left:0;right:0;bottom:0;z-index:2147483301;max-height:70vh;max-height:70dvh;display:flex;flex-direction:column;padding:8px 16px calc(16px + env(safe-area-inset-bottom));
      border-radius:24px 24px 0 0;background:#fff;box-shadow:0 -20px 50px -20px rgba(0,0,0,.4);transform:translateY(105%);transition:transform .38s cubic-bezier(.2,.9,.25,1)}
    .brf-sab-sheet.is-on{transform:none}
    .brf-sab-sheet__grab{width:38px;height:5px;margin:2px auto 10px;border-radius:5px;background:#DDD5C8}
    .brf-sab-sheet__h{display:flex;align-items:center;justify-content:space-between;margin:0 0 12px;font-size:17px;font-weight:700;color:#1D1D1F}
    .brf-sab-sheet__x{display:grid;place-items:center;width:34px;height:34px;padding:0;border:0;border-radius:50%;background:rgba(29,29,31,.07);color:#1D1D1F;font-size:20px;line-height:1;cursor:pointer}
    .brf-sab-sheet__body{overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding:2px}
    .brf-sab-sheet__g{margin:14px 2px 8px;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#8C867D}
    .brf-sab-sheet__g:first-child{margin-top:0}
    .brf-sab-sheet__list{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px}
    .brf-sab-sheet__o{display:flex;align-items:center;gap:10px;min-width:0;padding:10px 12px;border:0;border-radius:14px;background:#F6F3EE;color:#1D1D1F;font:500 14px/1.2 inherit;text-align:left;cursor:pointer;box-shadow:inset 0 0 0 1px transparent;transition:box-shadow .15s,background .15s}
    .brf-sab-sheet__o span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .brf-sab-sheet__o .brf-sab__dot{width:18px;height:18px}
    .brf-sab-sheet__o.is-sel{background:#fff;box-shadow:inset 0 0 0 2px #1D1D1F;font-weight:700}
    .brf-sab-sheet__o.is-oos{color:#9A948B}
    .brf-sab-sheet__o.is-oos span{text-decoration:line-through;text-decoration-thickness:1.5px;text-decoration-color:#B3261E}
    .brf-sab-sheet__o.is-oos .brf-sab__dot{opacity:.45;background-image:linear-gradient(135deg,transparent 46%,#B3261E 46%,#B3261E 54%,transparent 54%)!important}
    .brf-sab-sheet__o em{margin-left:auto;flex:0 0 auto;font-style:normal;font-size:10.5px;font-weight:600;letter-spacing:.02em;color:#B3261E}
    @media (min-width:768px){
      /* desktop: a compact bar with a smaller green button, like River Island's */
      html body .brf-sab .brf-sab__bar{width:min(900px,100%);max-width:900px;height:66px;padding:6px!important;border-radius:18px!important}
      .brf-sab__opts{flex:1 1 auto}
      html body .brf-sab .brf-sab__seg{flex:1 1 0;max-width:none}
      .brf-sab__qty{height:50px;margin-left:8px}
      .brf-sab__step{width:34px;height:46px}
      html body .brf-sab .brf-sab__in{width:38px;height:46px;font-size:16px}
      .brf-sab__thumb{flex-basis:54px;width:54px;height:54px;border-radius:13px}
      html body .brf-sab .brf-sab__add{flex:0 0 auto;min-width:182px;padding:0 30px!important;border-radius:13px!important}
      .brf-sab__lbl{font-size:15px}
      .brf-sab__price{font-size:12.5px}
      .brf-sab__seg{max-width:200px;padding:0 18px}
      .brf-sab__v{font-size:14px}
      .brf-sab__cap{font-size:11.5px}
    }
    @media (min-width:768px){
      .brf-sab-sheet{left:50%;right:auto;bottom:96px;width:min(560px,calc(100% - 40px));border-radius:22px;transform:translate(-50%,20px);opacity:0;pointer-events:none;transition:transform .3s cubic-bezier(.2,.9,.25,1),opacity .2s ease}
      .brf-sab-sheet.is-on{transform:translate(-50%,0);opacity:1;pointer-events:auto}
      .brf-sab-sheet__grab{display:none}
    }
    @media (prefers-reduced-motion:reduce){.brf-sab-sheet,.brf-sab-scrim,.brf-sab__thumb img{transition:none;animation:none!important}}
  </style>
  <script>
  (function(){
    var doc = document;
    var bar = doc.querySelector('[data-brf-sticky]');
    var info = doc.querySelector('.product-block-list__item--info');
    var mainBtn = info && info.querySelector('.product-form__add-button');
    if (!bar || !mainBtn || !('IntersectionObserver' in window)) return;
    var form = mainBtn.closest('form') || info;
    var idEl = form.querySelector('[name="id"]');
    var priceSlot = bar.querySelector('[data-brf-sticky-price]');
    var btn = bar.querySelector('[data-brf-sticky-btn]');
    var thumb = bar.querySelector('[data-brf-sab-top]');
    var opts = bar.querySelector('[data-brf-sab-opts]');
    var priceList = info.querySelector('.product-form__info-content .price-list');
    var imgs = {}; try { imgs = JSON.parse((doc.querySelector('[data-brf-sab-img]') || {}).textContent || '{}'); } catch (e) {}
    var phone = window.matchMedia('(max-width: 767px)');
    var CHEV = '<svg viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

    /* ---- the option groups on the page (radios or a dropdown) ---- */
    function groups(){
      return [].slice.call(form.querySelectorAll('.product-form__option[data-selector-type]')).map(function(g, pos){
        var nameEl = g.querySelector('.product-form__option-name');
        var name = nameEl ? (nameEl.childNodes[0] ? nameEl.childNodes[0].textContent : nameEl.textContent).replace(/:\s*$/, '').trim() : 'Option';
        var sel = g.querySelector('select'), values = [];
        if (sel) {
          [].forEach.call(sel.options, function(o){ values.push({v: o.value, label: o.textContent.trim(), on: o.selected, pick: function(){ sel.value = o.value; sel.dispatchEvent(new Event('change', {bubbles: true})); }}); });
        } else {
          [].forEach.call(g.querySelectorAll('input[type="radio"]'), function(r){
            var lab = r.id ? form.querySelector('label[for="' + r.id + '"]') : null;
            values.push({v: r.value, label: r.value, on: r.checked, lab: lab, pick: function(){ if (!r.checked) r.click(); }});
          });
        }
        return {el: g, pos: pos, name: name, type: g.getAttribute('data-selector-type'), values: values};
      }).filter(function(g){ return g.values.length > 1; });
    }
    /* a plain, standard colour dot worked out from the colour's name (not the fabric's own swatch photo) */
    var COLS = {black:'#111111',jet:'#111111',white:'#FFFFFF','off white':'#F4F1E8',ivory:'#FFFFF0',cream:'#F3E9D2',beige:'#E3D3B4',nude:'#E3BC9A',sand:'#D8C3A0',stone:'#C9BFAE',taupe:'#8B7D6B',camel:'#C19A6B',tan:'#D2B48C',
      khaki:'#B9A66B',brown:'#7B4A2A',chocolate:'#5A3218',coffee:'#6F4E37',mocha:'#7B5B47',rust:'#B7410E',copper:'#B87333',bronze:'#A97142',gold:'#D4AF37',mustard:'#D9A51E',lemon:'#FFF44F',yellow:'#F7D21E',
      orange:'#F28C28',peach:'#F7B89A',coral:'#F27B6B',salmon:'#F59A8A',red:'#D32F2A',scarlet:'#E3241B',cherry:'#C2182B',wine:'#722F37',burgundy:'#800020',maroon:'#7A1F2B',claret:'#7F1734',
      pink:'#F4A6C1','baby pink':'#F8C8DC','light pink':'#F8C8DC','hot pink':'#FF4FA0','dusty pink':'#D8A1A8',blush:'#F2C6C2',rose:'#E8A0B0',cerise:'#DE3163',fuchsia:'#E0218A',magenta:'#D0167E',
      lilac:'#C8A2C8',lavender:'#B9A7E0',mauve:'#B784A7',purple:'#6A3FA0',plum:'#6E2C5E',violet:'#7F4FC9',aubergine:'#472C4C',
      blue:'#2F6FD0','royal blue':'#2851C7','royal':'#2851C7',navy:'#1F2A57','navy blue':'#1F2A57','baby blue':'#A9CCEB','light blue':'#A9CCEB','sky blue':'#7EC3EA',sky:'#7EC3EA',cobalt:'#1F4FB5',denim:'#4A6A94',
      petrol:'#1F5F6B',teal:'#16808A',turquoise:'#2EC4C6',aqua:'#5FD4D6',jade:'#2F9C78',mint:'#A8E6C8',sage:'#A3B49A',
      green:'#2E9A55','bottle green':'#0F4D2E','dark green':'#1E5631',emerald:'#0E8A5A',lime:'#A6D93A',olive:'#6E7F2E','forest green':'#24502F',forest:'#24502F',
      grey:'#9A9A9A',gray:'#9A9A9A','light grey':'#C9C9C9','dark grey':'#555555',silver:'#C0C0C0',charcoal:'#36454F',slate:'#6D7B87'};
    var COLKEYS = Object.keys(COLS).sort(function(a, b){ return b.length - a.length; });
    var MULTI = 'background:conic-gradient(#E34B4B,#F2B33D,#4CB15F,#3E7DD6,#9B5BD3,#E34B4B)';
    function stdColour(name){
      var n = ' ' + String(name).toLowerCase().replace(/[^a-z ]+/g, ' ').replace(/\s+/g, ' ') + ' ';
      if (/ (multi|multicolou?r|rainbow|mixed|assorted) /.test(n)) return MULTI;
      for (var i = 0; i < COLKEYS.length; i++) if (n.indexOf(' ' + COLKEYS[i] + ' ') > -1) return 'background:' + COLS[COLKEYS[i]];
      return MULTI;
    }
    function isColour(g){ return g.type === 'color' || g.type === 'variant' || /colou?r/i.test(g.name); }
    function swatchStyle(val){ return stdColour(val.label); }
    function isSwatch(g){ return isColour(g); }

    /* sold out? (with the other options as currently chosen) */
    var vars = []; try { vars = JSON.parse((doc.querySelector('[data-brf-sab-vars]') || {}).textContent || '[]'); } catch (e) {}
    function soldOut(gs, g, val){
      if (!vars.length) return false;
      var picks = {};
      gs.forEach(function(o){ if (o !== g) { var s = o.values.filter(function(v){ return v.on; })[0]; if (s) picks[o.pos] = s.v; } });
      return !vars.some(function(x){
        if (!x.a || x.o[g.pos] !== val.v) return false;
        for (var q in picks) if (x.o[q] !== picks[q]) return false;
        return true;
      });
    }

    var lastSig = '';
    function paintOpts(){
      var gs = groups();
      var show = gs.slice(0, phone.matches ? 1 : 3);
      var sig = show.map(function(g){ var s = g.values.filter(function(v){ return v.on; })[0]; return g.name + '=' + (s ? s.v : ''); }).join('|') + '|' + window.innerWidth;
      if (sig === lastSig) return; lastSig = sig;
      opts.innerHTML = show.map(function(g, i){
        var s = g.values.filter(function(v){ return v.on; })[0];
        var dot = isSwatch(g) && s ? swatchStyle(s) : '';
        var more = isSwatch(g) ? '<span class="brf-sab__n">+' + (g.values.length - 1) + '</span>' : '';
        return '<button type="button" class="brf-sab__seg" data-i="' + i + '" aria-haspopup="dialog" aria-label="Change ' + esc(g.name) + ', now ' + esc(s ? s.label : 'not chosen') + '">' +
          '<span class="brf-sab__v">' + (dot ? '<i class="brf-sab__dot" style="' + esc(dot) + '"></i>' : '') + '<span>' + esc(s ? s.label : 'Choose') + '</span>' + more + '</span>' +
          '<span class="brf-sab__cap">' + esc(g.name) + (gs.length > show.length && i === show.length - 1 ? ' +' + (gs.length - show.length) : '') + CHEV + '</span></button>';
      }).join('');
    }

    /* ---- the sheet that opens from a segment ---- */
    var scrim = null, sheet = null;
    function closeSheet(){
      if (!sheet) return;
      var s = sheet, sc = scrim; sheet = scrim = null;
      s.classList.remove('is-on'); sc.classList.remove('is-on');
      setTimeout(function(){ s.remove(); sc.remove(); }, 380);
    }
    function openSheet(i){
      var gs = groups(); if (!gs[i]) return;
      closeSheet();
      scrim = doc.createElement('div'); scrim.className = 'brf-sab-scrim';
      sheet = doc.createElement('div'); sheet.className = 'brf-sab-sheet'; sheet.setAttribute('role', 'dialog');
      var title = gs.length > 1 ? 'Choose your options' : 'Choose ' + gs[0].name.toLowerCase();
      sheet.setAttribute('aria-label', title);
      var html = '<div class="brf-sab-sheet__grab"></div><div class="brf-sab-sheet__h"><span>' + esc(title) + '</span><button type="button" class="brf-sab-sheet__x" aria-label="Close">&times;</button></div><div class="brf-sab-sheet__body">';
      gs.forEach(function(g, gi){
        html += (gs.length > 1 ? '<p class="brf-sab-sheet__g" data-g="' + gi + '">' + esc(g.name) + '</p>' : '') + '<div class="brf-sab-sheet__list" data-g="' + gi + '">' + g.values.map(function(v, k){
          var dot = isSwatch(g) ? swatchStyle(v) : '', oos = soldOut(gs, g, v);
          return '<button type="button" class="brf-sab-sheet__o' + (v.on ? ' is-sel' : '') + (oos ? ' is-oos' : '') + '" data-k="' + k + '" aria-pressed="' + v.on + '"' + (oos ? ' aria-label="' + esc(v.label) + ', sold out"' : '') + '>' + (dot ? '<i class="brf-sab__dot" style="' + esc(dot) + '"></i>' : '') + '<span>' + esc(v.label) + '</span>' + (oos ? '<em>Sold out</em>' : '') + '</button>';
        }).join('') + '</div>';
      });
      sheet.innerHTML = html + '</div>';
      doc.body.appendChild(scrim); doc.body.appendChild(sheet);
      requestAnimationFrame(function(){ scrim.classList.add('is-on'); sheet.classList.add('is-on'); });
      var target = sheet.querySelector('.brf-sab-sheet__g[data-g="' + i + '"]');
      if (target && i > 0) setTimeout(function(){ var body = sheet && sheet.querySelector('.brf-sab-sheet__body'); if (body) body.scrollTop = target.offsetTop - body.offsetTop - 4; }, 30);
      scrim.addEventListener('click', closeSheet);
      sheet.querySelector('.brf-sab-sheet__x').addEventListener('click', closeSheet);
      sheet.addEventListener('click', function(e){
        var o = e.target.closest('.brf-sab-sheet__o'); if (!o) return;
        var list = o.parentNode, g = groups()[+list.getAttribute('data-g')]; if (!g) return;
        var v = g.values[+o.getAttribute('data-k')]; if (!v) return;
        [].forEach.call(list.querySelectorAll('.brf-sab-sheet__o'), function(x){ x.classList.toggle('is-sel', x === o); x.setAttribute('aria-pressed', x === o); });
        v.pick();
        setTimeout(function(){
          sync();
          if (gs.length === 1) { closeSheet(); return; }
          var now = groups();
          [].forEach.call(sheet ? sheet.querySelectorAll('.brf-sab-sheet__list') : [], function(l){
            var gg = now[+l.getAttribute('data-g')]; if (!gg) return;
            [].forEach.call(l.querySelectorAll('.brf-sab-sheet__o'), function(b){
              var vv = gg.values[+b.getAttribute('data-k')]; if (!vv) return;
              var oos = soldOut(now, gg, vv); b.classList.toggle('is-oos', oos);
              var em = b.querySelector('em'); if (oos && !em) b.insertAdjacentHTML('beforeend', '<em>Sold out</em>'); else if (!oos && em) em.remove();
            });
          });
        }, 220);
      });
      var first = sheet.querySelector('[data-g="' + i + '"] .is-sel') || sheet.querySelector('.brf-sab-sheet__o'); if (first) setTimeout(function(){ try { first.focus({preventScroll: true}); } catch (e) {} }, 60);
    }
    opts.addEventListener('click', function(e){ var s = e.target.closest('.brf-sab__seg'); if (s) openSheet(+s.getAttribute('data-i')); });
    doc.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeSheet(); });
    thumb.addEventListener('click', function(){
      var g = doc.querySelector('.product-gallery') || doc.querySelector('.product-block-list__item--gallery');
      if (g) g.scrollIntoView({behavior: 'smooth', block: 'start'}); else window.scrollTo({top: 0, behavior: 'smooth'});
    });

    /* ---- keep everything in step with the page ---- */
    var lastId = null, addedUntil = 0, pendingAt = 0;
    function sync(){
      var p = priceList ? priceList.querySelector('.price') : null;
      priceSlot.textContent = p ? p.textContent.trim() : '';
      btn.disabled = !!mainBtn.disabled;
      var lbl = btn.querySelector('.brf-sab__lbl');
      var done = Date.now() < addedUntil;
      btn.classList.toggle('brf-added', done);
      if (lbl) {
        var t = done ? 'Added to bag' : mainBtn.disabled ? (mainBtn.textContent.trim() || 'Sold out') : 'Add to bag';
        if (lbl.textContent !== t) lbl.textContent = t;
        lbl.classList.toggle('is-added', done);
      }
      var id = idEl && idEl.value;
      if (id && id !== lastId) {
        var src = imgs[id];
        var im = thumb.querySelector('img');
        if (src && im && im.getAttribute('src') !== src) {
          im.src = src; thumb.classList.remove('is-swap'); void thumb.offsetWidth; thumb.classList.add('is-swap');
        }
        lastId = id;
      }
      paintOpts();
    }
    sync();
    setInterval(function(){ if (!doc.hidden) sync(); }, 400);
    if (window.MutationObserver) {
      var mo = new MutationObserver(sync);
      if (priceList) mo.observe(priceList, {childList: true, subtree: true, characterData: true});
      mo.observe(mainBtn, {attributes: true, attributeFilter: ['disabled', 'class']});
    }
    form.addEventListener('change', function(){ setTimeout(sync, 30); });
    window.addEventListener('resize', function(){ lastSig = ''; paintOpts(); }, {passive: true});

    /* Phones: the bar floats whenever the real button is off screen (above or below), so Add to bag is always one tap away.
       Larger screens: only once you've scrolled past it. */
    var io = new IntersectionObserver(function(entries){
      var e = entries[0];
      var past = !e.isIntersecting && (phone.matches || e.boundingClientRect.top < 0);
      bar.hidden = false;
      bar.classList.toggle('is-visible', past);
      doc.body.classList.toggle('brf-sticky-on', past);
      if (!past) closeSheet();
    }, {threshold: 0});
    io.observe(mainBtn);
    /* ---- quantity box: kept in step with the page's own quantity (select 1–10+, or a box after "10+") ---- */
    var qWrap = bar.querySelector('[data-brf-sab-qty]'), qIn = qWrap && qWrap.querySelector('.brf-sab__in');
    var stock = {}; try { stock = JSON.parse((doc.getElementById('brf-v3-stock') || {}).textContent || '{}'); } catch (e) {}
    function mainQ(){ return form.querySelector('[name="quantity"]'); }
    function capQ(){ var m = idEl && stock[idEl.value]; return m != null && m > 0 ? m : 999; }
    function getMain(){ var q = mainQ(); return q ? Math.max(1, parseInt(q.value, 10) || 1) : 1; }
    function setMain(v){
      var q = mainQ(); if (!q || q.type === 'hidden' && q.value == v) return;
      if (q.tagName === 'SELECT') {
        var has = [].some.call(q.options, function(o){ return o.value === String(v) && o.textContent.indexOf('+') < 0; });
        if (has) { q.value = String(v); q.dispatchEvent(new Event('change', {bubbles: true})); return; }
        /* more than the list holds: pick "10+" so the theme swaps in its own box, then fill it */
        if ([].some.call(q.options, function(o){ return o.value === '10'; })) { q.value = '10'; q.dispatchEvent(new Event('change', {bubbles: true})); q = mainQ(); }
        if (!q || q.tagName === 'SELECT') return;
      }
      q.value = String(v); q.dispatchEvent(new Event('input', {bubbles: true}));
    }
    var lastMainQ = getMain();
    function paintQ(){
      if (!qIn) return;
      var cap = capQ(), v = Math.min(Math.max(1, parseInt(qIn.value, 10) || 1), cap);
      qWrap.querySelector('[data-d="-1"]').disabled = v <= 1;
      qWrap.querySelector('[data-d="1"]').disabled = v >= cap;
      return v;
    }
    function setBarQ(v, push){
      if (!qIn) return;
      v = Math.min(Math.max(1, v || 1), capQ());
      if (doc.activeElement !== qIn || push) qIn.value = String(v);
      paintQ();
      if (push) { setMain(v); lastMainQ = getMain(); }
    }
    if (qIn) {
      qWrap.addEventListener('click', function(e){
        var b = e.target.closest('.brf-sab__step'); if (!b || b.disabled) return;
        setBarQ((parseInt(qIn.value, 10) || 1) + (+b.getAttribute('data-d')), true);
      });
      qIn.addEventListener('input', function(){ var v = parseInt(qIn.value, 10); if (v > 0) { if (v > capQ()) qIn.value = String(capQ()); setMain(Math.min(v, capQ())); lastMainQ = getMain(); } paintQ(); });
      qIn.addEventListener('blur', function(){ setBarQ(parseInt(qIn.value, 10) || 1, true); });
      qIn.addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); qIn.blur(); } });
      /* the page's quantity changed (or the variant's stock cap did): follow it */
      setInterval(function(){ if (doc.hidden || doc.activeElement === qIn) return; var m = getMain(); if (m !== lastMainQ) { lastMainQ = m; setBarQ(m); } else paintQ(); }, 400);
      setBarQ(lastMainQ);
    }

    btn.addEventListener('click', function(){
      if (mainBtn.disabled) return;
      if (qIn) { setBarQ(parseInt(qIn.value, 10) || 1, true); }
      pendingAt = Date.now(); mainBtn.click();
    });
    mainBtn.addEventListener('click', function(){ pendingAt = Date.now(); });

    /* R7. The bar's button says "Added to bag ✓" for a moment after an add (phones and desktop) */
    function markAdded(){
      if (!pendingAt || Date.now() - pendingAt > 10000) return;
      pendingAt = 0; addedUntil = Date.now() + 2200;
      sync(); btn.classList.remove('is-pop'); void btn.offsetWidth; btn.classList.add('is-pop');
      setTimeout(sync, 2250);
    }
    window.addEventListener('product:added', markAdded, true);
    doc.addEventListener('brf:bag-added-mobile', markAdded);
    /* fallback: the bag count goes up */
    var cnt = doc.querySelector('.header__cart-count');
    if (cnt && window.MutationObserver) {
      var lastN = parseInt(cnt.textContent, 10) || 0;
      new MutationObserver(function(){ var n = parseInt(cnt.textContent, 10) || 0; if (n > lastN) markAdded(); lastN = n; })
        .observe(cnt, {childList: true, characterData: true, subtree: true});
    }
  })();
  </script>
{%- endif -%}
