  html .brf-trust-chips .brf-glass-chip svg{position:relative;flex:0 0 32px;width:32px;height:32px;padding:7px;border-radius:50%;color:#fff!important;
    background:linear-gradient(180deg,#1DAE65 0%,#149954 55%,#0F884A 100%);box-shadow:inset 0 1px 0 rgba(255,255,255,.4),inset 0 -1px 0 rgba(0,60,28,.25),0 4px 10px -4px rgba(20,153,84,.7)}
  html .brf-trust-chips .brf-glass-chip span{position:relative}
  html .brf-trust-chips .brf-gift-chip{grid-column:1/-1;font-weight:500;color:#3A3835!important}
  html .brf-trust-chips .brf-gift-chip b{font-weight:700;color:#1D1D1F}
  @media (max-width:767px){html .brf-trust-chips .brf-glass-chip{gap:8px;min-height:48px;padding:7px 10px 7px 7px;border-radius:18px;font-size:12.5px}html .brf-trust-chips .brf-glass-chip svg{flex-basis:28px;width:28px;height:28px;padding:6px}}
