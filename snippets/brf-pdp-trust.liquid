      qWrap.classList.remove('is-max'); void qWrap.offsetWidth; qWrap.classList.add('is-max');
      clearTimeout(tipT); tipT = setTimeout(function(){ tip.classList.remove('is-on'); qWrap.classList.remove('is-max'); }, 2600);
    }
    function getMain(){ var q = mainQ(); return q ? Math.max(1, parseInt(q.value, 10) || 1) : 1; }
    /* R9. Only touch the page's quantity when the number really differs, never re-trigger ourselves,
       and never leave the page's box focused (that popped the phone keyboard up on its own). */
    var syncing = false;
    function fire(el, type){ syncing = true; try { el.dispatchEvent(new Event(type, {bubbles: true})); } finally { syncing = false; } }
    function setMain(v){
      var q = mainQ(); if (!q || String(q.value) === String(v)) return;
      if (q.tagName === 'SELECT') {
        var has = [].some.call(q.options, function(o){ return o.value === String(v) && o.textContent.indexOf('+') < 0; });
        if (has) { q.value = String(v); fire(q, 'change'); return; }
        /* more than the list holds: pick "10+" so the theme swaps in its own box, then fill it */
        if (![].some.call(q.options, function(o){ return o.value === '10'; })) return;
        var had = doc.activeElement;
        q.value = '10'; fire(q, 'change'); q = mainQ();
        if (q && doc.activeElement === q && had !== q) { q.blur(); if (had === qIn) try { qIn.focus({preventScroll: true}); } catch (e) {} }
        if (!q || q.tagName === 'SELECT') return;
      }
      q.value = String(v); fire(q, 'input');
    }
    var lastMainQ = getMain();
    function paintQ(){
      if (!qIn) return;
      var cap = capQ(), v = Math.min(Math.max(1, parseInt(qIn.value, 10) || 1), cap);
      qWrap.querySelector('[data-d="-1"]').disabled = v <= 1;
      qWrap.querySelector('[data-d="1"]').classList.toggle('is-cap', v >= cap);
      return v;
    }
    function setBarQ(v, push){
      if (!qIn) return;
      v = Math.min(Math.max(1, v || 1), capQ());
      if (doc.activeElement !== qIn || push) qIn.value = String(v);
      paintQ();
      if (push) { setMain(v); lastMainQ = getMain(); }
    }
    if (qIn) {
      qWrap.addEventListener('click', function(e){
        var b = e.target.closest('.brf-sab__step'); if (!b) return;
        stepAt = Date.now();
        var cur = parseInt(qIn.value, 10) || 1, d = +b.getAttribute('data-d');
        if (d > 0 && cur >= capQ()) { capTip(); return; }
        if (b.disabled) return;
        setBarQ(cur + d, true);
        if (d > 0 && cur + d >= capQ() && leftNow() != null) capTip();
      });
      qIn.addEventListener('input', function(){ var v = parseInt(qIn.value, 10); if (v > 0) { if (v > capQ()) { qIn.value = String(capQ()); capTip(); } setMain(Math.min(v, capQ())); lastMainQ = getMain(); } paintQ(); });
      qIn.addEventListener('blur', function(){ setBarQ(parseInt(qIn.value, 10) || 1, true); });
      qIn.addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); qIn.blur(); } });
      /* the page's quantity changed (or the variant's stock cap did): follow it */
      setInterval(function(){ if (doc.hidden || doc.activeElement === qIn) return; var m = getMain(); if (m !== lastMainQ) { lastMainQ = m; setBarQ(m); } else paintQ(); }, 400);
      setBarQ(lastMainQ);
      loadBag();
      window.addEventListener('product:added', function(){ setTimeout(loadBag, 400); }, true);
      doc.addEventListener('brf:bag-added-mobile', function(){ setTimeout(loadBag, 400); });
      /* the variant changed: re-check the cap */
      form.addEventListener('change', function(e){
        if (syncing || (e.target && e.target.name === 'quantity')) return;
        setTimeout(function(){ var v = parseInt(qIn.value, 10) || 1; if (v > capQ()) setBarQ(v, true); else paintQ(); }, 60);
      });
    }

    /* phones: a tap on Add right after − / + is a slipped finger, not a real add */
    btn.addEventListener('click', function(e){ if (phone.matches && Date.now() - stepAt < 450) { e.preventDefault(); e.stopImmediatePropagation(); } });
    btn.addEventListener('click', function(){
      if (mainBtn.disabled) return;
      if (qIn) { if (leftNow() === 0) { capTip(); return; } setBarQ(parseInt(qIn.value, 10) || 1, true); }
      pendingAt = Date.now(); mainBtn.click();
    });
    mainBtn.addEventListener('click', function(){ pendingAt = Date.now(); });

    /* R7. The bar's button says "Added to bag ✓" for a moment after an add (phones and desktop) */
    function markAdded(){
      if (!pendingAt || Date.now() - pendingAt > 10000) return;
      pendingAt = 0; addedUntil = Date.now() + 2200;
      sync(); btn.classList.remove('is-pop'); void btn.offsetWidth; btn.classList.add('is-pop');
      setTimeout(sync, 2250);
    }
    window.addEventListener('product:added', markAdded, true);
    doc.addEventListener('brf:bag-added-mobile', markAdded);
    /* fallback: the bag count goes up */
    var cnt = doc.querySelector('.header__cart-count');
    if (cnt && window.MutationObserver) {
      var lastN = parseInt(cnt.textContent, 10) || 0;
      new MutationObserver(function(){ var n = parseInt(cnt.textContent, 10) || 0; if (n > lastN) markAdded(); lastN = n; })
        .observe(cnt, {childList: true, characterData: true, subtree: true});
    }
  })();
  </script>
