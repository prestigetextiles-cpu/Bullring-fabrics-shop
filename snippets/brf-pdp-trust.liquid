<style>
  /* Frosted glass tiles (Control Center style): soft grey glass, bright white rim, green icon dot */
  html .brf-trust-chips{gap:10px}
  html .brf-trust-chips .brf-glass-chip{position:relative;isolation:isolate;gap:10px;min-height:52px;padding:8px 14px 8px 8px;border:0;border-radius:20px;overflow:hidden;font-size:13px;font-weight:600;color:#1D1D1F!important;
    background:linear-gradient(180deg,rgba(255,255,255,.66) 0%,rgba(226,221,213,.58) 100%);-webkit-backdrop-filter:saturate(170%) blur(22px);backdrop-filter:saturate(170%) blur(22px);
    box-shadow:inset 0 1.5px 0 #fff,inset 1.5px 0 0 rgba(255,255,255,.8),inset 0 0 0 1px rgba(255,255,255,.5),0 0 0 1px rgba(29,29,31,.08),0 12px 26px -16px rgba(29,29,31,.38),0 2px 6px -3px rgba(29,29,31,.12)!important}
