  /* ================= 2. Quick view ================= */
  function initQuickView(modal){
    var g = modal.querySelector('.product-gallery');
    if (!g || g.__brfQv) return;
    var thumbs = g.querySelectorAll('.product-gallery__thumbnail');
    var wrap = g.querySelector('.product-gallery__carousel-wrapper') || g;
    g.__brfQv = true;
    setTimeout(function(){ window.dispatchEvent(new Event('resize')); }, 60);
    if (thumbs.length < 2) return;
    var count = doc.createElement('span'); count.className = 'brf-qv__count';
    function cur(){ for (var i = 0; i < thumbs.length; i++) if (thumbs[i].classList.contains('is-nav-selected')) return i; return 0; }
    function paint(){ count.textContent = (cur() + 1) + ' / ' + thumbs.length; }
    function go(d){ var i = (cur() + d + thumbs.length) % thumbs.length; thumbs[i].click(); setTimeout(paint, 30); }
    ['prev', 'next'].forEach(function(dir){
      var b = doc.createElement('button');
      b.type = 'button'; b.className = 'brf-qv__arrow brf-qv__arrow--' + dir;
      b.setAttribute('aria-label', dir === 'prev' ? 'Previous image' : 'Next image');
      b.innerHTML = dir === 'prev' ? ARROW_L : ARROW_R;
      b.addEventListener('click', function(e){ e.preventDefault(); e.stopPropagation(); go(dir === 'prev' ? -1 : 1); });
      wrap.appendChild(b);
    });
    wrap.appendChild(count); paint();
    modal.addEventListener('keydown', function(e){
      if (e.target.closest('input,select,textarea')) return;
      if (e.key === 'ArrowLeft') go(-1); else if (e.key === 'ArrowRight') go(1);
