    'beige':'#E4D5B7','khaki':'#C3B091','olive':'#7C7C32','lime':'#9ACD32','green':'#2E8B57','blue':'#2F6FD0','pink':'#F28CB1','orange':'#F57C1F',
    'yellow':'#F7D23E','grey':'#9E9E9E','gray':'#9E9E9E','coral':'#FF7F66','maroon':'#7A1F2B','magenta':'#E0218A','violet':'#8F5BD8','lavender':'#C9B8E8',
    'tan':'#C8A06B','chocolate':'#5A3A22','cappuccino':'#A6816B','biscuit':'#D8B98A','mushroom':'#A89A8A','heather':'#B7A1C1','lagoon':'#2BA3B3',
    'navy blue':'#1F2A44','sky blue':'#87CEEB','bright red':'#E3242B','bright pink':'#FF4FA3','bright blue':'#1F75FE','bright green':'#2ECC40','bright yellow':'#FFE11A'
  };
  var MULTI = /\b(multi|multicolou?r|rainbow|assorted|mixed|bright|brights|pastel|pastels|mix|various)\b/i;
  function cssOk(c){ return window.CSS && CSS.supports && CSS.supports('color', c); }
  function norm(s){ return s.toLowerCase().replace(/\(.*?\)/g, ' ').replace(/[^a-z\s]/g, ' ').replace(/\s+/g, ' ').trim(); }
  function colourOf(name){
    var n = norm(name);
    if (!n) return null;
    if (NAMED[n]) return NAMED[n];
    if (cssOk(n.replace(/ /g, ''))) return n.replace(/ /g, '');
    var words = n.split(' ');
    for (var len = Math.min(3, words.length); len >= 1; len--) {
      for (var i = words.length - len; i >= 0; i--) {
        var ph = words.slice(i, i + len).join(' ');
        if (NAMED[ph]) return NAMED[ph];
        if (len === 1 && ph.length > 2 && cssOk(ph) && !/^(transparent|currentcolor|inherit|initial|unset)$/.test(ph)) return ph;
      }
    }
    return null;
  }
  function paintSwatch(label, all){
    var name = label.getAttribute('title') || label.getAttribute('data-tooltip') || '';
    if (!name) { var inp0 = label.previousElementSibling; name = inp0 && inp0.value || ''; }
    if (!name) return;
    var raw = name.trim(), bg = null;
    var shot = raw.match(/^(.+?)\s+shot\s+(.+)$/i);
    var parts = raw.split(/\s*(?:\/|&|\+|\band\b|\bwith\b|,)\s*/i).filter(Boolean);
    var tail = raw.split(/\s+-\s+/).pop();
    var inp = label.previousElementSibling && label.previousElementSibling.matches('input') ? label.previousElementSibling : doc.getElementById(label.getAttribute('for'));
    var imgUrl = inp && inp.getAttribute('data-image-url');
    var uniqueImg = imgUrl && all.filter(function(u){ return u === imgUrl; }).length === 1;
    if (shot) {
      var a = colourOf(shot[1]), b = colourOf(shot[2]);
      if (a && b) bg = 'linear-gradient(135deg,' + a + ' 0 45%,' + b + ' 55% 100%)';
    }
    if (!bg && /\s-\s/.test(raw) && uniqueImg) bg = 'img';
    if (!bg && parts.length > 1) {
      var cs = parts.map(colourOf).filter(Boolean);
      if (cs.length > 1) bg = cs.length === 2 ? 'linear-gradient(135deg,' + cs[0] + ' 0 50%,' + cs[1] + ' 50% 100%)'
        : 'conic-gradient(' + cs.map(function(c, i){ return c + ' ' + Math.round(i * 360 / cs.length) + 'deg ' + Math.round((i + 1) * 360 / cs.length) + 'deg'; }).join(',') + ')';
    }
    if (!bg) { var c1 = colourOf(tail) || colourOf(raw); if (c1) bg = c1; }
    if (!bg && uniqueImg) bg = 'img';
    if (!bg && MULTI.test(raw)) bg = /pastel/i.test(raw)
      ? 'conic-gradient(#F8C8DC,#FDF3A7,#C8E6C0,#BFD9F2,#D8C8EC,#F8C8DC)'
      : 'conic-gradient(#E3242B,#F7D23E,#2ECC40,#1F75FE,#8F5BD8,#E3242B)';
    if (!bg && imgUrl) bg = 'img';
    if (!bg) bg = 'linear-gradient(135deg,#E9E4DA,#CFC6B8)';
    if (bg === 'img') {
      label.classList.add('brf-sw--img');
      label.style.backgroundImage = 'url("' + imgUrl.replace('{width}', '80') + '")';
      label.style.backgroundColor = '#EEE';
    } else if (/gradient/.test(bg)) {
      label.style.backgroundImage = bg; label.style.backgroundColor = 'transparent';
    } else {
      label.style.backgroundColor = bg;
    }
  }
  function fixSwatches(scope){
    var labels = (scope || doc).querySelectorAll('label.color-swatch__item:not([data-brf-sw])');
    if (!labels.length) return;
    labels.forEach(function(label){
      label.setAttribute('data-brf-sw', '1');
      if (label.style.backgroundColor || label.style.backgroundImage) return;
      var list = label.closest('.color-swatch-list') || label.parentNode.parentNode;
      var all = Array.prototype.map.call(list.querySelectorAll('input[data-image-url]'), function(i){ return i.getAttribute('data-image-url'); });
      paintSwatch(label, all);
    });
  }

  /* ================= 10. View more inside tabs ================= */
  function initExpandable(){
    doc.querySelectorAll('.expandable-content').forEach(function(ec){
      var tg = ec.querySelector('.expandable-content__toggle');
      if (tg && tg.parentElement !== ec) ec.appendChild(tg);
      if (ec.__brfEc) return; ec.__brfEc = true;
      function check(){
        if (ec.getAttribute('aria-expanded') === 'true') { ec.classList.remove('brf-ec--short'); return; }
        var limit = parseFloat(getComputedStyle(ec).maxHeight);
        ec.classList.remove('brf-ec--short');
        if (!isFinite(limit)) return;
        var short = ec.scrollHeight <= limit + 24;
        if (short !== ec.classList.contains('brf-ec--short')) ec.classList.toggle('brf-ec--short', short);
      }
      ec.addEventListener('click', function(e){ if (e.target.closest('.pt-tab-btn, [role="tab"], button:not(.expandable-content__toggle)')) setTimeout(check, 60); });
      check(); setTimeout(check, 1200);
    });
  }

  /* ================= 11. Filter row cue ================= */
  function initPillRow(){
    var row = doc.querySelector('.brf-fbar__pills');
    if (!row || row.__brfProw) return;
    row.__brfProw = true;
    row.classList.add('brf-prow');
    var host = row.parentElement;
    if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
    function mk(dir){
      var b = doc.createElement('button'); b.type = 'button';
      b.className = 'brf-prow__btn brf-prow__btn--' + dir; b.tabIndex = -1;
      b.setAttribute('aria-label', dir === 'r' ? 'More filters' : 'Previous filters');
      b.innerHTML = dir === 'r' ? ARROW_R : ARROW_L;
      b.addEventListener('click', function(e){ e.stopPropagation(); row.scrollBy({left: (dir === 'r' ? 1 : -1) * row.clientWidth * .7, behavior: 'smooth'}); });
      host.appendChild(b); return b;
    }
    var bl = mk('l'), br = mk('r');
    function place(){
      bl.style.left = (row.offsetLeft - 2) + 'px';
      br.style.left = (row.offsetLeft + row.clientWidth - 30) + 'px';
      bl.style.top = br.style.top = (row.offsetTop + row.offsetHeight / 2) + 'px';
      update();
    }
    function update(){
      var max = row.scrollWidth - row.clientWidth;
      var l = row.scrollLeft > 4, r = max > 4 && row.scrollLeft < max - 4;
      if (row.classList.contains('can-l') !== l) row.classList.toggle('can-l', l);
      if (row.classList.contains('can-r') !== r) row.classList.toggle('can-r', r);
      bl.classList.toggle('is-on', l); br.classList.toggle('is-on', r);
    }
    row.addEventListener('scroll', update, {passive: true});
    window.addEventListener('resize', place, {passive: true});
    if (window.ResizeObserver) new ResizeObserver(place).observe(row);
    place(); setTimeout(place, 400);
  }

  /* ================= 8. Filters keep your place ================= */
  function barEl(){ return doc.querySelector('[data-brf-fbar]'); }
  function remember(e){
    var bar = barEl(); if (!bar) return;
    var t = e.target;
    if (e.type === 'click' && !(t.closest && t.closest('a[href]'))) return;
    var open = bar.querySelector('.brf-panel:not([hidden])');
    var panel = open && /^f\d+$/.test(open.getAttribute('data-brf-panel')) && t.closest && t.closest('.brf-opt') ? open.getAttribute('data-brf-panel') : '';
    ss('brfFilterNav', JSON.stringify({p: location.pathname, y: Math.round(window.scrollY), panel: panel, t: Date.now()}));
  }
  function bindRemember(){
    var bar = barEl();
    if (!bar || bar.__brfRem) return;
    bar.__brfRem = true;
    bar.addEventListener('click', remember, true);
    bar.addEventListener('change', remember, true);
    bar.addEventListener('submit', remember, true);
  }
  function targetY(){
    var bar = barEl(); if (!bar) return null;
    var el = doc.querySelector('.brf-fstick__sentinel') || bar;
    var hdr = doc.getElementById('shopify-section-header');
    var off = 0;
    if (hdr) { var ps = getComputedStyle(hdr).position; if (ps === 'sticky' || ps === 'fixed') off = hdr.offsetHeight + Math.min(0, parseFloat(getComputedStyle(hdr).top) || 0); }
    /* the slim glass capsule hangs a little below the header box: leave a comfortable gap under it */
    if (document.documentElement.classList.contains('brf-hc-on')) off += 34;
    return Math.max(0, Math.round(el.getBoundingClientRect().top + window.scrollY - off));
  }
  var restoring = null;
  function restoreFilterPos(final){
    var raw = ss('brfFilterNav'); if (!raw) return;
    var s; try { s = JSON.parse(raw); } catch (e) { ss('brfFilterNav', null); return; }
    if (!s || s.p !== location.pathname || Date.now() - s.t > 60000) { ss('brfFilterNav', null); return; }
    if (restoring !== null && Math.abs(window.scrollY - restoring) > 40) { ss('brfFilterNav', null); return; } /* the shopper scrolled: stop helping */
    var ty = targetY(); if (ty === null) return;
    var y = Math.min(s.y, ty);
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, y); restoring = y;
    if (final) {
      ss('brfFilterNav', null);
      if (s.panel && window.matchMedia('(min-width: 750px)').matches) {
        var op = doc.querySelector('[data-brf-open="' + s.panel + '"]');
        if (op && op.getAttribute('aria-expanded') !== 'true') setTimeout(function(){ op.click(); }, 120);
      }
    }
  }
  /* smooth cross-fade between filter results where the browser supports it */
  window.addEventListener('pageswap', function(e){
    if (e.viewTransition && !ss('brfFilterNav')) e.viewTransition.skipTransition();
  });
  window.addEventListener('pagereveal', function(e){
    if (e.viewTransition && !ss('brfFilterNav')) e.viewTransition.skipTransition();
  });

  /* ================= 12. Spring open for tabs ================= */
  function springOpen(target){
    if (reduce || !target || !target.animate) return;
    var inner = target.querySelector('.card__collapsible-content') || target;
    inner.animate([
      {opacity: 0, transform: 'translateY(-10px) scale(.985)'},
      {opacity: 1, transform: 'none'}
    ], {duration: 560, easing: 'cubic-bezier(.34,1.45,.64,1)'});
  }
  doc.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('.card__collapsible-button, .brf-tab-toggle, .pt-tab-btn');
    if (!b) return;
    var was = b.getAttribute('aria-expanded');
    setTimeout(function(){
      if (b.classList.contains('pt-tab-btn')) {
        var box = b.closest('.pt-tabs-container');
        var p = box && box.querySelector('.pt-panel.active, .pt-panel.is-active, .pt-panel[aria-hidden="false"], .pt-panel:not([hidden])');
        if (p) springOpen(p);
        return;
      }
      if (was !== 'true' && b.getAttribute('aria-expanded') === 'true') {
        var id = b.getAttribute('aria-controls');
        springOpen(id && doc.getElementById(id));
      }
    }, 0);
  });

  /* ================= 13. Dispatch countdown turns red in the last 4 hours ================= */
  function urgency(){
    doc.querySelectorAll('[data-brf-dispatch]').forEach(function(box){
      var h = box.querySelector('[data-h]');
      var on = box.classList.contains('is-live') && h && parseInt(h.textContent, 10) < 4;
      if (box.classList.contains('brf-urgent') !== on) box.classList.toggle('brf-urgent', on);
    });
    doc.querySelectorAll('[data-brf-mc-dispatch]').forEach(function(el){
      var st = el.querySelector('[data-brf-mc-dispatch-text] strong');
      var on = false;
      if (st && /\d+\s*[hms]/.test(st.textContent)) { var mh = st.textContent.match(/(\d+)\s*h/); on = !mh || parseInt(mh[1], 10) < 4; }
      if (el.classList.contains('brf-urgent') !== on) el.classList.toggle('brf-urgent', on);
    });
  }
  setInterval(urgency, 1000);

  /* ================= 8b. Filters update in place (no page reload) ================= */
  var filtering = false;
  function sameOrigin(u){ try { var x = new URL(u, location.href); return x.origin === location.origin ? x : null; } catch (e) { return null; } }
  function canAjax(){ return !!(barEl() && doc.querySelector('.collection__dynamic-part') && barEl().closest('.brf-fstick') && !doc.querySelector('.brf-fstick .collection__dynamic-part')); }
  function ajaxFilter(url, opts){
    opts = opts || {};
    if (filtering) return;
    filtering = true;
    root.classList.add('brf-filtering');
    var bar = barEl();
    var openP = bar && bar.querySelector('.brf-panel:not([hidden])');
    var reopen = opts.keepPanel && openP && /^f\d+$/.test(openP.getAttribute('data-brf-panel')) && window.matchMedia('(min-width: 750px)').matches ? openP.getAttribute('data-brf-panel') : '';
    fetch(url, {credentials: 'same-origin', headers: {'X-Requested-With': 'XMLHttpRequest'}})
      .then(function(r){ if (!r.ok) throw 0; return r.text(); })
      .then(function(html){
        var nd = new DOMParser().parseFromString(html, 'text/html');
        var nBar = nd.querySelector('[data-brf-fbar]'), nDyn = nd.querySelector('.collection__dynamic-part');
        var oBar = barEl(), oDyn = doc.querySelector('.collection__dynamic-part');
        if (!nBar || !nDyn || !oBar || !oDyn) throw 0;
        /* the bar's own script: find it in the new page so its buttons work again */
        var code = '';
        nd.querySelectorAll('script').forEach(function(s){ if (!code && /data-brf-fbar/.test(s.textContent) && /brfOpen/.test(s.textContent)) code = s.textContent; });
        root.classList.remove('brf-sheet-open');
        var nb = doc.importNode(nBar, true);
        oBar.replaceWith(nb);
        oDyn.innerHTML = nDyn.innerHTML; /* the theme listens on the section, so its buttons keep working */
        if (code) { var sc = doc.createElement('script'); sc.textContent = code; doc.body.appendChild(sc); sc.remove(); }
        if (nd.title) doc.title = nd.title;
        if (opts.push !== false) history.pushState({brfFilter: 1}, '', url);
        initPillRow(); bindRemember(); scan();
        if (window.lazySizes && lazySizes.loader) lazySizes.loader.checkElems();
        /* bring the top of the new results into view only if you were already past it */
        var ty = targetY();
        if (ty !== null && window.scrollY > ty + 2) window.scrollTo({top: ty, behavior: reduce ? 'auto' : 'smooth'});
        if (reopen) { var op = doc.querySelector('[data-brf-open="' + reopen + '"]'); if (op) setTimeout(function(){ op.click(); }, 30); }
        doc.dispatchEvent(new CustomEvent('brf:filtered'));
      })
      .catch(function(){ location.href = url; })
      .then(function(){ filtering = false; root.classList.remove('brf-filtering'); });
  }
  doc.addEventListener('click', function(e){
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    var a = e.target.closest && e.target.closest('[data-brf-fbar] a[href]');
    if (!a || !canAjax()) return;
    var u = sameOrigin(a.href);
    if (!u || u.pathname.indexOf('/collections/') !== 0) return;
    e.preventDefault();
    ss('brfFilterNav', null);
    ajaxFilter(u.href, {keepPanel: !!a.closest('.brf-panel')});
  });
  doc.addEventListener('change', function(e){
    var sw = e.target.closest && e.target.closest('[data-brf-stock]');
    if (!sw || !canAjax()) return;
    e.stopImmediatePropagation();
    try { sw.checked ? sessionStorage.removeItem('brfShowSoldOut') : sessionStorage.setItem('brfShowSoldOut', '1'); } catch (x) {}
    ajaxFilter(sw.checked ? sw.dataset.on : sw.dataset.off);
  }, true);
  doc.addEventListener('submit', function(e){
    var pf = e.target.closest && e.target.closest('[data-brf-price]');
    if (!pf || !canAjax()) return;
    e.preventDefault(); e.stopImmediatePropagation();
    var q = new URLSearchParams(location.search); q.delete('page');
    var mn = pf.elements.min.value.trim(), mx = pf.elements.max.value.trim();
    mn === '' ? q.delete(pf.dataset.minParam) : q.set(pf.dataset.minParam, mn);
    mx === '' ? q.delete(pf.dataset.maxParam) : q.set(pf.dataset.maxParam, mx);
    var s = q.toString();
    ajaxFilter(location.pathname + (s ? '?' + s : ''));
  }, true);
  window.addEventListener('popstate', function(){ if (canAjax()) ajaxFilter(location.href, {push: false}); });

  /* ================= 15. Instant +/- in the cart drawer and cart page ================= */
  var qtyTimers = {}, qtyBusy = {};
  function fmt(cents){
    var cur = (cartCache && cartCache.currency) || 'GBP';
    try { return new Intl.NumberFormat('en-GB', {style: 'currency', currency: cur}).format(cents / 100); } catch (e) { return '£' + (cents / 100).toFixed(2); }
  }
  function cartSectionRefresh(el){
    var sec = el.closest('.shopify-section');
    if (!sec || el.closest('.mini-cart')) { refreshCart(); return Promise.resolve(); }
    var id = sec.id.replace('shopify-section-', '');
    return fetch(location.pathname + '?section_id=' + encodeURIComponent(id), {credentials: 'same-origin'})
      .then(function(r){ if (!r.ok) throw 0; return r.text(); })
      .then(function(html){
        var d = new DOMParser().parseFromString(html, 'text/html');
        var n = d.getElementById(sec.id) || d.body.firstElementChild;
        if (n) sec.innerHTML = n.innerHTML;
        refreshCart();
      })
      .catch(function(){ location.reload(); });
  }
  doc.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('button[data-action="increase-quantity"], button[data-action="decrease-quantity"]');
    if (!b || b.disabled || !cartCache) return;
    var line = b.closest('.mini-cart__line-item, .line-item');
    if (!line || !(b.closest('.mini-cart') || b.closest('[class*="cart"]'))) return;
    var q = parseInt(b.getAttribute('data-quantity'), 10), key = b.getAttribute('data-line-id');
    if (!key || isNaN(q) || q < 1) return; /* removals keep the normal path (and the Undo bar) */
    var item = null;
    cartCache.items.forEach(function(it){ if (it.key === key) item = it; });
    if (!item) return;
    e.preventDefault(); e.stopImmediatePropagation();

    /* 1. show the change straight away */
    var input = line.querySelector('.quantity-selector__value');
    var prevQ = input ? parseInt(input.value, 10) || item.quantity : item.quantity;
    if (input) { input.value = q; input.setAttribute('data-current-value', q); }
    line.querySelectorAll('button[data-action="decrease-quantity"]').forEach(function(x){ x.setAttribute('data-quantity', q - 1); });
    line.querySelectorAll('button[data-action="increase-quantity"]').forEach(function(x){ x.setAttribute('data-quantity', q + 1); });
    var unit = item.final_line_price / item.quantity, unitWas = item.original_line_price / item.quantity;
    var prices = line.querySelectorAll('.mini-cart__price-list .price, .line-item__price-list .price, .line-item__line-price .price');
    if (prices[0]) prices[0].textContent = fmt(Math.round(unit * q));
    if (prices[1] && prices[1].classList.contains('price--compare') && item.variant_id) {
      var cmpUnit = unitWas; var lvl = prices[1].textContent; if (lvl) prices[1].textContent = fmt(Math.round(cmpUnit * q));
    }
    var delta = Math.round(unit * (q - prevQ));
    doc.querySelectorAll('.brf-mc__total span:last-child, [data-brf-cart-total]').forEach(function(t){
      var base = t.__brfBase != null ? t.__brfBase : cartCache.total_price;
      t.__brfBase = base + delta; t.textContent = fmt(t.__brfBase);
    });
    line.classList.add('brf-qty-pending');
    if (b.animate && !reduce) b.animate([{transform: 'scale(.86)'}, {transform: 'scale(1)'}], {duration: 260, easing: 'cubic-bezier(.34,1.56,.64,1)'});

    /* 2. sync quietly: rapid taps become one request */
    clearTimeout(qtyTimers[key]);
    qtyTimers[key] = setTimeout(function(){
      qtyBusy[key] = true;
      fetch('/cart/change.js', {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/json', 'Accept': 'application/json'}, body: JSON.stringify({id: key, quantity: q})})
        .then(function(r){ return r.json().then(function(j){ return {ok: r.ok, j: j}; }); })
        .then(function(res){
          if (!res.ok) { toast(esc(res.j.description || res.j.message || 'Could not update quantity'), null, true); }
          else cartCache = res.j;
          doc.querySelectorAll('.brf-mc__total span:last-child, [data-brf-cart-total]').forEach(function(t){ t.__brfBase = null; });
          return cartSectionRefresh(b.isConnected ? b : line);
        })
        .catch(function(){ cartSectionRefresh(line); })
        .then(function(){ qtyBusy[key] = false; line.classList.remove('brf-qty-pending'); });
    }, 350);
  }, true);

  /* ================= boot ================= */
  function scan(){
    fixSwatches();
    doc.querySelectorAll('.product-item__image-wrapper--with-secondary:not([data-brf-ci])').forEach(initCard);
    doc.querySelectorAll('.modal[id^="modal-quick-view"]').forEach(function(m){
      if (m.parentNode !== doc.body) doc.body.appendChild(m);
      if (m.querySelector('.product-gallery')) initQuickView(m);
    });
    initExpandable();
  }
  function boot(){
    scan(); initPillRow(); bindRemember(); watchCart(); celebrate();
  }
  restoreFilterPos(false);
  if (doc.readyState === 'loading') doc.addEventListener('DOMContentLoaded', function(){ boot(); restoreFilterPos(false); }); else boot();
  window.addEventListener('load', function(){ boot(); restoreFilterPos(true); });
  /* late content (quick view, recommendations, reviews): rescan, debounced; we never write to what we observe here */
  var st = 0;
  new MutationObserver(function(list){
    for (var i = 0; i < list.length; i++) {
      var n = list[i].target;
      if (n.nodeType === 1 && (n.closest('[data-brf-mc-dispatch]') || n.closest('.brf-undo') || n.classList.contains('brf-mc__free'))) continue;
      clearTimeout(st); st = setTimeout(scan, 200); return;
    }
  }).observe(doc.body, {childList: true, subtree: true});
})();
</script>
<style>@view-transition{navigation:auto}::view-transition-old(root),::view-transition-new(root){animation-duration:.28s}</style>
