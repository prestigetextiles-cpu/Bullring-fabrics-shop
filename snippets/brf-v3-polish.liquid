      var id = idEl.value, key = id + '|' + (sel ? sel.options.length : '');
      if (data.__last === key) return;
      var max = data.__stock[id];
      if (sel) {
        var val = parseInt(sel.value, 10) || 1, top = (max == null) ? 10 : Math.max(1, Math.min(max, 10)), html = '';
        for (var i = 1; i <= top; i++) html += '<option value="' + i + '">' + (i === 10 && (max == null || max > 10) ? '10+' : i) + '</option>';
