  }

  /* ================= 2c. Quick view: quantity never exceeds stock ================= */
  function capQuickView(){
    doc.querySelectorAll('.modal[id^="modal-quick-view"]').forEach(function(m){
      var data = m.querySelector('[data-brf-qv-stock]');
      if (!data) return;
      if (!data.__stock) { try { data.__stock = JSON.parse(data.textContent || '{}'); } catch (e) { data.__stock = {}; } }
      var idEl = m.querySelector('form[action*="/cart/add"] [name="id"]');
