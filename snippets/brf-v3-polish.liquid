{%- comment -%}
  Bull Ring Fabrics — v3 polish (cart, quick view, swatches, filters, tabs)
  1  Every add-to-cart form opens the cart drawer instead of the cart page
  2  Quick view: translucent glass, no thumbnail strip, bigger image, glass arrows
     + product cards: browse every image with arrows, without opening the product
  3  Clearer glass on image arrows, breadcrumbs and the "more items" pill
  4  Cart drawer "more items" pill sits on the list on desktop too
  5  Undo after removing an item from the cart drawer / cart page
  6  Free-delivery celebration (drawer + cart page), once per unlock
  7  "Next ›" pagination pill
  8  Filters keep your place on the page after they reload it
  9  Colour swatches for names the browser can't read (Cerise, Duck Egg, Flo Pink…)
  10 "View more" on descriptions that live inside tabs
  11 Filter row: fade + glass arrow shows there are more filters to the right
  12 Gentle spring when tabs / collapsibles open
  Rendered once from layout/theme.liquid, after brf-v2-fixes.
{%- endcomment -%}
<style>
  :root{
    --v3-spring:cubic-bezier(.34,1.56,.64,1);
    --v3-soft:cubic-bezier(.22,1.2,.36,1);
    --v3-ease:cubic-bezier(.4,0,.2,1);
    --v3-glass:rgba(255,255,255,.34);
    --v3-glass-hover:rgba(255,255,255,.52);
    --v3-blur:saturate(180%) blur(14px);
    --v3-edge:inset 0 1px 0 rgba(255,255,255,.8),inset 0 0 0 .5px rgba(255,255,255,.55),0 0 0 .5px rgba(0,0,0,.06),0 8px 24px -10px rgba(29,29,31,.32);
  }

  /* ---------- 3. Clear glass pills ---------- */
  html body .brf-garrow,.brf-qv__arrow,.brf-ci__arrow,.brf-prow__btn{
    background:var(--v3-glass)!important;-webkit-backdrop-filter:var(--v3-blur)!important;backdrop-filter:var(--v3-blur)!important;
    box-shadow:var(--v3-edge)!important;border:0!important;color:#1D1D1F!important;
    transition:background-color .25s var(--v3-ease),transform .35s var(--v3-spring),opacity .25s var(--v3-ease)!important}
  html body .brf-garrow:hover,.brf-qv__arrow:hover,.brf-ci__arrow:hover,.brf-prow__btn:hover{background:var(--v3-glass-hover)!important;transform:scale(1.06)}
  html body .brf-garrow:active,.brf-qv__arrow:active,.brf-ci__arrow:active,.brf-prow__btn:active{transform:scale(.94)}
  html body .brf-garrow__count{background:transparent!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;box-shadow:none!important;border:0!important;color:#1D1D1F!important}
  html body .breadcrumb{background:rgba(255,255,255,.4)!important;-webkit-backdrop-filter:var(--v3-blur)!important;backdrop-filter:var(--v3-blur)!important;box-shadow:var(--v3-edge)!important;border:0!important}
  html body .brf-mc__more{background:rgba(255,255,255,.42)!important;-webkit-backdrop-filter:var(--v3-blur)!important;backdrop-filter:var(--v3-blur)!important;box-shadow:var(--v3-edge)!important;border:0!important;color:#1D1D1F!important}

  /* ---------- 4. Drawer pill anchors to the list on every screen size ---------- */
  .brf-mc .mini-cart__content{position:relative}

  /* ---------- 7. Pagination pills ---------- */
  .pagination__next,.pagination__prev{display:inline-flex!important;align-items:center;justify-content:center;gap:6px;white-space:nowrap;height:40px;line-height:1!important;padding:0 16px!important}
  .pagination__next svg,.pagination__prev svg{position:static!important;margin:0!important;width:8px;height:12px;flex:none}

  /* ---------- 2. Quick view ---------- */
  .modal#modal-quick-view-collection-template,.modal[id^="modal-quick-view"]{background:rgba(29,29,31,.28)!important;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
  .modal[id^="modal-quick-view"]{z-index:2147483600!important}
  .modal[id^="modal-quick-view"] .modal__dialog{max-height:calc(100vh - 48px);max-height:calc(100dvh - 48px)}
  .modal[id^="modal-quick-view"] .modal__inner{max-height:inherit;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin}
  .modal[id^="modal-quick-view"] .product-meta,.modal[id^="modal-quick-view"] .product-form{color:#1D1D1F}
  .modal[id^="modal-quick-view"] .product-form__info-item .text--xsmall,.modal[id^="modal-quick-view"] .product-form__price-info .text--subdued,.modal[id^="modal-quick-view"] .text--subdued{color:#515154!important}
  html.brf-hw-page .modal[id^="modal-quick-view"] .modal__dialog{background:rgba(251,251,253,.93)!important}
  .modal[id^="modal-quick-view"] .modal__dialog{background:rgba(251,251,253,.84)!important;-webkit-backdrop-filter:saturate(180%) blur(40px);backdrop-filter:saturate(180%) blur(40px);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.85),inset 0 0 0 .5px rgba(255,255,255,.6),0 30px 80px -20px rgba(29,29,31,.35)!important;border-radius:22px;overflow:hidden}
  .modal[id^="modal-quick-view"] .card,.modal[id^="modal-quick-view"] .featured-product,.modal[id^="modal-quick-view"] .modal__inner{background:transparent!important;border:0!important;box-shadow:none!important}
  .modal[id^="modal-quick-view"] .product-gallery .scroller,.modal[id^="modal-quick-view"] .product-gallery__thumbnail-list{display:none!important}
  .modal[id^="modal-quick-view"] .product-gallery{display:block!important;position:relative}
  .modal[id^="modal-quick-view"] .product-gallery__carousel-wrapper{width:100%!important;max-width:none!important;margin:0!important}
  @media (min-width:1000px){
    .modal[id^="modal-quick-view"] .featured-product>.card:first-child{width:56%}
  }
  .brf-qv__arrow{position:absolute;top:50%;z-index:5;width:44px;height:44px;margin-top:-22px;border-radius:50%;display:grid;place-items:center;cursor:pointer;padding:0}
  .brf-qv__arrow--prev{left:14px}.brf-qv__arrow--next{right:14px}
  .brf-qv__arrow svg{width:16px;height:16px}
  .brf-qv__count{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:5;padding:5px 11px;border-radius:980px;font-size:12px;font-weight:600;letter-spacing:.02em;color:#1D1D1F;
    background:rgba(255,255,255,.34);-webkit-backdrop-filter:var(--v3-blur);backdrop-filter:var(--v3-blur);box-shadow:var(--v3-edge);pointer-events:none;font-variant-numeric:tabular-nums}

  /* ---------- 2b. Product-card image browsing ---------- */
  .product-item__image-wrapper.brf-ci{position:relative;display:block}
  .brf-ci__img{position:absolute;inset:0;width:100%;height:100%;z-index:2;opacity:0;transition:opacity .35s var(--v3-ease);pointer-events:none;background:#fff}
  .brf-ci__img.is-on{opacity:1}
  .brf-ci__arrow{position:absolute!important;top:50%;z-index:4;box-sizing:border-box;min-width:34px;height:34px;margin:-17px 0 0!important;padding:0!important;border-radius:980px!important;
    display:inline-flex!important;align-items:center;justify-content:center;gap:6px;cursor:pointer;opacity:0;line-height:1!important;font:600 12px/1 -apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif!important;letter-spacing:.02em;font-variant-numeric:tabular-nums}
  .brf-ci__arrow svg{position:static!important;display:block;width:12px!important;height:12px!important;margin:0!important;flex:none;transform:none!important}
  .brf-ci__arrow--prev{left:8px}.brf-ci__arrow--next{right:8px}
  .brf-ci__arrow--prev.has-count{padding:0 12px 0 10px!important}
  .brf-ci__count{display:none;white-space:nowrap}
  .brf-ci__arrow--prev.has-count .brf-ci__count{display:inline}
  .brf-ci__count i{font-style:normal;opacity:.45;margin:0 4px}
  html.brf-hw-page .brf-ci__arrow{background:rgba(255,255,255,.62)!important}
  .brf-ci:hover .brf-ci__arrow,.brf-ci:focus-within .brf-ci__arrow{opacity:1}
  .brf-ci__dots{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);z-index:4;display:flex;gap:4px;padding:4px 6px;border-radius:980px;opacity:0;transition:opacity .25s var(--v3-ease);
    background:rgba(255,255,255,.34);-webkit-backdrop-filter:var(--v3-blur);backdrop-filter:var(--v3-blur);box-shadow:var(--v3-edge);pointer-events:none}
  .brf-ci__dots i{width:5px;height:5px;border-radius:50%;background:rgba(29,29,31,.28);transition:background-color .25s,transform .35s var(--v3-spring)}
  .brf-ci__dots i.is-on{background:#1D1D1F;transform:scale(1.25)}
  .brf-ci.is-browsing .brf-ci__dots{opacity:1}
  @media (hover:none){
    .brf-ci__arrow{opacity:1;min-width:28px;height:28px;margin-top:-14px!important;background:rgba(255,255,255,.62)!important;font-size:11px!important}
    .brf-ci__arrow svg{width:10px!important;height:10px!important}
    .brf-ci__arrow--prev.has-count{padding:0 9px 0 7px!important}
    .brf-ci__arrow--prev{left:5px}.brf-ci__arrow--next{right:5px}
  }
  .brf-ci.is-browsing .product-item__secondary-image{opacity:0!important}

  /* ---------- 5. Undo toast ---------- */
  .brf-undo{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));z-index:2147483647;display:flex;align-items:center;gap:14px;max-width:min(92vw,440px);
    padding:10px 10px 10px 18px;border-radius:980px;color:#1D1D1F;font-size:14px;line-height:1.3;
    background:rgba(255,255,255,.72);-webkit-backdrop-filter:saturate(180%) blur(24px);backdrop-filter:saturate(180%) blur(24px);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.85),inset 0 0 0 .5px rgba(255,255,255,.6),0 0 0 .5px rgba(0,0,0,.08),0 18px 40px -14px rgba(29,29,31,.4);
    transform:translate(-50%,24px) scale(.96);opacity:0;transition:transform .5s var(--v3-spring),opacity .25s var(--v3-ease)}
  @media (max-width:749px){.brf-undo{bottom:calc(84px + env(safe-area-inset-bottom));max-width:calc(100vw - 32px)}}
  .brf-undo.is-in{transform:translate(-50%,0) scale(1);opacity:1}
  .brf-undo__t{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .brf-undo__t b{font-weight:600}
  .brf-undo__btn{flex:none;border:0;border-radius:980px;padding:8px 16px;font:inherit;font-weight:600;color:#fff;background:#1D1D1F;cursor:pointer;transition:transform .3s var(--v3-spring)}
  .brf-undo__btn:active{transform:scale(.94)}
  .brf-undo__bar{position:absolute;left:18px;right:18px;bottom:4px;height:2px;border-radius:2px;background:rgba(29,29,31,.12);overflow:hidden}
  .brf-undo__bar::after{content:"";position:absolute;inset:0;background:rgba(29,29,31,.45);transform-origin:left;animation:brfUndoBar var(--brf-undo-ms,8000ms) linear forwards}
  @keyframes brfUndoBar{to{transform:scaleX(0)}}
  .brf-undo.is-err .brf-undo__btn{display:none}
  /* cart page: drop in at the top, just under the header, where the eye already is (the page scrolls up after a removal) */
  .brf-undo--top,.brf-undo--top.brf-undo{top:var(--brf-undo-top,16px);bottom:auto;transform:translate(-50%,-24px) scale(.96);font-size:15px;padding:12px 12px 12px 20px}
  .brf-undo--top.is-in{transform:translate(-50%,0) scale(1)}

  /* ---------- 5b. Undo row inside the drawer ---------- */
  .brf-mc__undo{position:relative;display:flex;align-items:center;gap:10px;margin:8px 0 10px;padding:10px 10px 12px 12px;border-radius:14px;overflow:hidden;
    background:rgba(255,255,255,.6);-webkit-backdrop-filter:var(--v3-blur);backdrop-filter:var(--v3-blur);box-shadow:var(--v3-edge);font-size:13px;line-height:1.3;color:#1D1D1F;
    animation:brfUndoIn .45s var(--v3-spring) both}
  @keyframes brfUndoIn{from{opacity:0;transform:translateY(-6px) scale(.97)}to{opacity:1;transform:none}}
  .brf-mc__undo img{width:40px;height:40px;border-radius:8px;object-fit:cover;flex:none;opacity:.55;filter:grayscale(.4)}
  .brf-mc__undo-t{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .brf-mc__undo-t b{font-weight:600}
  .brf-mc__undo-btn{flex:none;border:0;border-radius:980px;padding:8px 16px;font:inherit;font-weight:600;color:#fff;background:#1D1D1F;cursor:pointer;transition:transform .3s var(--v3-spring)}
  .brf-mc__undo-btn:active{transform:scale(.94)}
  .brf-mc__undo-bar{position:absolute;left:12px;right:12px;bottom:4px;height:2px;border-radius:2px;background:rgba(29,29,31,.4);transform-origin:left;animation:brfUndoBar 10s linear forwards}
  /* ---------- 6. Free-delivery celebration ---------- */
  .brf-mc__free{position:relative}
  .brf-mc__free.brf-yay{animation:brfYayCard 1.1s var(--v3-soft) both}
  @keyframes brfYayCard{0%{transform:scale(.98)}35%{transform:scale(1.015)}100%{transform:none}}
  .brf-mc__free.brf-yay .brf-mc__tick{display:inline-grid;place-items:center;animation:brfYayTick .8s var(--v3-spring) both}
  @keyframes brfYayTick{0%{transform:scale(0) rotate(-45deg);opacity:0}60%{opacity:1}100%{transform:none;opacity:1}}
  .brf-mc__free.brf-yay strong{background:linear-gradient(100deg,currentColor 0%,currentColor 40%,#C9A227 50%,currentColor 60%,currentColor 100%);background-size:250% 100%;
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:brfYaySheen 1.6s var(--v3-ease) .25s both}
  @keyframes brfYaySheen{from{background-position:100% 0}to{background-position:0 0}}
  .brf-mc__free.brf-yay .brf-mc__bar{position:relative;overflow:hidden}
  .brf-mc__free.brf-yay .brf-mc__bar::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.85),transparent);transform:translateX(-100%);animation:brfYayBar 1.2s var(--v3-ease) .15s 2}
  @keyframes brfYayBar{to{transform:translateX(100%)}}
  .brf-yay__p{position:absolute;left:var(--x);top:var(--y);width:var(--s);height:var(--s);border-radius:var(--r);background:var(--c);pointer-events:none;z-index:3;opacity:0;
    animation:brfYayP var(--d) cubic-bezier(.15,.7,.3,1) var(--delay) forwards}
  @keyframes brfYayP{0%{opacity:0;transform:translate(0,0) scale(.4) rotate(0)}12%{opacity:1}100%{opacity:0;transform:translate(var(--dx),var(--dy)) scale(1) rotate(var(--rot))}}
  .brf-yay__glow{position:absolute;inset:-6px;border-radius:16px;pointer-events:none;z-index:0;box-shadow:0 0 0 0 rgba(201,162,39,.45);animation:brfYayGlow 1.4s var(--v3-ease) forwards}
  @keyframes brfYayGlow{0%{box-shadow:0 0 0 0 rgba(201,162,39,.4)}100%{box-shadow:0 0 0 14px rgba(201,162,39,0)}}

  /* ---------- 9. Swatches ---------- */
  .color-swatch__item.brf-sw--img{background-size:cover!important;background-position:center!important}
  #shopify-section-product-recommendations .product-item__swatch-list,
  .product-recommendations .product-item__swatch-list{position:static!important;margin:8px 0 6px!important;min-height:22px;height:auto!important;transform:none!important}
  #shopify-section-product-recommendations .color-swatch-list,.product-recommendations .color-swatch-list{justify-content:flex-start!important;flex-wrap:wrap}
  #shopify-section-product-recommendations .product-item__price-list,.product-recommendations .product-item__price-list{position:relative;z-index:1;margin-top:4px}

  /* ---------- 10. View more always reachable ---------- */
  .expandable-content>.expandable-content__toggle{z-index:3}
  .expandable-content.brf-ec--short{max-height:none!important}
  .expandable-content.brf-ec--short>.expandable-content__toggle{display:none!important}

  /* ---------- 11. Filter row: more-to-the-right cue ---------- */
  .brf-fbar__pills.brf-prow{scroll-behavior:smooth;-webkit-mask-image:var(--brf-prow-mask);mask-image:var(--brf-prow-mask);transition:-webkit-mask-image .3s}
  .brf-fbar__pills.brf-prow.can-r{--brf-prow-mask:linear-gradient(90deg,#000 0,#000 calc(100% - 64px),transparent 100%)}
  .brf-fbar__pills.brf-prow.can-l{--brf-prow-mask:linear-gradient(90deg,transparent 0,#000 48px,#000 100%)}
  .brf-fbar__pills.brf-prow.can-l.can-r{--brf-prow-mask:linear-gradient(90deg,transparent 0,#000 48px,#000 calc(100% - 64px),transparent 100%)}
  .brf-prow__btn{position:absolute;top:50%;z-index:6;width:32px;height:32px;margin-top:-16px;border-radius:50%;display:grid;place-items:center;cursor:pointer;padding:0;
    opacity:0;pointer-events:none;transform:scale(.8)}
  .brf-prow__btn svg{width:12px;height:12px}
  .brf-prow__btn.is-on{opacity:1;pointer-events:auto;transform:none}
  .brf-prow__btn--r.is-on{animation:brfProwHint 2.4s var(--v3-ease) .6s 2}
  @keyframes brfProwHint{0%,70%,100%{translate:0}80%{translate:4px}90%{translate:0}}
  html.brf-hw-page .brf-prow__btn{background:rgba(40,32,48,.5)!important;color:#fff!important}

  /* ---------- 12. Spring open for tabs ---------- */
  .card__collapsible{transition:height .55s cubic-bezier(.3,1.25,.5,1)!important}
  .card__collapsible-button svg,.card__collapsible-button .plus-button,.brf-tab-toggle svg{transition:transform .5s var(--v3-spring)!important}


  /* ---------- 13. Dispatch countdown urgency ---------- */
  .brf-dispatch.brf-urgent .brf-dispatch__unit b{color:#D70015!important;transition:color .4s}
  [data-brf-mc-dispatch].brf-urgent [data-brf-mc-dispatch-text] strong:first-of-type{color:#D70015!important}
  html.brf-hw-page .brf-dispatch.brf-urgent .brf-dispatch__unit b,html.brf-hw-page [data-brf-mc-dispatch].brf-urgent [data-brf-mc-dispatch-text] strong:first-of-type{color:#FF453A!important}

  /* ---------- 14. Low stock in the cart drawer ---------- */
  .brf-mc__low{display:inline-flex;align-items:center;gap:6px;margin:4px 0 0;font-size:12px;font-weight:600;line-height:1.3;color:#D70015}
  .brf-mc__low i{position:relative;width:7px;height:7px;border-radius:50%;background:currentColor;flex:none}
  .brf-mc__low i::after{content:"";position:absolute;inset:0;border-radius:50%;background:currentColor;animation:brfLowPing 1.6s cubic-bezier(0,0,.2,1) infinite}
  @keyframes brfLowPing{0%{transform:scale(1);opacity:.6}80%,100%{transform:scale(2.4);opacity:0}}

  /* instant quantity: gentle hint while it saves */
  .brf-qty-pending .mini-cart__price-list .price,.brf-qty-pending .price{transition:opacity .2s;opacity:.7}
  .quantity-selector__button{touch-action:manipulation}
  /* filtering in place: soften the grid while new results load */
  html.brf-filtering .collection__dynamic-part{opacity:.45;transition:opacity .2s;pointer-events:none}
  @media (prefers-reduced-motion:reduce){
    .brf-undo,.brf-ci__img,.brf-prow__btn,.card__collapsible,.brf-qv__arrow,.brf-ci__arrow{transition:none!important;animation:none!important}
    .brf-mc__free.brf-yay,.brf-mc__free.brf-yay *,.brf-yay__p,.brf-mc__low i::after,.brf-yay__glow,.brf-prow__btn--r.is-on{animation:none!important}
    .brf-mc__free.brf-yay strong{-webkit-text-fill-color:currentColor}
  }
</style>

<script>
(function(){
  var doc = document, root = doc.documentElement;
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var ARROW_L = '<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 2 3.5 6l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var ARROW_R = '<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  function ss(k, v){ try { if (v === undefined) return sessionStorage.getItem(k); if (v === null) sessionStorage.removeItem(k); else sessionStorage.setItem(k, v); } catch (e) { return null; } }
  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

  /* ================= shared: cart helpers ================= */
  function refreshCart(){ root.dispatchEvent(new CustomEvent('cart:refresh', {bubbles: true, detail: {}})); }
  function openDrawer(){
    /* the slim desktop header shows its own "In the bag!" note instead of the drawer */
    if (root.classList.contains('brf-hc')) { doc.dispatchEvent(new CustomEvent('brf:bag-added')); return; }
    /* phones and tablets: no drawer, the button itself says "Added to bag" (brf-v5) */
    if (window.matchMedia('(max-width:999px)').matches) { doc.dispatchEvent(new CustomEvent('brf:bag-added-mobile')); return; }
    if (!(window.theme && theme.cartType === 'drawer')) { location.href = '/cart'; return; }
    setTimeout(function(){
      if (root.classList.contains('brf-cart-open')) return;
      var t = doc.querySelector('.header__cart-toggle'); if (t) t.click();
    }, 350);
  }

  /* ================= 1. Add to cart opens the drawer ================= */
  doc.addEventListener('submit', function(e){
    var f = e.target;
    if (e.defaultPrevented || !f.matches || !f.matches('form[action*="/cart/add"]')) return;
    if (!(window.theme && theme.cartType === 'drawer')) return;
    var btn = e.submitter || f.querySelector('[type="submit"]');
    if (btn && btn.getAttribute('data-action') === 'add-to-cart') return;
    e.preventDefault();
    var fd = new FormData(f);
    if (btn && btn.name && !fd.has(btn.name)) fd.append(btn.name, btn.value);
    if (btn) { btn.setAttribute('aria-busy', 'true'); btn.classList.add('is-loading'); }
    fetch('/cart/add.js', {method: 'POST', body: fd, headers: {'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest'}})
      .then(function(r){ return r.json().then(function(j){ return {ok: r.ok, j: j}; }); })
      .then(function(res){
        if (!res.ok) throw new Error(res.j.description || res.j.message || 'Could not add to basket');
        refreshCart(); openDrawer();
      })
      .catch(function(err){ toast(esc(err.message), null, true); })
      .then(function(){ if (btn) { btn.removeAttribute('aria-busy'); btn.classList.remove('is-loading'); } });
  });

  /* ================= 5. Undo removal ================= */
  var cartCache = null, cacheT = 0;
  function loadCart(){
    var t = ++cacheT;
    return fetch('/cart.js', {headers: {'Accept': 'application/json'}}).then(function(r){ return r.json(); })
