    if (!a || !cartCache) return;
    var key = a.getAttribute('data-line-id');
    if (!key) { var m = (a.getAttribute('href') || '').match(/id=([^&]+)/); key = m && decodeURIComponent(m[1]); }
    if (!key) return;
    var item = null;
    cartCache.items.forEach(function(it){ if (it.key === key || String(it.variant_id) === key || String(it.id) === key) item = item || it; });
    if (!item) return;
