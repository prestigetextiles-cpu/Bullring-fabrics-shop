  /* ================= 6. Free-delivery celebration ================= */
  var COLS = ['#C9A227', '#E8C766', '#1D1D1F', '#0A7F4F', '#F2E3B3', '#B8860B'];
  function celebrate(){
    var nodes = doc.querySelectorAll('.brf-mc__free');
    if (!nodes.length) return;
    var done = null, visibleDone = null;
    nodes.forEach(function(n){
      var isDone = n.classList.contains('is-done');
      if (done === null) done = isDone;
      if (isDone && n.getClientRects().length && n.offsetParent !== null) {
        var inDrawer = !!n.closest('.mini-cart');
        if (!inDrawer || root.classList.contains('brf-cart-open')) visibleDone = visibleDone || n;
      }
    });
    if (!done) { ss('brfFreeDone', '0'); return; }
    if (ss('brfFreeDone') === '1' || !visibleDone) return;
    ss('brfFreeDone', '1');
    if (reduce) return;
    burst(visibleDone);
  }
  function burst(n){
    n.classList.remove('brf-yay'); void n.offsetWidth; n.classList.add('brf-yay');
    var glow = doc.createElement('span'); glow.className = 'brf-yay__glow'; n.appendChild(glow);
    var tick = n.querySelector('.brf-mc__tick');
    var nr = n.getBoundingClientRect(), tr = tick ? tick.getBoundingClientRect() : nr;
    var ox = tr.left - nr.left + tr.width / 2, oy = tr.top - nr.top + tr.height / 2;
    var frag = doc.createDocumentFragment();
    for (var i = 0; i < 26; i++) {
      var p = doc.createElement('span'); p.className = 'brf-yay__p';
      var ang = (-160 + Math.random() * 140) * Math.PI / 180, dist = 40 + Math.random() * 90;
      var s = 3 + Math.random() * 4;
      p.style.cssText = '--x:' + ox + 'px;--y:' + oy + 'px;--s:' + s + 'px;--r:' + (Math.random() < .5 ? '50%' : '1px') +
        ';--c:' + COLS[i % COLS.length] + ';--dx:' + (Math.cos(ang) * dist + nr.width * .25 * Math.random()).toFixed(1) + 'px;--dy:' + (Math.sin(ang) * dist * .6 + 30).toFixed(1) +
        'px;--rot:' + Math.round(Math.random() * 360) + 'deg;--d:' + (900 + Math.random() * 700) + 'ms;--delay:' + Math.round(Math.random() * 180) + 'ms';
      frag.appendChild(p);
    }
    n.appendChild(frag);
    setTimeout(function(){ n.querySelectorAll('.brf-yay__p,.brf-yay__glow').forEach(function(x){ x.remove(); }); }, 2200);
