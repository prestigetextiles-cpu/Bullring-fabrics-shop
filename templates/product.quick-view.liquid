{%- layout none -%}
{%- section 'product-template' -%}
{%- if product.tags contains 'home-lifestyle' -%}<i data-brf-hl hidden></i>{%- endif -%}
<script type="application/json" data-brf-qv-stock>{
  {%- for v in product.variants -%}
    "{{ v.id }}": {% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity | at_least: 0 }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
}</script>
