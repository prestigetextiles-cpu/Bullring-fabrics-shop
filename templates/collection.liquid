{%- liquid
  # Bull Ring: find which main-menu department (Home & Lifestyle, Dress Fabric, Craft Fabric,
  # Upholstery & Curtains...) this collection sits under, so its sub-category switcher can be shown.
  assign brf_dept = ''
  assign brf_menu = linklists['main-menu-2026']
  if brf_menu.links.size == 0
    assign brf_menu = linklists['main-menu']
  endif
  for l in brf_menu.links
    if l.links.size == 0
      continue
    endif
    for sub in l.links
      if sub.object.handle == collection.handle
        assign brf_dept = l.title | handleize
        break
      endif
    endfor
    if brf_dept != ''
      break
    endif
  endfor
-%}
{%- if collection.handle == 'home-lifestyle' -%}
  {% section 'brf-hl-landing' %}
{%- elsif brf_dept != '' -%}
  {%- render 'brf-hl-switcher', key: brf_dept, current: collection.handle -%}
{%- endif -%}
{% section 'brf-collection-head' %}
{% section 'collection-template' %}
{% section 'static-recently-viewed-products' %}
