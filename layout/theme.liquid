<!doctype html>

<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="theme-color" content="#1D1D1F">
    <script>
      /* Bull Ring: hide sold-out products from collection and search listings by default.
         Uses Shopify's own "In stock" filter / search option so counts and pagination stay correct.
         Shoppers can switch sold-out items back on with the "In stock only" switch (remembered for the visit). */
      (function(){
        try {
          if (sessionStorage.getItem('brfShowSoldOut') === '1') return;
        } catch (e) {}
        try {
          var p = location.pathname, q = new URLSearchParams(location.search);
          if (q.has('view')) return;
          var col = /^(\/[a-z]{2}(-[a-z]{2})?)?\/collections\/[^\/]+(\/[^\/]+)?\/?$/i.test(p) && p.indexOf('/products/') === -1;
          var srch = /^(\/[a-z]{2}(-[a-z]{2})?)?\/search\/?$/i.test(p) && q.get('q');
          if (col && !q.has('filter.v.availability')) { q.set('filter.v.availability', '1'); location.replace(p + '?' + q.toString()); }
          else if (srch && !q.has('options[unavailable_products]')) { q.set('options[unavailable_products]', 'hide'); location.replace(p + '?' + q.toString()); }
        } catch (e) {}
      })();
    </script>

    {%- capture seo_page_title -%}
      {%- if request.page_type == 'search' and search.terms != blank -%}
        {{ search.terms | split: ' AND ' | last }} - {{ shop.name }}
      {%- else -%}
        {{ page_title }}{% if current_tags %}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}
      {%- endif -%}
    {%- endcapture -%}

    {%- comment -%} Keyword-led homepage title & description (mirrors top competitors' format) {%- endcomment -%}
    {%- if request.page_type == 'index' -%}
      {%- assign seo_page_title = 'Fabric Shop UK | Fabric by the Metre & Wholesale | Bullring Fabrics' -%}
      {%- assign page_description = 'UK online fabric shop with 800+ fabrics by the metre from £1 – cotton, upholstery, curtain and dress fabrics plus wholesale rolls. Same-day dispatch.' -%}
    {%- endif -%}
    <title>{{- seo_page_title -}}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | img_url: '96x96' }}" type="image/png">
    {%- endif -%}

