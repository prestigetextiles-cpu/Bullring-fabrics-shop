    {%- comment -%} Google "Top Quality Store" badge (Google & YouTube app embed) shows on the homepage only: on other pages its start() is switched off before the app loads it {%- endcomment -%}
    <script>
      (function(){
        var noop=function(){},tame=function(o){try{Object.defineProperty(o,'start',{configurable:true,get:function(){return noop;},set:function(){}});}catch(e){}return o;},mw=tame({});
        try{Object.defineProperty(window,'merchantwidget',{configurable:true,get:function(){return mw;},set:function(v){mw=v&&typeof v==='object'?tame(v):v;}});}catch(e){}
      })();
    </script>
    <style>iframe[src*="merchantwidget"],[id^="merchantwidget"],[class*="merchantwidget"]{display:none!important}</style>
